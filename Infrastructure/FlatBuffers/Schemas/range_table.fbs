// Fixed range_table.fbs schema for Arknights RangeData
table clz_Torappu_GridPosition {
    row: int;
    col: int;
}

table clz_Torappu_RangeData {
    id: string;
    direction: int;
    grids: [clz_Torappu_GridPosition];
}

table dict__string__clz_Torappu_RangeData {
    key: string(key);
    value: clz_Torappu_RangeData;
}

table clz_Torappu_RangeTable {
    rangeData: [dict__string__clz_Torappu_RangeData];
}

root_type clz_Torappu_RangeTable;
