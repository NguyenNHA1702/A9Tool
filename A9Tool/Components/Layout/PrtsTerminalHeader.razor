@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<div class="prts-terminal-header-bar">
    <!-- Left: Arknights Quick Nav Pill ([ < | (Network Home) ]) & System Breadcrumb -->
    <div class="prts-header-left">
        <div class="prts-nav-pill">
            <button class="pill-btn pill-back" @onclick="NavigateBack" title="Back">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="10 3 4 8 10 13"></polyline>
                </svg>
            </button>
            <div class="pill-divider"></div>
            <button class="pill-btn pill-home @(activeSection == "HOME" ? "active" : "")" @onclick='() => NavigateTo("/")' title="Return to Operations Deck">
                <svg class="pill-network-web" viewBox="0 0 38 22" width="34" height="20">
                    <!-- Geometric network web lines -->
                    <line x1="2" y1="11" x2="11" y2="3" stroke="rgba(255,255,255,0.4)" stroke-width="0.8"/>
                    <line x1="11" y1="3" x2="27" y2="3" stroke="rgba(255,255,255,0.4)" stroke-width="0.8"/>
                    <line x1="27" y1="3" x2="36" y2="11" stroke="rgba(255,255,255,0.4)" stroke-width="0.8"/>
                    <line x1="36" y1="11" x2="27" y2="19" stroke="rgba(255,255,255,0.4)" stroke-width="0.8"/>
                    <line x1="27" y1="19" x2="11" y2="19" stroke="rgba(255,255,255,0.4)" stroke-width="0.8"/>
                    <line x1="11" y1="19" x2="2" y2="11" stroke="rgba(255,255,255,0.4)" stroke-width="0.8"/>
                    <line x1="11" y1="3" x2="19" y2="11" stroke="rgba(255,255,255,0.25)" stroke-width="0.7"/>
                    <line x1="27" y1="3" x2="19" y2="11" stroke="rgba(255,255,255,0.25)" stroke-width="0.7"/>
                    <line x1="11" y1="19" x2="19" y2="11" stroke="rgba(255,255,255,0.25)" stroke-width="0.7"/>
                    <line x1="27" y1="19" x2="19" y2="11" stroke="rgba(255,255,255,0.25)" stroke-width="0.7"/>
                    <circle cx="11" cy="3" r="1.3" fill="rgba(255,255,255,0.8)"/>
                    <circle cx="27" cy="3" r="1.3" fill="rgba(255,255,255,0.8)"/>
                    <circle cx="36" cy="11" r="1.3" fill="rgba(255,255,255,0.8)"/>
                    <circle cx="27" cy="19" r="1.3" fill="rgba(255,255,255,0.8)"/>
                    <circle cx="11" cy="19" r="1.3" fill="rgba(255,255,255,0.8)"/>
                    <circle cx="2" cy="11" r="1.3" fill="rgba(255,255,255,0.8)"/>
                    <!-- House symbol in center -->
                    <path d="M19 6.5 L25 11.5 L23.5 11.5 L23.5 16 L20.5 16 L20.5 13.5 L17.5 13.5 L17.5 16 L14.5 16 L14.5 11.5 L13 11.5 Z" fill="#ffffff"/>
                </svg>
            </button>
        </div>

        <div class="prts-system-badge">
            <span class="badge-dot">●</span>
            <span class="badge-prts">PRTS v37.7</span>
            <span class="badge-sep">//</span>
            <span class="badge-title">@CurrentPageTitle</span>
        </div>
    </div>

    <!-- Center: Authentic Arknights Spine Navigation Track (Screenshot 5 Motif) -->
    <nav class="prts-spine-nav">
        <!-- Technical spine background line with rib marks -->
        <div class="spine-line-bg">
            <div class="spine-spine-ribs"></div>
        </div>

        <button class="spine-node @(activeSection == "HOME" ? "active" : "")" @onclick='() => NavigateTo("/")'>
            <div class="node-target-ring">
                <span class="node-dot"></span>
                <span class="node-ring"></span>
            </div>
            <div class="node-icon-box">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                    <path d="M12 3 L21 11 L19 11 L19 20 L14 20 L14 14 L10 14 L10 20 L5 20 L5 11 L3 11 Z"/>
                </svg>
            </div>
            <span class="node-label">HOME</span>
        </button>

        <button class="spine-node @(activeSection == "OPERATOR" ? "active" : "")" @onclick='() => NavigateTo("/operators")'>
            <div class="node-target-ring">
                <span class="node-dot"></span>
                <span class="node-ring"></span>
            </div>
            <div class="node-icon-box">
                <!-- Chess Rook / Tower motif -->
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                    <path d="M5 20h14v-2H5v2zm1-3h12l-1-7h-2v2h-2v-2h-2v2H9v-2H7l-1 7zm1-9h10V5h-2v2h-2V5h-2v2H9V5H7v3z"/>
                </svg>
            </div>
            <span class="node-label">OPERATOR</span>
        </button>

        <button class="spine-node @(activeSection == "TERMINAL" ? "active" : "")" @onclick='() => NavigateTo("/story")'>
            <div class="node-target-ring">
                <span class="node-dot"></span>
                <span class="node-ring"></span>
            </div>
            <div class="node-icon-box">
                <!-- Diamond crosshair / Terminal motif -->
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="12 2 22 12 12 22 2 12" stroke-width="1.8"/>
                    <circle cx="12" cy="12" r="3" fill="currentColor"/>
                    <line x1="12" y1="5" x2="12" y2="8" stroke-width="1.8"/>
                    <line x1="12" y1="16" x2="12" y2="19" stroke-width="1.8"/>
                    <line x1="5" y1="12" x2="8" y2="12" stroke-width="1.8"/>
                    <line x1="16" y1="12" x2="19" y2="12" stroke-width="1.8"/>
                </svg>
            </div>
            <span class="node-label">TERMINAL</span>
        </button>

        <button class="spine-node @(activeSection == "RECRUIT" ? "active" : "")" @onclick='() => NavigateTo("/recruitment")'>
            <div class="node-target-ring">
                <span class="node-dot"></span>
                <span class="node-ring"></span>
            </div>
            <div class="node-icon-box">
                <!-- Recruitment badge motif -->
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                    <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm6 12H6v-1c0-2 4-3.1 6-3.1s6 1.1 6 3.1v1z"/>
                </svg>
            </div>
            <span class="node-label">RECRUIT</span>
        </button>

        <button class="spine-node @(activeSection == "CALC" ? "active" : "")" @onclick='() => NavigateTo("/calculator")'>
            <div class="node-target-ring">
                <span class="node-dot"></span>
                <span class="node-ring"></span>
            </div>
            <div class="node-icon-box">
                <!-- Calculator / Matrix motif -->
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                    <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 14H7v-2h10v2zm0-4H7v-2h10v2zm0-4H7V7h10v2z"/>
                </svg>
            </div>
            <span class="node-label">CALC</span>
        </button>

        <button class="spine-node @(activeSection == "CONFIG" ? "active" : "")" @onclick='() => NavigateTo("/settings")'>
            <div class="node-target-ring">
                <span class="node-dot"></span>
                <span class="node-ring"></span>
            </div>
            <div class="node-icon-box">
                <!-- System Config gear motif -->
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                    <path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
                </svg>
            </div>
            <span class="node-label">CONFIG</span>
        </button>
    </nav>

    <!-- Right: System Status Beacon -->
    <div class="prts-header-right">
        <div class="prts-system-status">
            <span class="status-pulse"></span>
            <span class="status-text">TERRA // SYS_READY</span>
        </div>
    </div>
</div>

@code {
    private string activeSection = "HOME";

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        UpdateActiveRoute();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateActiveRoute();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateActiveRoute()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/');
        var firstSegment = relative.Split('/', '?')[0].ToLowerInvariant();

        activeSection = firstSegment switch
        {
            "" => "HOME",
            "operators" => "OPERATOR",
            "recruitment" => "RECRUIT",
            "story" => "TERMINAL",
            "calculator" => "CALC",
            "settings" => "CONFIG",
            _ => "HOME"
        };
    }

    private string CurrentPageTitle => activeSection switch
    {
        "HOME" => "OPERATIONS DECK",
        "OPERATOR" => "OPERATOR ROSTER",
        "TERMINAL" => "TERMINAL // CHRONICLE HUB",
        "RECRUIT" => "HR RECRUITMENT",
        "CALC" => "PRTS PLANNER & CALCULATOR",
        "CONFIG" => "SYSTEM CONFIG & CACHE",
        _ => "OPERATIONS DECK"
    };

    private void NavigateTo(string path)
    {
        Navigation.NavigateTo(path);
    }

    private async Task NavigateBack()
    {
        if (activeSection == "HOME")
        {
            return;
        }
        await JS.InvokeVoidAsync("history.back");
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
