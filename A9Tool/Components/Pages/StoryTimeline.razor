    private List<StoryNode> CurrentDisplayNodes
    {
        get
        {
            var isSearch = !string.IsNullOrWhiteSpace(EventSearchQuery);
            var q = EventSearchQuery?.Trim() ?? "";

            List<StoryNode> result = new();

            if (ActiveStoryLine == "main")
            {
                var actsToInclude = MainActFilter switch
                {
                    "act_1" => TimelineActs.Where(a => a.ActId == "act_1"),
                    "act_2" => TimelineActs.Where(a => a.ActId == "act_2"),
                    "act_3" => TimelineActs.Where(a => a.ActId == "act_3"),
                    _ => TimelineActs.Where(a => a.ActId == "act_1" || a.ActId == "act_2" || a.ActId == "act_3")
                };

                foreach (var a in actsToInclude)
                {
                    result.AddRange(a.MainNodes);
                }
            }
            else if (ActiveStoryLine == "special")
            {
                var spAct = TimelineActs.FirstOrDefault(a => a.ActId == "act_special_ops");
                if (spAct != null) result.AddRange(spAct.LinkedEvents);

                foreach (var a in TimelineActs.Where(x => x.ActId.StartsWith("act_") && x.ActId != "act_special_ops" && x.ActId != "act_public_affairs"))
                {
                    result.AddRange(a.LinkedEvents);
                }
            }
            else if (ActiveStoryLine == "public")
            {
                var paAct = TimelineActs.FirstOrDefault(a => a.ActId == "act_public_affairs");
                if (paAct != null) result.AddRange(paAct.LinkedEvents);
            }
            else
            {
                var allLinked = new List<StoryNode>();
                foreach (var a in TimelineActs)
                {
                    allLinked.AddRange(a.LinkedEvents);
                }

                result = ActiveStoryLine switch
                {
                    "rl" => allLinked.Where(e => MatchesAny(e, "rhine", "lone trail", "dorothy", "mansfield", "act28side", "act19side", "act13d5", "kristen", "saria", "muelsyse")).ToList(),
                    "ur" => allLinked.Where(e => MatchesAny(e, "ursus", "peterheim", "children of ursus", "act8mini", "walk in the dust", "zima", "rosa", "reunion")).ToList(),
                    "la" => allLinked.Where(e => MatchesAny(e, "laterano", "guiding ahead", "escapismo", "hortus", "act16side", "act26side", "federico", "spes")).ToList(),
                    "kj" => allLinked.Where(e => MatchesAny(e, "kjerag", "break the ice", "silverash", "act15side", "karlan", "degenbrecher")).ToList(),
                    "si" => allLinked.Where(e => MatchesAny(e, "siracusa", "siracusano", "act21side", "texas", "lappland", "bellone", "famiglia")).ToList(),
                    "ka" => allLinked.Where(e => MatchesAny(e, "kazimierz", "near light", "maria nearl", "pinus", "act14side", "act11d0", "act12mini", "bleminshine")).ToList(),
                    _ => allLinked
                };
            }

            if (isSearch)
            {
                result = result.Where(n =>
                    n.Title.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    (!string.IsNullOrEmpty(n.Code) && n.Code.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(n.SubTitle) && n.SubTitle.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(n.Description) && n.Description.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    n.Episodes.Any(e => e.StoryCode.Contains(q, StringComparison.OrdinalIgnoreCase) || e.StoryName.Contains(q, StringComparison.OrdinalIgnoreCase))
                ).ToList();
            }

            return result;
        }
    }

    private static bool MatchesAny(StoryNode e, params string[] terms)
    {
        foreach (var t in terms)
        {
            if (e.Id.Contains(t, StringComparison.OrdinalIgnoreCase)) return true;
            if (e.Title.Contains(t, StringComparison.OrdinalIgnoreCase)) return true;
            if (!string.IsNullOrEmpty(e.SubTitle) && e.SubTitle.Contains(t, StringComparison.OrdinalIgnoreCase)) return true;
            if (!string.IsNullOrEmpty(e.Code) && e.Code.Contains(t, StringComparison.OrdinalIgnoreCase)) return true;
            if (!string.IsNullOrEmpty(e.Description) && e.Description.Contains(t, StringComparison.OrdinalIgnoreCase)) return true;
            if (!string.IsNullOrEmpty(e.RelatedFaction) && e.RelatedFaction.Contains(t, StringComparison.OrdinalIgnoreCase)) return true;
        }
        return false;
    }

    private void OpenDetailModal(StoryNode node, StoryEpisodeInfo? ep = null)
    {
        SelectedDetailNode = node;
        SelectedInitialEpisode = ep ?? node.Episodes.FirstOrDefault();
        IsDetailModalOpen = true;
    }

    private void CloseDetailModal()
    {
        IsDetailModalOpen = false;
        SelectedDetailNode = null;
        SelectedInitialEpisode = null;
    }

    private async Task HandleReadFromDetailModal(StoryEpisodeInfo ep)
    {
        IsDetailModalOpen = false;
        BookmarkInitialLine = 0;
        if (SelectedDetailNode != null)
        {
            await OpenReader(ep.StoryId, ep.StoryPath, $"{SelectedDetailNode.Title} - {ep.StoryName}", SelectedDetailNode.Episodes, ep, SelectedDetailNode.Title);
        }
    }

    private void HandleWatchPv(string pvId)
    {
        if (SelectedDetailNode != null)
        {
            OpenPvModal(SelectedDetailNode.Title, SelectedDetailNode.Id);
        }
    }

    private async Task StopAllAudioAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", @"
                (function() {
                    try {
                        var player = document.getElementById('a9-story-bgm-audio');
                        if (player) {
                            player.pause();
                            player.currentTime = 0;
                            player.removeAttribute('src');
                            player.removeAttribute('data-curr-src');
                            player.load();
                        }
                    } catch(e) {}
                    try {
                        var audios = document.querySelectorAll('audio');
                        audios.forEach(function(a) {
                            try {
                                a.pause();
                                a.currentTime = 0;
                                a.removeAttribute('src');
                                a.removeAttribute('data-curr-src');
                                a.load();
                            } catch(e) {}
                        });
                    } catch(e) {}
                })();
            ");
        }
        catch { }
    }

    private async Task OpenReader(string storyId, string? path, string title, List<StoryEpisodeInfo>? playlist = null, StoryEpisodeInfo? currentEp = null, string nodeTitle = "")
    {
        Logger.LogInformation("[Story Hub] Opening Story Reader for: '{Title}' (StoryId: {Id})", title, storyId);
        await StopAllAudioAsync();
        CurrentPlaylist = playlist;
        CurrentEpisodeIndex = (playlist != null && currentEp != null) ? playlist.IndexOf(currentEp) : -1;
        CurrentNodeTitle = nodeTitle;
        ActiveStoryPath = path;
        ActiveBundle = await StoryService.GetStoryScriptAsync(storyId, path, title);
        IsReaderOpen = true;
    }

    private async Task HandleNavigateEpisode(StoryEpisodeInfo targetEp)
    {
        BookmarkInitialLine = 0;
        await OpenReader(targetEp.StoryId, targetEp.StoryPath, $"{CurrentNodeTitle} - {targetEp.StoryName}", CurrentPlaylist, targetEp, CurrentNodeTitle);
    }

    private async Task CloseReader()
    {
        IsReaderOpen = false;
        ActiveBundle = null;
        ActiveStoryPath = null;
        BookmarkInitialLine = 0;
        await StopAllAudioAsync();
        await RefreshBookmarksAsync();
    }

    private void OpenPvModal(string title, string storyId)
    {
        ActivePvTitle = $"{title} — Official Trailer";
        ActivePvUrl = StoryService.GetYouTubePvUrl(storyId);
        IsPvOpen = true;
    }

    private void ClosePvModal()
    {
        IsPvOpen = false;
        ActivePvUrl = null;
    }

    public async ValueTask DisposeAsync()
    {
        await StopAllAudioAsync();
    }
}
