@page "/story"
@using System.Text.Json
@using Core.Models.Entities
@inject StoryService StoryService
@inject IJSRuntime JS
@inject ILogger<StoryTimeline> Logger
@inject A9Tool.Services.LoadingStateService LoadingService
@implements IAsyncDisposable

<div class="ak-story-terminal-viewport">
    
    <!-- Top Bar: PRTS Chronicles Header & Movements (Bookmarks) Button -->
    <header class="ak-story-topbar">
        <div class="topbar-left">
            <span class="story-terminal-tag">// PRTS CHRONICLES</span>
            <span class="story-terminal-title">TIMELINE & VISUAL NOVEL ARCHIVES</span>
        </div>

        <div class="topbar-search">
            <span class="search-ico">🔍</span>
            <input type="text" 
                   class="topbar-search-input" 
                   placeholder="Search story, event, chapter code (e.g. EP00, Babel, Lone Trail, GT-1)..." 
                   @bind="EventSearchQuery" 
                   @bind:event="oninput" />
            @if (!string.IsNullOrWhiteSpace(EventSearchQuery))
            {
                <button class="search-clear-btn" @onclick='() => EventSearchQuery = ""' title="Clear search">✕</button>
            }
        </div>

        <div class="topbar-right">
            <!-- Movements Button (Bookmarks & Reading Progress) -->
            <button class="ak-movements-btn @(showBookmarksDrawer ? "active" : "")" 
                    @onclick="ToggleBookmarksDrawer" 
                    title="Reading Bookmarks & History">
                <span class="movements-icon">🗂</span>
                <span class="movements-text">Movements</span>
                @if (SavedBookmarks.Count > 0)
                {
                    <span class="movements-badge">@SavedBookmarks.Count</span>
                }
            </button>
        </div>
    </header>

    <!-- Main Interactive Layout: Left Story Line Tree Rail + Right Vertical Chapter Grid Stage -->
    <div class="ak-story-main-stage">
        
        <!-- LEFT COLUMN: Authentic Arknights Story Line Vertical Tree Track -->
        <aside class="ak-storyline-rail">
            <div class="storyline-rail-track"></div>

            <!-- 1. Main Story / Main Theme (For Tomorrow) -->
            <div class="storyline-node-item @(ActiveStoryLine == "main" ? "active" : "")" @onclick='() => SelectStoryLine("main")'>
                <div class="node-bullet-box">
                    <span class="node-bullet-core"></span>
                    <span class="node-bullet-ring"></span>
                </div>
                <div class="node-label-box">
                    <div class="node-type-label">Main Story <span class="node-sub-sep">/ Main Theme</span></div>
                    <div class="node-name-label">
                        @if (ActiveStoryLine == "main")
                        {
                            <span class="node-rook-icon">‹ ♜ ›</span>
                        }
                        For Tomorrow
                    </div>
                </div>
            </div>

            <!-- 2. Story Line · RL (The Ark / Rhine Lab) -->
            <div class="storyline-node-item @(ActiveStoryLine == "rl" ? "active" : "")" @onclick='() => SelectStoryLine("rl")'>
                <div class="node-bullet-box"><span class="node-bullet-core"></span><span class="node-bullet-ring"></span></div>
                <div class="node-label-box">
                    <div class="node-type-label">Story Line • RL</div>
                    <div class="node-name-label">The Ark</div>
                </div>
            </div>

            <!-- 3. Story Line · UR (Wildfire / Ursus) -->
            <div class="storyline-node-item @(ActiveStoryLine == "ur" ? "active" : "")" @onclick='() => SelectStoryLine("ur")'>
                <div class="node-bullet-box"><span class="node-bullet-core"></span><span class="node-bullet-ring"></span></div>
                <div class="node-label-box">
                    <div class="node-type-label">Story Line • UR</div>
                    <div class="node-name-label">Wildfire</div>
                </div>
            </div>

            <!-- 4. Story Line · LA (The Blessed / Laterano) -->
            <div class="storyline-node-item @(ActiveStoryLine == "la" ? "active" : "")" @onclick='() => SelectStoryLine("la")'>
                <div class="node-bullet-box"><span class="node-bullet-core"></span><span class="node-bullet-ring"></span></div>
                <div class="node-label-box">
                    <div class="node-type-label">Story Line • LA</div>
                    <div class="node-name-label">The Blessed</div>
                </div>
            </div>

            <!-- 5. Story Line · KJ (Snow and Silver Steel / Kjerag) -->
            <div class="storyline-node-item @(ActiveStoryLine == "kj" ? "active" : "")" @onclick='() => SelectStoryLine("kj")'>
                <div class="node-bullet-box"><span class="node-bullet-core"></span><span class="node-bullet-ring"></span></div>
                <div class="node-label-box">
                    <div class="node-type-label">Story Line • KJ</div>
                    <div class="node-name-label">Snow and Silver Steel</div>
                </div>
            </div>

            <!-- 6. Story Line · SI (Siracusa / Il Siracusano) -->
            <div class="storyline-node-item @(ActiveStoryLine == "si" ? "active" : "")" @onclick='() => SelectStoryLine("si")'>
                <div class="node-bullet-box"><span class="node-bullet-core"></span><span class="node-bullet-ring"></span></div>
                <div class="node-label-box">
                    <div class="node-type-label">Story Line • SI</div>
                    <div class="node-name-label">Siracusa</div>
                </div>
            </div>

            <!-- 7. Story Line · KA (Near Light / Kazimierz) -->
            <div class="storyline-node-item @(ActiveStoryLine == "ka" ? "active" : "")" @onclick='() => SelectStoryLine("ka")'>
                <div class="node-bullet-box"><span class="node-bullet-core"></span><span class="node-bullet-ring"></span></div>
                <div class="node-label-box">
                    <div class="node-type-label">Story Line • KA</div>
                    <div class="node-name-label">Near Light</div>
                </div>
            </div>

            <!-- 8. Special Operations & Intermezzi -->
            <div class="storyline-node-item @(ActiveStoryLine == "special" ? "active" : "")" @onclick='() => SelectStoryLine("special")'>
                <div class="node-bullet-box"><span class="node-bullet-core"></span><span class="node-bullet-ring"></span></div>
                <div class="node-label-box">
                    <div class="node-type-label">RECORDS_S</div>
                    <div class="node-name-label">Special Operations</div>
                </div>
            </div>

            <!-- 9. Public Affairs & Vignettes -->
            <div class="storyline-node-item @(ActiveStoryLine == "public" ? "active" : "")" @onclick='() => SelectStoryLine("public")'>
                <div class="node-bullet-box"><span class="node-bullet-core"></span><span class="node-bullet-ring"></span></div>
                <div class="node-label-box">
                    <div class="node-type-label">RECORDS_P</div>
                    <div class="node-name-label">Public Affairs</div>
                </div>
            </div>

            <!-- 10. Personnel Archives -->
            <div class="storyline-node-item @(ActiveStoryLine == "personnel" ? "active" : "")" @onclick='() => SelectStoryLine("personnel")'>
                <div class="node-bullet-box"><span class="node-bullet-core"></span><span class="node-bullet-ring"></span></div>
                <div class="node-label-box">
                    <div class="node-type-label">DOSSIERS</div>
                    <div class="node-name-label">Personnel Records</div>
                </div>
            </div>
        </aside>

        <!-- RIGHT / CENTER SECTION: Act Subheader & Vertical Chapter Cards Grid -->
        <main class="ak-chapter-carousel-stage">
            
            @if (ActiveStoryLine != "personnel")
            {
                <!-- Act Subheader -->
                <div class="ak-act-indicator-box">
                    <div class="act-logo-tag">Act @CurrentActIndicatorCode</div>
                    <div class="act-title-tag">@CurrentActTitle</div>
                    @if (ActiveStoryLine == "main")
                    {
                        <div class="main-act-tabs">
                            <button class="act-tab-pill @(MainActFilter == "act_1" ? "active" : "")" @onclick='() => MainActFilter = "act_1"'>ACT 1: CH 0-3</button>
                            <button class="act-tab-pill @(MainActFilter == "act_2" ? "active" : "")" @onclick='() => MainActFilter = "act_2"'>ACT 2: CH 4-8</button>
                            <button class="act-tab-pill @(MainActFilter == "act_3" ? "active" : "")" @onclick='() => MainActFilter = "act_3"'>ACT 3: CH 9-14</button>
                            <button class="act-tab-pill @(MainActFilter == "all" ? "active" : "")" @onclick='() => MainActFilter = "all"'>ALL (CH 0-14)</button>
                        </div>
                    }
                </div>

                <!-- Active Reading Session Highlight Bar -->
                @if (ActiveSession != null)
                {
                    <div class="reading-session-banner-strip mb-3">
                        <div class="banner-left">
                            <span class="session-pulse-dot"></span>
                            <span class="session-label">NOW READING:</span>
                            <span class="session-title">@ActiveSession.Title</span>
                            <span class="session-meta">Line @(ActiveSession.LineIndex + 1) / @ActiveSession.TotalLines (@(ActiveSession.TotalLines > 0 ? (ActiveSession.LineIndex + 1) * 100 / ActiveSession.TotalLines : 0)%)</span>
                        </div>
                        <button class="session-resume-btn" @onclick="ResumeActiveSession" title="Resume reading">
                            ▶ Resume Reading
                        </button>
                    </div>
                }

                <!-- Vertical Grid of Chapter Cards (Scrolls vertically with mouse wheel, no horizontal overflow) -->
                <div class="ak-cards-vertical-grid">
                    @if (CurrentDisplayNodes.Count == 0)
                    {
                        <div class="no-story-matches">
                            <span class="matches-icon">🔍</span>
                            <p>No story chapters matched the criteria for this storyline.</p>
                            @if (!string.IsNullOrWhiteSpace(EventSearchQuery))
                            {
                                <button class="act-tab-pill mt-2" @onclick='() => EventSearchQuery = ""'>Clear Search</button>
                            }
                        </div>
                    }
                    else
                    {
                        @foreach (var node in CurrentDisplayNodes)
                        {
                            var n = node;
                            <!-- Proportional Banner Card: Click anywhere to open detail modal -->
                            <div class="ak-banner-chapter-card" 
                                 @onclick="() => OpenDetailModal(n, n.Episodes.FirstOrDefault())"
                                 title="Click to view dossier & episodes for @n.Title">
                                
                                <!-- Banner Image Frame (Proportion fits banner exactly) -->
                                <div class="card-banner-frame">
                                    @if (!string.IsNullOrEmpty(n.BannerUrl))
                                    {
                                        <img src="@n.BannerUrl" 
                                             alt="@n.Title" 
                                             class="card-banner-img" 
                                             loading="lazy" 
                                             onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                                    }
                                    <div class="card-banner-fallback" style="@(string.IsNullOrEmpty(n.BannerUrl) ? "display:flex;" : "display:none;")">
                                        <span class="fallback-code">@n.Code</span>
                                    </div>
                                    <div class="card-banner-code-badge">@n.Code</div>
                                </div>

                                <!-- Card Content: Title, Subtitle, Description & Action Hint -->
                                <div class="card-banner-body">
                                    <h4 class="card-banner-title">@n.Title</h4>
                                    @if (!string.IsNullOrEmpty(n.SubTitle))
                                    {
                                        <div class="card-banner-sub">@n.SubTitle</div>
                                    }
                                    <p class="card-banner-desc">@n.Description</p>

                                    <!-- Clean Card Footer -->
                                    <div class="card-banner-footer">
                                        <span class="card-ep-count">📑 @n.Episodes.Count Episodes</span>
                                        @if (!string.IsNullOrEmpty(n.YouTubePvId))
                                        {
                                            <span class="card-pv-tag">🎬 PV</span>
                                        }
                                        <span class="card-cta-btn">Open Dossier ▶</span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            }
            else
            {
                <!-- Personnel Records Faction View -->
                <div class="personnel-view-container">
                    <div class="faction-chips-row">
                        @foreach (var fac in FactionArchives)
                        {
                            var curFac = fac;
                            <button class="faction-chip-btn @(SelectedFactionId == curFac.FactionId ? "active" : "")" 
                                    @onclick="() => SelectedFactionId = curFac.FactionId">
                                @curFac.FactionName (@curFac.OperatorRecords.Count)
                            </button>
                        }
                    </div>

                    @{
                        var curFaction = FactionArchives.FirstOrDefault(f => f.FactionId == SelectedFactionId);
                    }
                    @if (curFaction != null)
                    {
                        <div class="faction-records-grid">
                            @foreach (var rec in curFaction.OperatorRecords)
                            {
                                var curRec = rec;
                                <div class="ak-banner-chapter-card personnel-card" 
                                     @onclick="() => OpenDetailModal(curRec, curRec.Episodes.FirstOrDefault())"
                                     title="Click to view dossier for @curRec.RelatedOperatorName">
                                    
                                    <div class="personnel-avatar-frame">
                                        @if (!string.IsNullOrEmpty(curRec.RelatedOperatorAvatar))
                                        {
                                            <img src="@curRec.RelatedOperatorAvatar" 
                                                 alt="@curRec.RelatedOperatorName" 
                                                 class="personnel-avatar-img" 
                                                 loading="lazy" 
                                                 onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                                        }
                                        <div class="personnel-avatar-fallback" style="@(string.IsNullOrEmpty(curRec.RelatedOperatorAvatar) ? "display:flex;" : "display:none;")">
                                            @(curRec.RelatedOperatorName?.Length >= 2 ? curRec.RelatedOperatorName[..2].ToUpperInvariant() : "OP")
                                        </div>
                                    </div>

                                    <div class="card-banner-body">
                                        <h4 class="card-banner-title">@curRec.RelatedOperatorName</h4>
                                        <div class="card-banner-sub">@curRec.Code</div>
                                        <p class="card-banner-desc">Confidential operator chronicle & personnel memory files at Rhodes Island.</p>

                                        <div class="card-banner-footer">
                                            <span class="card-ep-count">📑 @curRec.Episodes.Count Episodes</span>
                                            <span class="card-cta-btn">Read Record ▶</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </main>
    </div>

    <!-- Movements (Bookmarks) Slide-Out Drawer -->
    @if (showBookmarksDrawer)
    {
        <div class="bookmarks-drawer-backdrop" @onclick="ToggleBookmarksDrawer">
            <div class="bookmarks-drawer-card" @onclick:stopPropagation="true">
                <div class="drawer-header">
                    <span class="drawer-title">MOVEMENTS // SAVED READING BOOKMARKS</span>
                    <button class="btn-close-drawer" @onclick="ToggleBookmarksDrawer">✕</button>
                </div>
                @if (SavedBookmarks.Count == 0)
                {
                    <div class="no-bookmarks-msg">No active bookmarks found. Open any visual novel chapter and click "Bookmark" to resume later.</div>
                }
                else
                {
                    <div class="drawer-bookmarks-list">
                        @foreach (var b in SavedBookmarks)
                        {
                            var curB = b;
                            <div class="drawer-bookmark-item">
                                <div class="bm-info" @onclick="() => ResumeFromBookmark(curB)">
                                    <div class="bm-title">@curB.Title</div>
                                    <div class="bm-meta">Progress: Line @(curB.LineIndex + 1) / @curB.TotalLines</div>
                                </div>
                                <button class="bm-del-btn" @onclick="() => DeleteBookmark(curB.StoryId)">✕</button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <!-- Chapter Detail Dossier Modal -->
    <StoryDetailModal IsOpen="@IsDetailModalOpen"
                      Node="@SelectedDetailNode"
                      InitialEpisode="@SelectedInitialEpisode"
                      OnClose="CloseDetailModal"
                      OnReadChapter="HandleReadFromDetailModal"
                      OnWatchPv="HandleWatchPv" />

    <!-- Full-Screen Interactive Visual Novel Reader Modal -->
    <StoryReaderModal IsOpen="@IsReaderOpen"
                      Bundle="@ActiveBundle"
                      NextEpisode="@NextEpisode"
                      PrevEpisode="@PrevEpisode"
                      InitialLineIndex="@BookmarkInitialLine"
                      StoryPath="@ActiveStoryPath"
                      OnClose="CloseReader"
                      OnNavigateEpisode="HandleNavigateEpisode"
                      OnBookmarkChanged="RefreshBookmarksAsync" />

    <!-- Official YouTube PV Trailer Modal -->
    <EventPVModal IsOpen="@IsPvOpen"
                  Title="@ActivePvTitle"
                  VideoUrl="@ActivePvUrl"
                  OnClose="ClosePvModal" />
</div>

<style>
    /* Responsive Vertical Grid for Chapters (Vertical scrolling, no horizontal scroll needed) */
    .ak-cards-vertical-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
        padding-bottom: 40px;
        padding-top: 4px;
    }

    /* Card Frame: Image Frame fits banner proportion exactly */
    .ak-banner-chapter-card {
        width: 100%;
        min-width: 0;
        background: rgba(13, 18, 31, 0.92);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 8px;
        cursor: pointer;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
        transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease, border-color 0.2s ease;
        user-select: none;
    }

    .ak-banner-chapter-card:hover {
        transform: translateY(-5px);
        border-color: #38bdf8;
        box-shadow: 0 12px 30px rgba(14, 165, 233, 0.25);
    }

    .card-banner-frame {
        position: relative;
        width: 100%;
        height: 135px;
        background: #090e15;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .card-banner-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.3s ease;
    }

    .ak-banner-chapter-card:hover .card-banner-img {
        transform: scale(1.05);
    }

    .card-banner-fallback {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #0f172a;
        font-family: var(--font-bebas);
        font-size: 20px;
        color: #64748b;
    }

    .card-banner-code-badge {
        position: absolute;
        bottom: 8px;
        left: 8px;
        background: rgba(15, 23, 42, 0.9);
        border: 1px solid rgba(56, 189, 248, 0.5);
        color: #38bdf8;
        padding: 2px 8px;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.8px;
        border-radius: 4px;
        backdrop-filter: blur(4px);
    }

    .card-banner-body {
        padding: 14px 16px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        flex: 1;
    }

    .card-banner-title {
        font-family: var(--font-bebas);
        font-size: 21px;
        color: #ffffff;
        letter-spacing: 0.5px;
        line-height: 1.15;
        margin: 0;
    }

    .card-banner-sub {
        font-size: 0.74rem;
        color: #94a3b8;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .card-banner-desc {
        font-size: 0.78rem;
        color: #cbd5e1;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin-top: 4px;
    }

    .card-banner-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: auto;
        padding-top: 10px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .card-ep-count {
        font-size: 0.74rem;
        font-weight: 700;
        color: #94a3b8;
    }

    .card-pv-tag {
        font-size: 0.68rem;
        font-weight: 800;
        color: #f59e0b;
        background: rgba(245, 158, 11, 0.15);
        padding: 2px 6px;
        border-radius: 4px;
    }

    .card-cta-btn {
        font-size: 0.76rem;
        font-weight: 800;
        color: #38bdf8;
        letter-spacing: 0.5px;
        transition: transform 0.2s;
    }

    .ak-banner-chapter-card:hover .card-cta-btn {
        transform: translateX(4px);
        color: #7dd3fc;
    }

    /* Personnel View & Grid */
    .faction-records-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
        padding-top: 14px;
    }

    .personnel-card .personnel-avatar-frame {
        width: 100%;
        height: 110px;
        background: radial-gradient(circle, #1e293b 0%, #090e15 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 8px;
    }

    .personnel-avatar-img {
        max-width: 90px;
        max-height: 90px;
        object-fit: contain;
        filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.7));
    }

    .personnel-avatar-fallback {
        font-family: var(--font-bebas);
        font-size: 28px;
        color: #64748b;
    }

    /* Reading Session Strip */
    .reading-session-banner-strip {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: rgba(245, 158, 11, 0.12);
        border: 1px solid rgba(245, 158, 11, 0.35);
        border-radius: 8px;
        padding: 8px 14px;
        gap: 12px;
    }

    .banner-left {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .session-pulse-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #f59e0b;
        box-shadow: 0 0 8px #f59e0b;
        animation: pulseDot 1.5s infinite;
    }

    @@keyframes pulseDot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(1.3); }
    }

    .session-label {
        font-size: 0.72rem;
        font-weight: 800;
        color: #f59e0b;
        letter-spacing: 0.8px;
    }

    .session-title {
        font-size: 0.88rem;
        font-weight: 700;
        color: #ffffff;
    }

    .session-meta {
        font-size: 0.74rem;
        color: #cbd5e1;
        background: rgba(0, 0, 0, 0.35);
        padding: 2px 8px;
        border-radius: 4px;
    }

    .session-resume-btn {
        background: #f59e0b;
        color: #0f172a;
        font-size: 0.78rem;
        font-weight: 800;
        border: none;
        border-radius: 6px;
        padding: 6px 14px;
        cursor: pointer;
        white-space: nowrap;
        transition: background 0.2s, transform 0.15s;
    }

    .session-resume-btn:hover {
        background: #fbbf24;
        transform: translateY(-1px);
    }

    .no-story-matches {
        padding: 40px;
        text-align: center;
        color: #94a3b8;
        font-size: 0.95rem;
        grid-column: 1 / -1;
    }

    .no-story-matches .matches-icon {
        font-size: 2rem;
        display: block;
        margin-bottom: 8px;
    }

    .search-clear-btn {
        background: transparent;
        border: none;
        color: #94a3b8;
        cursor: pointer;
        font-size: 0.85rem;
        padding: 4px;
    }

    .search-clear-btn:hover {
        color: #f43f5e;
    }
</style>

@code {
    private List<StoryActGroup> TimelineActs = [];
    private List<FactionStoryArchive> FactionArchives = [];
    private List<StoryBookmark> SavedBookmarks = [];
    private StoryBookmark? ActiveSession;

    private string ActiveStoryLine = "main";
    private string MainActFilter = "all";
    private string SelectedFactionId = "RHODES";
    private string EventSearchQuery = string.Empty;
    private bool showBookmarksDrawer = false;

    // Detail Modal state
    private bool IsDetailModalOpen = false;
    private StoryNode? SelectedDetailNode = null;
    private StoryEpisodeInfo? SelectedInitialEpisode = null;

    // Reader modal & playlist state
    private bool IsReaderOpen = false;
    private StoryScriptBundle? ActiveBundle;
    private List<StoryEpisodeInfo>? CurrentPlaylist = null;
    private int CurrentEpisodeIndex = -1;
    private string CurrentNodeTitle = string.Empty;
    private int BookmarkInitialLine = 0;
    private string? ActiveStoryPath = null;

    private StoryEpisodeInfo? NextEpisode =>
        (CurrentPlaylist != null && CurrentEpisodeIndex >= 0 && CurrentEpisodeIndex < CurrentPlaylist.Count - 1)
            ? CurrentPlaylist[CurrentEpisodeIndex + 1]
            : null;

    private StoryEpisodeInfo? PrevEpisode =>
        (CurrentPlaylist != null && CurrentEpisodeIndex > 0)
            ? CurrentPlaylist[CurrentEpisodeIndex - 1]
            : null;

    // PV modal state
    private bool IsPvOpen = false;
    private string ActivePvTitle = string.Empty;
    private string? ActivePvUrl;

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("[Story Hub] Initializing StoryTimeline page with unified PRTS Loading...");
        LoadingService.Show("PRTS CHRONICLES", "DECRYPTING HISTORICAL ARCHIVES & TIMELINE DATA...", 40);

        try
        {
            TimelineActs = await StoryService.GetTimelineHierarchyAsync();
            LoadingService.UpdateProgress(80, "PARSING PERSONNEL RECORDS & MISSIONS...");

            FactionArchives = await StoryService.GetFactionStoryArchivesAsync();
            if (FactionArchives.Count > 0)
            {
                SelectedFactionId = FactionArchives[0].FactionId;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[Story Hub Error] Failed to load story timeline data.");
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshBookmarksAsync();
            StateHasChanged();
        }
    }

    private async Task RefreshBookmarksAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string>("localStorage.getItem", "a9_story_bookmarks");
            if (!string.IsNullOrEmpty(json))
            {
                var rawList = JsonSerializer.Deserialize<List<StoryBookmark>>(json) ?? [];
                SavedBookmarks = rawList.Where(b => b != null && !string.IsNullOrEmpty(b.StoryId)).ToList();
            }
            else
            {
                SavedBookmarks = [];
            }

            var sessionJson = await JS.InvokeAsync<string>("localStorage.getItem", "a9_current_reading");
            if (!string.IsNullOrEmpty(sessionJson))
            {
                ActiveSession = JsonSerializer.Deserialize<StoryBookmark>(sessionJson);
            }
            else
            {
                ActiveSession = null;
            }
        }
        catch
        {
            SavedBookmarks = [];
            ActiveSession = null;
        }
        StateHasChanged();
    }

    private void ToggleBookmarksDrawer()
    {
        showBookmarksDrawer = !showBookmarksDrawer;
    }

    private async Task DeleteBookmark(string storyId)
    {
        SavedBookmarks.RemoveAll(b => b.StoryId == storyId);
        if (ActiveSession?.StoryId == storyId)
        {
            ActiveSession = null;
            try
            {
                await JS.InvokeVoidAsync("localStorage.removeItem", "a9_current_reading");
            }
            catch { }
        }
        try
        {
            var json = JsonSerializer.Serialize(SavedBookmarks);
            await JS.InvokeVoidAsync("localStorage.setItem", "a9_story_bookmarks", json);
        }
        catch { }
        StateHasChanged();
    }

    private async Task ResumeActiveSession()
    {
        if (ActiveSession != null)
        {
            await ResumeFromBookmark(ActiveSession);
        }
    }

    private async Task ResumeFromBookmark(StoryBookmark b)
    {
        StoryEpisodeInfo? foundEp = null;
        List<StoryEpisodeInfo>? epList = null;
        string nodeTitle = b.Title;

        foreach (var act in TimelineActs)
        {
            foreach (var node in act.MainNodes)
            {
                var ep = node.Episodes.FirstOrDefault(e => e.StoryId == b.StoryId);
                if (ep != null)
                {
                    foundEp = ep;
                    epList = node.Episodes;
                    nodeTitle = node.Title;
                    break;
                }
            }
            if (foundEp != null) break;

            foreach (var node in act.LinkedEvents)
            {
                var ep = node.Episodes.FirstOrDefault(e => e.StoryId == b.StoryId);
                if (ep != null)
                {
                    foundEp = ep;
                    epList = node.Episodes;
                    nodeTitle = node.Title;
                    break;
                }
            }
            if (foundEp != null) break;
        }

        BookmarkInitialLine = b.LineIndex;
        showBookmarksDrawer = false;
        // Always prefer the real script path from the timeline (old bookmarks stored a wrong path)
        var resolvedPath = foundEp?.StoryPath;
        if (string.IsNullOrEmpty(resolvedPath)) resolvedPath = b.StoryPath;
        await OpenReader(b.StoryId, resolvedPath, b.Title, epList, foundEp, nodeTitle);
    }

