@page "/operators/{Id}"
@using Core.Github.DTOs.Response
@using Core.DTOs.Response
@using Core.Helpers
@using Core.Models.Entities
@inject Core.Services.CharacterService service
@inject NavigationManager Nav
@using Microsoft.Extensions.Logging;

@if (op is null)
{
    <!-- Loading State -->
    <div class="od-loading">
        <div class="od-loading-spinner"></div>
        <p>Loading Operator Data...</p>
    </div>
}
else
{
    <div class="od-root">

        <div class="od-bg-layer" style="background-image: url('@currentBgUrl')"></div>

        <!-- --- Hidden asset preloader to verify availability before background display --- -->
        <img src="@GetImageUrl(Id, displayElite)"
             style="display:none"
             @key="elite"
             @onerror="OnImageError"
             @onload="() => currentBgUrl = GetImageUrl(Id, displayElite)" />

        <div class="od-vignette"></div>

        <nav class="od-topnav">
            <button class="od-back-btn" onclick="history.back()">← Back</button>

            <!-- --- Top Navigation Tabs (Extensible: Talents, Modules, Story) --- -->
            <div class="od-tabs">
                <button class="od-tab active">Info</button>
                <button class="od-tab">Skills</button>
            </div>
        </nav>

        <div class="od-content-layer">
            <!-- --- LEFT PANEL: Attributes & Stats --- -->
            <aside class="od-panel od-panel-left">
                <!-- --- Sub-section: Attributes & Promotion --- -->
                <div class="od-section od-attributes">
                    <div class="od-section-label">Attributes ▶▶</div>
                    <!-- --- Sub-section: Elite Selector (E0 / E1 / E2) --- -->
                    @if (op?.Phases?.Count == 3)
                    {
                        <div class="od-elite-selector">
                            <button class="od-elite-btn @(elite == 0 ? "active" : "")" @onclick="() => OnEliteChanged(0)">E0</button>
                            <button class="od-elite-btn @(elite == 1 ? "active" : "")" @onclick="() => OnEliteChanged(1)">E1</button>
                            <button class="od-elite-btn @(elite == 2 ? "active" : "")" @onclick="() => OnEliteChanged(2)">E2</button>
                        </div>
                    }
                    else
                    {
                        <div class="od-elite-selector">
                            <button class="od-elite-btn @(elite == 0 ? "active" : "")" @onclick="() => OnEliteChanged(0)">E0</button>
                            <button class="od-elite-btn @(elite == 1 ? "active" : "")" @onclick="() => OnEliteChanged(1)">E1</button>
                        </div>
                    }

                    <!-- Level Slider -->
                    <div class="od-level-row">
                        <span class="od-level-label">LV</span>
                        <input class="od-lv-slider"
                               type="range"
                               min="1"
                               max="@op.Phases[elite].MaxLevel"
                               @bind="currentLevel" />
                        <span class="od-lv-value">@currentLevel</span>
                    </div>

                    <!-- Stat rows -->
                    @{
                        var stats = GetStatsAtTrust(GetRawStat(), selectedTrust);
                        Logger.LogInformation(
                    "Current stat for {opName}(Trust: {trust}): E{elite} LV: {level}, MaxHP: {maxHp}, ATK: {atk}, DEF: {def}, RES: {res}, Cost: {cost}, Block: {block}, Redeploy: {redeploy}",
                        op.Name,
                        selectedTrust,
                        elite,
                        currentLevel,
                        stats.MaxHp,
                        stats.Atk,
                        stats.Def,
                        stats.MagicResistance,
                        stats.Cost,
                        stats.BlockCnt,
                        stats.RespawnTime);
                    }
                    @{
                        var hpModBonus = GetModuleBonus("max_hp");
                        var atkModBonus = GetModuleBonus("atk");
                        var defModBonus = GetModuleBonus("def");
                        var resModBonus = GetModuleBonus("magic_resistance");
                        var costModBonus = GetModuleBonus("cost");
                        var blockModBonus = GetModuleBonus("block_cnt");
                        var redeployModBonus = GetModuleBonus("respawn_time");
                    }
                    <div class="od-stat-row">
                        <img src="/assets/icons/characterdetail/icon_hp.png" />
                        <span>@stats.MaxHp</span>
                        @if (selectedModuleIndex > 0 && hpModBonus != 0)
                        {
                            <span class="od-mod-bonus-badge">(@(hpModBonus > 0 ? "+" : "")@hpModBonus)</span>
                        }
                    </div>
                    <div class="od-stat-row">
                        <img src="/assets/icons/characterdetail/icon_atk.png" />
                        <span>@stats.Atk</span>
                        @if (selectedModuleIndex > 0 && atkModBonus != 0)
                        {
                            <span class="od-mod-bonus-badge">(@(atkModBonus > 0 ? "+" : "")@atkModBonus)</span>
                        }
                    </div>
                    <div class="od-stat-row">
                        <img src="/assets/icons/characterdetail/icon_def.png" />
                        <span>@stats.Def</span>
                        @if (selectedModuleIndex > 0 && defModBonus != 0)
                        {
                            <span class="od-mod-bonus-badge">(@(defModBonus > 0 ? "+" : "")@defModBonus)</span>
                        }
                    </div>
                    <div class="od-stat-row">
                        <img src="/assets/icons/characterdetail/icon_res.png" />
                        <span>@stats.MagicResistance</span>
                        @if (selectedModuleIndex > 0 && resModBonus != 0)
                        {
                            <span class="od-mod-bonus-badge">(@(resModBonus > 0 ? "+" : "")@resModBonus)</span>
                        }
                    </div>
                    <div class="od-stat-row">
                        <img src="/assets/icons/characterdetail/icon_cost.png" />
                        <span>@stats.Cost</span>
                        @if (selectedModuleIndex > 0 && costModBonus != 0)
                        {
                            <span class="od-mod-bonus-badge">(@(costModBonus > 0 ? "+" : "")@costModBonus)</span>
                        }
                    </div>
                    <div class="od-stat-row">
                        <img src="/assets/icons/characterdetail/icon_block.png" />
                        <span>@stats.BlockCnt</span>
                        @if (selectedModuleIndex > 0 && blockModBonus != 0)
                        {
                            <span class="od-mod-bonus-badge">(@(blockModBonus > 0 ? "+" : "")@blockModBonus)</span>
                        }
                    </div>
                    <div class="od-stat-row">
                        <img src="/assets/icons/characterdetail/icon_time.png" />
                        <span>@stats.RespawnTime</span>
                        @if (selectedModuleIndex > 0 && redeployModBonus != 0)
                        {
                            <span class="od-mod-bonus-badge">(@(redeployModBonus > 0 ? "+" : "")@redeployModBonus)</span>
                        }
                    </div>

                    <!-- TRUST BONUS SECTION -->
                    <div class="od-section-label" style="margin-top: 12px;">Trust</div>

                    <div class="od-trust-row">
                        <div class="od-trust-bar-bg">
                            <div class="od-trust-bar-fill" style="width: @(selectedTrust / 2.0)%;"></div>

                            <input class="od-trust-slider"
                                   type="range"
                                   min="0"
                                   max="200"
                                   @bind="selectedTrust"
                                   @bind:event="oninput" />
                        </div>
                        <span class="od-trust-pct">@(selectedTrust)%</span>
                    </div>

                    @{
                        var trustBonus = GetTrustBonus(selectedTrust);
                    }
                    <div class="od-trust-bonus">
                        @if (trustBonus.MaxHp > 0 || trustBonus.Atk > 0 || trustBonus.Def > 0 || trustBonus.MagicResistance > 0)
                        {
                            @if (trustBonus.MaxHp > 0)
                            {
                                <span class="od-trust-bonus-item">+@trustBonus.MaxHp HP</span>
                            }
                            @if (trustBonus.Atk > 0)
                            {
                                <span class="od-trust-bonus-item">+@trustBonus.Atk ATK</span>
                            }
                            @if (trustBonus.Def > 0)
                            {
                                <span class="od-trust-bonus-item">+@trustBonus.Def DEF</span>
                            }
                            @if (trustBonus.MagicResistance > 0)
                            {
                                <span class="od-trust-bonus-item">+@trustBonus.MagicResistance RES</span>
                            }
                        }
                        else
                        {
                            <span style="opacity: 0.6;">No Trust Bonus</span>
                        }
                    </div>
                </div>

                <!-- STAR RATING -->
                @{
                    var stars = op.Rarity switch
                    {
                        "TIER_1" => "★",
                        "TIER_2" => "★★",
                        "TIER_3" => "★★★",
                        "TIER_4" => "★★★★",
                        "TIER_5" => "★★★★★",
                        "TIER_6" => "★★★★★★",
                        _ => ""
                    };
                }

                <div class="od-stars">@stars</div>
            </aside>

            <div class="od-center-info">
                <div class="od-op-name-block">
                    <img class="od-op-class-mini" src="@GetClassIconUrl(op.Profession)" />
                    <h1 class="od-op-name">@op.Name</h1>

                    <!-- SubProf + Position + Tags -->
                    <div class="od-op-meta">
                        <img class="od-subprof-icon" src="/assets/icons/subprofessionicon/sub_@(op.SubProfessionId?.ToLower())_icon.png" />
                        <span class="od-position-badge">@op.Position</span>  <!-- bind: op.Position -->
                        <span class="od-class-badge">@FormatProfession(op.Profession)</span>     <!-- bind: FormatProfession -->
                    </div>

                    <!-- Description -->
                    <p class="od-op-desc">@CleanDescription(op.Description)</p>

                    <!-- Tags -->
                    @if (op.Tags != null && op.Tags.Count > 0)
                    {
                        <div class="od-tag-list">
                            @foreach (var tag in op.Tags)
                            {
                                <span class="od-tag">@tag</span>
                            }
                        </div>
                    }

                    @if (activeRangeData != null)
                    {
                        <!-- ATK range -->
                        <div class="od-attack-range">
                            <!-- Header -->
                            <div class="od-range-header">
                                <span class="od-range-title">Range</span>
                                <span class="od-range-id-badge">@activeRangeData.Id</span>
                            </div>

                            <div class="od-range-grid-container"
                                 style="grid-template-columns: repeat(@activeRangeMatrix?.ColumnCount, 16px);
                                grid-template-rows: repeat(@activeRangeMatrix?.RowCount, 16px);">
                                @for (int r = 0; r < activeRangeMatrix?.RowCount; r++)
                                {
                                    @for (int c = 0; c < activeRangeMatrix.ColumnCount; c++)
                                    {
                                        var cellType = activeRangeMatrix.GetCellType(r, c);
                                        <div class="od-range-tile @cellType" title="[@activeRangeMatrix.GetRowCoord(r), @activeRangeMatrix.GetColCoord(c)]">
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }

                </div>
            </div>

            <!-- --- RIGHT PANEL: Elite, Potential, Skills, Talents & Modules --- -->
            <aside class="od-panel od-panel-right">

                <!-- --- Sub-section: Elite & Potential Header --- -->
                <div class="od-ep-card">
                    <div class="od-ep-top">
                        <!-- Level Circle Badge; opens Level Selection Modal on click -->
                        <div class="od-level-circle clickable" @onclick="() => showLevelModal = true" title="Click to Change Level & Elite">
                            <div class="od-circle-main">
                                <span class="od-circle-lv">LV</span>
                                <span class="od-circle-num">@currentLevel</span>
                            </div>
                            <span class="od-circle-max">/@(op.Phases?[Math.Min(elite, op.Phases.Count - 1)]?.MaxLevel ?? 1)</span>
                            @if (currentLevel >= (op.Phases?[Math.Min(elite, op.Phases.Count - 1)]?.MaxLevel ?? 1))
                            {
                                <span class="od-circle-max-badge">MAX</span>
                            }
                        </div>

                        <!-- Promote MAX & Potential+ Badge Buttons -->
                        <div class="od-ep-actions">
                            <!-- Promote/Elite Icon Picker -->
                            <div class="od-ep-action-box">
                                <div class="od-elite-icons">
                                    @for (int i = 0; i < (op.Phases?.Count ?? 1); i++)
                                    {
                                        var eIndex = i;
                                        <button class="od-elite-icon-btn @(elite == eIndex ? "active" : "")"
                                                @onclick="() => OnEliteChanged(eIndex)"
                                                title="Elite @eIndex">
                                            <img src="https://raw.githubusercontent.com/Aceship/Arknight-Images/main/ui/elite/@(eIndex).png" alt="E@eIndex" onerror="this.onerror=null;this.src='/assets/icons/characterdetail/back_round.png'" />
                                        </button>
                                    }
                                </div>
                                <span class="od-ep-label">Promote @(elite == (op.Phases?.Count ?? 1) - 1 ? "MAX" : $"E{elite}")</span>
                            </div>

                            <!-- Potential Selector -->
                            <div class="od-ep-action-box">
                                <div class="od-potential-dots">
                                    @for (int p = 0; p < 6; p++)
                                    {
                                        var potIndex = p;
                                        <span class="od-pot-dot @(selectedPotential >= potIndex ? "active" : "")"
                                              @onclick="() => selectedPotential = potIndex"
                                              title="Potential @(potIndex + 1)"></span>
                                    }
                                </div>
                                <span class="od-ep-label">Potential +</span>
                            </div>
                        </div>
                    </div>

                    <!-- Interactive Quick Level Slider Bar -->
                    <div class="od-level-quick-row">
                        <span class="od-quick-lv-text">Select Lv:</span>
                        <input class="od-lv-slider"
                               type="range"
                               min="1"
                               max="@(op.Phases?[Math.Min(elite, op.Phases.Count - 1)]?.MaxLevel ?? 1)"
                               @bind="currentLevel"
                               @bind:event="oninput"
                               @onchange="SaveState" />
                        <button class="od-quick-lv-btn" @onclick="() => showLevelModal = true">Change Level ⚙️</button>
                    </div>
                </div>

                <!-- DRAWER 1: SKILL SECTION -->
                <div class="od-drawer-card @(activeDrawer == DrawerState.SkillExpanded ? "expanded" : "collapsed")">
                    <!-- Drawer Header -->
                    <div class="od-drawer-header" @onclick="ToggleSkillDrawer">
                        <div class="od-drawer-title">
                            <span class="od-drawer-arrow">▲</span>
                            <span>Skill</span>
                        </div>
                        <button class="od-drawer-search-btn" @onclick:stopPropagation="true" @onclick="ToggleSkillDrawer" title="Skill Detail Range Search">🔍</button>
                    </div>

                    @if (activeDrawer == DrawerState.SkillExpanded)
                    {
                        <!-- EXPANDED SKILL VIEW (Image 2) -->
                        <div class="od-drawer-body">
                            @if (skills != null && skills.Count > 0)
                            {
                                <!-- Skill Tab Icons Grid -->
                                <div class="od-skill-tabs-expanded">
                                    @for (int i = 0; i < skills.Count; i++)
                                    {
                                        var sIdx = i;
                                        var sk = skills[sIdx];
                                        var firstLvl = sk.Levels?.FirstOrDefault();
                                        <div class="od-skill-tab-item @(selectedSkill == sIdx ? "active" : "")"
                                             @onclick="() => SelectSkill(sIdx)">
                                            <img class="od-skill-tab-img" src="@GetSkillImageUrl(sk.IconId ?? sk.SkillId)" alt="Skill @(sIdx + 1)" onerror="this.onerror=null;this.src='/assets/icons/characterdetail/back_round.png'" />
                                            @if (selectedSkill == sIdx)
                                            {
                                                <span class="od-skill-check">✓</span>
                                            }
                                            @if (firstLvl != null)
                                            {
                                                <div class="od-skill-sp-sub">▶@firstLvl.InitSp ⚡@firstLvl.SpCost</div>
                                            }
                                        </div>
                                    }
                                </div>

                                <!-- Selected Skill Details Card -->
                                @if (CurrentSkillLevel != null && CurrentSkill != null)
                                {
                                    <div class="od-skill-expanded-card">
                                        <div class="od-skill-expanded-header">
                                            <h3 class="od-skill-name-lg">@CurrentSkillLevel.Name</h3>
                                        </div>

                                        <!-- Badges Row: Auto Recovery / Manual / Duration / Range -->
                                        <div class="od-skill-badges-row">
                                            <span class="od-badge auto-recovery">Auto Recovery</span>
                                            <span class="od-badge manual">Manual</span>
                                            @if (CurrentSkillLevel.Duration > 0)
                                            {
                                                <span class="od-badge duration">⏱ @(CurrentSkillLevel.Duration) sec</span>
                                            }
                                            @if (!string.IsNullOrEmpty(CurrentSkillLevel.RangeId))
                                            {
                                                <button class="od-badge range-btn">🔍 Range</button>
                                            }
                                        </div>

                                        <!-- Description -->
                                        <p class="od-skill-desc-text">
                                            @CleanDescription(CurrentSkillLevel.Description)
                                        </p>

                                        <!-- Skill Range Grid Display -->
                                        @if (activeSkillRangeMatrix != null && activeSkillRangeData != null)
                                        {
                                            <div class="od-attack-range od-skill-attack-range" style="margin-top: 8px;">
                                                <div class="od-range-header">
                                                    <span class="od-range-title">Skill Range</span>
                                                    <span class="od-range-id-badge">@activeSkillRangeData.Id</span>
                                                </div>
                                                <div class="od-range-grid-container"
                                                     style="grid-template-columns: repeat(@activeSkillRangeMatrix.ColumnCount, 16px);
                                                    grid-template-rows: repeat(@activeSkillRangeMatrix.RowCount, 16px);">
                                                    @for (int r = 0; r < activeSkillRangeMatrix.RowCount; r++)
                                                    {
                                                        @for (int c = 0; c < activeSkillRangeMatrix.ColumnCount; c++)
                                                        {
                                                            var cellType = activeSkillRangeMatrix.GetCellType(r, c);
                                                            <div class="od-range-tile @cellType" title="[@activeSkillRangeMatrix.GetRowCoord(r), @activeSkillRangeMatrix.GetColCoord(c)]">
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        }

                                        <!-- Skill Footer Action Row -->
                                        <div class="od-skill-footer-row">
                                            <span class="od-default-skill-badge">Default Skill</span>
                                            <div class="od-rank-specialize-group">
                                                <span class="od-rank-badge">RANK <b>@(selectedSkillLevel + 1)</b></span>
                                                <button class="od-specialize-btn">🔺 Specialize skill</button>
                                            </div>
                                        </div>

                                        <!-- Skill Level Dots Selector (1-7, M1-3) -->
                                        <div class="od-skill-level-row">
                                            <span class="od-skill-level-label">Lv</span>
                                            <div class="od-skill-lvl-dots">
                                                @for (int l = 0; l < Math.Min(7, CurrentSkill.Levels.Count); l++)
                                                {
                                                    var lvlIdx = l;
                                                    <span class="od-lvl-dot @(selectedSkillLevel == lvlIdx ? "active" : "")"
                                                          @onclick="() => OnSkillLevelChanged(lvlIdx)">@(lvlIdx + 1)</span>
                                                }
                                                @if (CurrentSkill.Levels.Count > 7)
                                                {
                                                    <span class="od-lvl-separator"></span>
                                                    @for (int m = 7; m < CurrentSkill.Levels.Count; m++)
                                                    {
                                                        var mIdx = m;
                                                        var mNum = m - 6;
                                                        <span class="od-lvl-dot mastery @(selectedSkillLevel == mIdx ? "active" : "")"
                                                              @onclick="() => OnSkillLevelChanged(mIdx)">M@(mNum)</span>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                    else
                    {
                        <!-- COLLAPSED SKILL VIEW (Image 1) -->
                        <div class="od-drawer-body-collapsed" @onclick="ToggleSkillDrawer">
                            @if (skills != null && skills.Count > 0)
                            {
                                <div class="od-skill-summary-row">
                                    <div class="od-skill-summary-icons">
                                        @for (int i = 0; i < skills.Count; i++)
                                        {
                                            var sIdx = i;
                                            var sk = skills[sIdx];
                                            var firstLvl = sk.Levels?.FirstOrDefault();
                                            <div class="od-skill-summary-item @(selectedSkill == sIdx ? "active" : "")">
                                                <img src="@GetSkillImageUrl(sk.IconId ?? sk.SkillId)" alt="Skill @(sIdx + 1)" onerror="this.onerror=null;this.src='/assets/icons/characterdetail/back_round.png'" />
                                                @if (selectedSkill == sIdx)
                                                {
                                                    <span class="od-skill-check">✓</span>
                                                }
                                                @if (firstLvl != null)
                                                {
                                                    <div class="od-skill-sp-sub">▶@firstLvl.InitSp ⚡@firstLvl.SpCost</div>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="od-skill-summary-meta">
                                        <span class="od-summary-rank">RANK <b>@(selectedSkillLevel + 1)</b></span>
                                        <span class="od-summary-specialize">Specialize 🔺</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- DRAWER 2: BRANCH / TALENT / MODULE SECTION -->
                <div class="od-drawer-card @(activeDrawer == DrawerState.ModuleExpanded ? "expanded" : "collapsed")">
                    <!-- Drawer Header -->
                    <div class="od-drawer-header" @onclick="ToggleModuleDrawer">
                        <div class="od-drawer-title">
                            <span class="od-drawer-arrow">▲</span>
                            <span>Branch+</span>
                        </div>
                    </div>

                    @if (activeDrawer == DrawerState.ModuleExpanded)
                    {
                        <!-- EXPANDED MODULE VIEW (Image 3) -->
                        <div class="od-drawer-body">
                            <!-- Subprofession / Branch Header -->
                            <div class="od-branch-header">
                                <img class="od-subprof-icon-lg" src="/assets/icons/subprofessionicon/sub_@(op.SubProfessionId?.ToLower())_icon.png" />
                                <h3 class="od-branch-title-text">@FormatSubProfession(op.SubProfessionId)</h3>
                            </div>

                            <!-- Module Selection Row (Wiki Mode) -->
                            <div class="od-module-block">
                                <span class="od-block-label">Module</span>
                                <div class="od-module-slots-row">
                                    <!-- ORIGINAL Base Module -->
                                    <div class="od-mod-slot-box @(selectedModuleIndex == 0 ? "active" : "")"
                                         @onclick="() => OnModuleSelected(0)">
                                        <span class="od-mod-slot-badge">ORIGINAL</span>
                                        @if (selectedModuleIndex == 0)
                                        {
                                            <span class="od-mod-check">✓</span>
                                        }
                                    </div>

                                    <!-- Operator Custom Modules -->
                                    @if (modules != null && modules.Count > 0)
                                    {
                                        @for (int m = 0; m < modules.Count; m++)
                                        {
                                            var mIdx = m + 1;
                                            var mod = modules[m];
                                            <div class="od-mod-slot-box @(selectedModuleIndex == mIdx ? "active" : "")"
                                                 @onclick="() => OnModuleSelected(mIdx)"
                                                 title="@mod.TypeName1">
                                                <!-- Customization hook: Module icon path (e.g., /assets/icons/modules/...) -->
                                                <img class="od-mod-slot-img" src="@GetModuleTypeIconUrl(mod)" alt="@mod.UniEquipName" onerror="this.onerror=null;this.src='/assets/icons/characterdetail/back_round.png'" />
                                                @if (selectedModuleIndex == mIdx)
                                                {
                                                    <span class="od-mod-check">✓</span>
                                                }
                                            </div>
                                        }
                                    }
                                </div>

                                <!-- Selected Module Name & Details -->
                                <div class="od-mod-info-card">
                                    <span class="od-mod-title">@(CurrentModule != null ? CurrentModule.UniEquipName : $"{op.Name}'s Badge")</span>
                                    @if (CurrentModule != null && (!string.IsNullOrEmpty(CurrentModule.TypeName1) || !string.IsNullOrEmpty(CurrentModule.TypeName2)))
                                    {
                                        <div style="margin: 4px 0 6px 0;">
                                            <span class="od-mod-type-chip">@CurrentModule.TypeName1@(!string.IsNullOrEmpty(CurrentModule.TypeName2) ? "-" + CurrentModule.TypeName2 : "")</span>
                                        </div>
                                    }
                                    <p class="od-mod-desc">@(CurrentModule != null ? CurrentModule.UniEquipDesc : "Default Module")</p>

                                    <!-- Per-Stage Stat detail (from BattleEquipPack) -->
                                    @if (CurrentModule != null)
                                    {
                                        <div class="od-mod-stage-detail">
                                            <button class="od-manage-btn" @onclick="() => showModuleStatModal = true">
                                                View Details
                                            </button>
                                        </div>
                                    }
                                    else if (CurrentModule != null && currentModuleBattleEquip == null)
                                    {
                                        <p class="od-mod-no-stat">Loading module stat data...</p>
                                    }

                                    <!-- TODO: Module upgrade material requirements rendering (future task) -->
                                    <!--
                                <div class="od-mod-materials-section">
                                    <span class="od-mod-mat-label">Upgrade Materials:</span>
                                    <div class="od-mod-mat-list">
                                         Render material items list here...
                                    </div>
                                </div>
                                -->

                                    <div class="od-mod-footer-row">
                                        <span class="od-mod-stage">STAGE <b>@(currentModuleBattleEquip?.Phases?.Count > 0 ? currentModuleBattleEquip.Phases.Count.ToString() : "-")</b></span>
                                    </div>
                                </div>
                            </div>

                            <!-- --- Trait & Attack Range Section --- -->
                            <div class="od-trait-block">
                                <span class="od-block-label">Trait</span>
                                @if (!string.IsNullOrEmpty(op.Description))
                                {
                                    <p class="od-trait-desc">@CleanDescription(op.Description)</p>
                                }
                                else
                                {
                                    <!-- Range ID lookup reference: query against range table using the ID below -->
                                    <!-- RangeId: @op.Phases?[Math.Min(elite, (op.Phases?.Count ?? 1) - 1)]?.RangeId -->
                                    <!-- GitHub range_table EN: https://github.com/ArknightsAssets/ArknightsAssets2/tree/en/assets/dyn/gamedata/excel -->
                                    <p class="od-trait-desc">—</p>
                                }
                            </div>

                            <!-- Talent Section -->
                            @if (op.Talents != null && op.Talents.Count > 0)
                            {
                                <div class="od-talent-block">
                                    <span class="od-block-label">Talent</span>
                                    @foreach (var talent in op.Talents)
                                    {
                                        var candidate = GetActiveTalentCandidate(talent);
                                        if (candidate != null && (!string.IsNullOrEmpty(candidate.Name) || !string.IsNullOrEmpty(candidate.Description)))
                                        {
                                            <div class="od-talent-card-expanded">
                                                <span class="od-talent-name-pill">@candidate.Name</span>
                                                <p class="od-talent-desc-text">@CleanDescription(candidate.Description)</p>
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <!-- COLLAPSED MODULE VIEW (Image 1) -->
                        <div class="od-drawer-body-collapsed" @onclick="ToggleModuleDrawer">
                            <div class="od-module-summary-row">
                                <div class="od-branch-summary">
                                    <img class="od-subprof-icon-sm" src="/assets/icons/subprofessionicon/sub_@(op.SubProfessionId?.ToLower())_icon.png" />
                                    <span class="od-branch-summary-name">@FormatSubProfession(op.SubProfessionId)</span>
                                </div>

                                <div class="od-module-summary-slots">
                                    <div class="od-mod-mini-box @(selectedModuleIndex == 0 ? "active" : "")">ORIGINAL</div>
                                    @if (modules != null && modules.Count > 0)
                                    {
                                        @for (int m = 0; m < modules.Count; m++)
                                        {
                                            var mIdx = m + 1;
                                            var mod = modules[m];
                                            <div class="od-mod-mini-box @(selectedModuleIndex == mIdx ? "active" : "")">
                                                <img src="@GetModuleTypeIconUrl(mod)" alt="@mod.UniEquipName" onerror="this.onerror=null;this.src='/assets/icons/characterdetail/back_round.png'" />
                                            </div>
                                        }
                                    }
                                </div>

                                <div class="od-module-summary-stage">
                                    <span>STAGE <b>-</b></span>
                                    <span class="od-manage-label">Manage +</span>
                                </div>
                            </div>

                            <!-- Active Talent Pill (Image 1 bottom pill) -->
                            @if (op.Talents != null && op.Talents.Count > 0)
                            {
                                var firstTalent = GetActiveTalentCandidate(op.Talents.FirstOrDefault());
                                @if (firstTalent != null && !string.IsNullOrEmpty(firstTalent.Name))
                                {
                                    <div class="od-talent-pill-bar">
                                        <span class="od-talent-pill-text">@firstTalent.Name</span>
                                        <span class="od-pill-dropdown-arrow">▼</span>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>

            </aside>
        </div>

        <!-- LEVEL SELECTOR MODAL / DIALOG -->
        @if (showLevelModal && op != null)
        {
            <div class="od-modal-backdrop" @onclick="() => showLevelModal = false">
                <div class="od-modal-card" @onclick:stopPropagation="true">
                    <div class="od-modal-header">
                        <h3 class="od-modal-title">⚙️ Select Level & Elite Rank - @op.Name</h3>
                        <button class="od-modal-close-btn" @onclick="() => showLevelModal = false">✕</button>
                    </div>
                    <div class="od-modal-body">
                        <!-- Elite Rank Picker -->
                        <div class="od-modal-row">
                            <label class="od-modal-label">Elite Phase:</label>
                            <div class="od-elite-selector">
                                @for (int i = 0; i < (op.Phases?.Count ?? 1); i++)
