    private List<ItemBundle> GetModuleStageCosts(UniEquipData? module, int stage)
    {
        if (module?.ItemCost == null || module.ItemCost.Count == 0) return [];
        var entry = module.ItemCost.FirstOrDefault(x => x.Stage == stage)
                 ?? (stage > 0 && stage <= module.ItemCost.Count ? module.ItemCost[stage - 1] : null);
        return entry?.Items ?? [];
    }

    private string FormatSubProfession(string? subProfId)
    {
        if (string.IsNullOrEmpty(subProfId)) return "Core Caster";
        var clean = subProfId.Replace("_", " ");
        return System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(clean);
    }

    private string FormatStatKey(string? key)
    {
        if (string.IsNullOrEmpty(key)) return "";
        return key.ToLower() switch
        {
            "max_hp" => "HP",
            "atk" => "ATK",
            "def" => "DEF",
            "magic_resistance" => "RES",
            "attack_speed" => "ASPD",
            "cost" => "DP COST",
            "block_cnt" => "BLOCK",
            "respawn_time" => "REDEPLOY",
            _ => key.Replace("_", " ").ToUpper()
        };
    }

    private string FormatStatValue(BlackboardDataPair bb)
    {
        if (!bb.Value.HasValue) return "+0";
        var val = bb.Value.Value;
        if (val > -1.0 && val < 1.0 && val != 0)
        {
            return $"{(val > 0 ? "+" : "")}{(val * 100):0.#}%";
        }
        return $"{(val > 0 ? "+" : "")}{val}";
    }

    private string GetModuleIconUrl(UniEquipData? module)
    {
        if (module == null || string.IsNullOrEmpty(module.UniEquipIcon) || module.UniEquipIcon.Equals("original", StringComparison.OrdinalIgnoreCase))
        {
            if (!string.IsNullOrEmpty(op?.SubProfessionId))
            {
                return GetSubProfessionIconUrl(op.SubProfessionId);
            }
            return GetClassIconUrl(op?.Profession);
        }
        Logger.LogInformation("Load module image {imageId}", module.UniEquipIcon.ToLower());
        return $"https://raw.githubusercontent.com/ArknightsAssets/ArknightsAssets2/en/assets/dyn/arts/ui/uniequipimg/{module.UniEquipIcon.ToLower()}.png";
    }

    private RangeData? activeRangeData;       // Operator base attack range for current phase
    private RangeMatrix? activeRangeMatrix;
    private RangeData? activeSkillRangeData;  // Skill override attack range for current skill level
    private RangeMatrix? activeSkillRangeMatrix;

    protected override async Task OnParametersSetAsync()
    {
        var totalSw = System.Diagnostics.Stopwatch.StartNew();
        var stepSw = new System.Diagnostics.Stopwatch();
        int errCount = 0;
        int warnCount = 0;

        try
        {
            stepSw.Start();
            op = await service.GetByIdAsync(Id);
            stepSw.Stop();

            Logger?.LogInformation("{Header}", PipelineLogger.FormatHeader("PIPELINE START", op?.Name ?? Id ?? "Unknown", Id ?? ""));

            // --- Step 1: Core Profile (15%) ---
            string profileDetails = op != null
                ? $"{op.Profession} | {op.Rarity?.Replace("TIER_", "")}★ | Phases: {op.Phases?.Count ?? 0} | Talents: {op.Talents?.Count ?? 0}"
                : "Not Found";
            Logger?.LogInformation("{Step}", PipelineLogger.FormatStep(15, PipelineLogger.TagRamHit(), "Profile Core", profileDetails, stepSw.ElapsedMilliseconds));

            selectedSkill = 0;
            selectedModuleIndex = 0;
            currentModuleBattleEquip = null;
            currentModuleMissions = [];
            isSkillExpanded = true;
            isModuleExpanded = true;

            int savedModuleIdx = 0;
            int savedModuleStage = 0;

            // Load saved Level/Elite state if previously set
            if (!string.IsNullOrEmpty(Id) && _savedOperatorState.TryGetValue(Id, out var savedState))
            {
                elite = savedState.Elite;
                displayElite = savedState.Elite;
                selectedTrust = savedState.Trust;
                currentLevel = savedState.Level;
                savedModuleIdx = savedState.ModuleIndex;
                savedModuleStage = savedState.ModuleStage;
                isSkillExpanded = savedState.SkillExpanded;
                isModuleExpanded = savedState.ModuleExpanded;
            }
            else
            {
                elite = 0;
                displayElite = 0;
                isSkillExpanded = true;
                isModuleExpanded = true;
                if (op?.Phases != null && op.Phases.Count > 0)
                {
                    currentLevel = op.Phases[elite].MaxLevel;
                }
            }

            // Immediately dispatch background art loading in a separate thread (0ms blocking on data pipeline)
            LoadBackgroundArt();

            if (op != null)
            {
                // --- Step 2: Fetch Skills (40%) ---
                stepSw.Restart();
                try
                {
                    skills = await service.GetSkillsForOperatorAsync(op);
                    stepSw.Stop();
                    Logger?.LogInformation("{Step}", PipelineLogger.FormatStep(40, PipelineLogger.TagDiskHit("skill_table.json"), "Skills Loaded", $"{skills?.Count ?? 0} skills resolved & parsed", stepSw.ElapsedMilliseconds));

                    if (skills != null)
                    {
                        for (int i = 0; i < skills.Count; i++)
                        {
                            var s = skills[i];
                            var lv1 = s.Levels?.FirstOrDefault();
                            Logger?.LogInformation("{SubItem}", PipelineLogger.FormatSubItem($"Skill {i + 1}", $"{lv1?.Name ?? s.SkillId} (Lv {s.Levels?.Count ?? 1}) | SP: {lv1?.SpCost} | {s.SkillType}", i == skills.Count - 1));
                        }
                    }
                }
                catch (Exception exSkill)
                {
                    errCount++;
                    Logger?.LogError(exSkill, "Error fetching skills for operator: {OperatorName}", op.Name);
                }

                // --- Step 3: Fetch Modules (65%) ---
                stepSw.Restart();
                try
                {
                    var opId = !string.IsNullOrEmpty(op.Id) ? op.Id : Id;
                    modules = await service.GetModulesByOperatorAsync(opId);
                    stepSw.Stop();
                    Logger?.LogInformation("{Step}", PipelineLogger.FormatStep(65, PipelineLogger.TagDiskHit("uniequip_table.json"), "Modules (UniEquip)", $"{modules?.Count ?? 0} modules mapped", stepSw.ElapsedMilliseconds));

                    if (modules != null && modules.Count > 0)
                    {
                        for (int i = 0; i < modules.Count; i++)
                        {
                            var m = modules[i];
                            Logger?.LogInformation("{SubItem}", PipelineLogger.FormatSubItem($"Mod {i + 1}", $"{m.UniEquipName} ({m.TypeName1})", i == modules.Count - 1));
                        }

                        // Restore saved module selection if valid
                        if (savedModuleIdx > 0 && savedModuleIdx <= modules.Count)
                        {
                            await OnModuleSelected(savedModuleIdx, savedModuleStage);
                        }
                    }
                }
                catch (Exception exMod)
                {
                    errCount++;
                    Logger?.LogError(exMod, "Error fetching modules for operator: {OperatorName}", op.Name);
                }

                // --- A9-502: Prefetch skill & module icons in a separate background thread (non-blocking) ---
                var skillsToPrefetch = skills;
                var modulesToPrefetch = modules;
                _ = Task.Run(() =>
                {
                    try
                    {
                        if (skillsToPrefetch != null)
                        {
                            foreach (var s in skillsToPrefetch)
                            {
                                ImageService.PrefetchImage(GetSkillImageUrl(s.IconId ?? s.SkillId), category: "skills");
                            }
                        }
                        if (modulesToPrefetch != null)
                        {
                            foreach (var m in modulesToPrefetch)
                            {
                                ImageService.PrefetchImage(GetModuleTypeIconUrl(m), category: "modules");
                            }
                        }
                    }
                    catch { }
                });
            }

            // --- Step 4: Attack Ranges (80%) ---
            stepSw.Restart();
            try
            {
                await UpdateRangeAsync();
                stepSw.Stop();
                string rangeInfo = activeRangeData != null ? $"Base [{activeRangeData.Grids?.Count ?? 0} tiles] mapped" : "Default";
                if (activeSkillRangeData != null) rangeInfo += $" | Skill [{activeSkillRangeData.Grids?.Count ?? 0} tiles]";
                Logger?.LogInformation("{Step}", PipelineLogger.FormatStep(80, PipelineLogger.TagStatic("range_table.json"), "Attack Ranges", rangeInfo, stepSw.ElapsedMilliseconds));
            }
            catch (Exception exRange)
            {
                warnCount++;
                Logger?.LogWarning(exRange, "Error updating range data for operator: {OperatorName}", op?.Name);
            }

            // --- Step 5: Battle Stats (90%) ---
            stepSw.Restart();
            var stats = GetStatsAtTrust(GetRawStat(), selectedTrust);
            stepSw.Stop();
            Logger?.LogInformation("{Step}", PipelineLogger.FormatStep(90, PipelineLogger.TagComputed(), "Battle Stats", $"E{elite} LV{currentLevel} Trust{selectedTrust}% -> HP: {stats.MaxHp} | ATK: {stats.Atk} | DEF: {stats.Def}", stepSw.ElapsedMilliseconds));

            // --- Step 6: Visual Assets (100%) — art background loaded in background thread ---
            Logger?.LogInformation("{Step}", PipelineLogger.FormatStep(100, PipelineLogger.TagDiskHit("Art Cache"), "Visual Assets", $"Background E{displayElite} dispatched asynchronously | UI ready", stepSw.ElapsedMilliseconds));

            // --- Pipeline Complete ---
            totalSw.Stop();
            Logger?.LogInformation("{Footer}", PipelineLogger.FormatFooter(op?.Name ?? Id ?? "", totalSw.ElapsedMilliseconds, errCount, warnCount));
        }
        catch (Exception ex)
        {
            errCount++;
            totalSw.Stop();
            Logger?.LogError(ex, "Error fetching operator details for Id: {Id}", Id);
            Logger?.LogInformation("{Footer}", PipelineLogger.FormatFooter(Id ?? "Unknown", totalSw.ElapsedMilliseconds, errCount, warnCount));
        }
    }

