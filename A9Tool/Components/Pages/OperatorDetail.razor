@page "/operators/{Id}"
@using Core.Github.DTOs.Response
@using Core.DTOs.Response
@using Core.Helpers
@using Core.Models.Entities
@inject Core.Services.CharacterService service
@inject NavigationManager Nav
@using Microsoft.Extensions.Logging;

@if (op is null)
{
    <!-- Loading State -->
    <div class="od-loading">
        <div class="od-loading-spinner"></div>
        <p>Loading Operator Data...</p>
    </div>
}
else
{
    <div class="od-root">

        <div class="od-bg-layer" style="background-image: url('@currentBgUrl')"></div>

        <!-- Ảnh ẩn dùng để test load, không hiển thị -->
        <img src="@GetImageUrl(Id, displayElite)"
             style="display:none"
             @key="elite"
             @onerror="OnImageError"
             @onload="() => currentBgUrl = GetImageUrl(Id, displayElite)" />

        <div class="od-vignette"></div>

    <nav class="od-topnav">
        <button class="od-back-btn" onclick="history.back()">← Back</button>

        <!-- Tab selector (no logic yet) -->
        <div class="od-tabs">
            <button class="od-tab active">Info</button>
            <button class="od-tab">Skills</button>
            <!-- Có thể mở rộng: Talents, Module, Lore -->
        </div>
    </nav>

    <div class="od-content-layer">
        <!-- ── LEFT PANEL: Attributes + Trust ── -->
        <aside class="od-panel od-panel-left">
            <!-- ATTRIBUTES SECTION -->
            <div class="od-section od-attributes">
                <div class="od-section-label">Attributes ▶▶</div>
                <!-- Elite Selector (E0 / E1 / E2) -->
                @if (op?.Phases?.Count == 3)
                {
                    <div class="od-elite-selector">
                        <button class="od-elite-btn @(elite == 0 ? "active" : "")" @onclick="() => OnEliteChanged(0)">E0</button>
                        <button class="od-elite-btn @(elite == 1 ? "active" : "")" @onclick="() => OnEliteChanged(1)">E1</button>
                        <button class="od-elite-btn @(elite == 2 ? "active" : "")" @onclick="() => OnEliteChanged(2)">E2</button>
                    </div>
                }
                else
                {
                    <div class="od-elite-selector">
                        <button class="od-elite-btn @(elite == 0 ? "active" : "")" @onclick="() => OnEliteChanged(0)">E0</button>
                        <button class="od-elite-btn @(elite == 1 ? "active" : "")" @onclick="() => OnEliteChanged(1)">E1</button>
                    </div>
                }

                <!-- Level Slider -->
                <div class="od-level-row">
                    <span class="od-level-label">LV</span>
                    <input class="od-lv-slider"
                           type="range"
                           min="1"
                           max="@op.Phases[elite].MaxLevel"
                           @bind="currentLevel" />
                    <span class="od-lv-value">@currentLevel</span>
                </div>

                <!-- Stat rows -->
                @{
                    var stats = GetStatsAtTrust(GetRawStat(), selectedTrust);
                    Logger.LogInformation(
                "Current stat for {opName}(Trust: {trust}): E{elite} LV: {level}, MaxHP: {maxHp}, ATK: {atk}, DEF: {def}, RES: {res}, Cost: {cost}, Block: {block}, Redeploy: {redeploy}",
                    op.Name,
                    selectedTrust,
                    elite,
                    currentLevel,
                    stats.MaxHp,
                    stats.Atk,
                    stats.Def,
                    stats.MagicResistance,
                    stats.Cost,
                    stats.BlockCnt,
                    stats.RespawnTime);
                }
                <div class="od-stat-row">
                    <img src="/assets/icons/characterdetail/icon_hp.png" />
                    <span>@stats.MaxHp</span>  <!-- bind: stats.MaxHp -->
                </div>
                <div class="od-stat-row">
                    <img src="/assets/icons/characterdetail/icon_atk.png" />
                    <span>@stats.Atk</span>   <!-- bind: stats.Atk -->
                </div>
                <div class="od-stat-row">
                    <img src="/assets/icons/characterdetail/icon_def.png" />
                    <span>@stats.Def</span>   <!-- bind: stats.Def -->
                </div>
                <div class="od-stat-row">
                    <img src="/assets/icons/characterdetail/icon_res.png" />
                    <span>@stats.MagicResistance</span>   <!-- bind: stats.MagicResistance -->
                </div>
                <div class="od-stat-row">
                    <img src="/assets/icons/characterdetail/icon_cost.png" />
                    <span>@stats.Cost</span>    <!-- bind: stats.Cost -->
                </div>
                <div class="od-stat-row">
                    <img src="/assets/icons/characterdetail/icon_block.png" />
                    <span>@stats.BlockCnt</span>     <!-- bind: stats.BlockCnt -->
                </div>
                <div class="od-stat-row">
                    <img src="/assets/icons/characterdetail/icon_time.png" />
                    <span>@stats.RespawnTime</span>   <!-- bind: stats.RespawnTime -->
                </div>

                <!-- TRUST BONUS SECTION -->
                <div class="od-section-label" style="margin-top: 12px;">Trust</div>

                <div class="od-trust-row">
                    <div class="od-trust-bar-bg">
                        <div class="od-trust-bar-fill" style="width: @(selectedTrust / 2.0)%;"></div>

                        <input class="od-trust-slider"
                               type="range"
                               min="0"
                               max="200"
                               @bind="selectedTrust"
                               @bind:event="oninput" />
                    </div>
                    <span class="od-trust-pct">@(selectedTrust)%</span>
                </div>

                @{
                    var trustBonus = GetTrustBonus(selectedTrust);
                }
                <div class="od-trust-bonus">
                    @if (trustBonus.MaxHp > 0 || trustBonus.Atk > 0 || trustBonus.Def > 0 || trustBonus.MagicResistance > 0)
                    {
                        @if (trustBonus.MaxHp > 0)
                        {
                            <span class="od-trust-bonus-item">+@trustBonus.MaxHp HP</span>
                        }
                        @if (trustBonus.Atk > 0)
                        {
                            <span class="od-trust-bonus-item">+@trustBonus.Atk ATK</span>
                        }
                        @if (trustBonus.Def > 0)
                        {
                            <span class="od-trust-bonus-item">+@trustBonus.Def DEF</span>
                        }
                        @if (trustBonus.MagicResistance > 0)
                        {
                            <span class="od-trust-bonus-item">+@trustBonus.MagicResistance RES</span>
                        }
                    }
                    else
                    {
                        <span style="opacity: 0.6;">No Trust Bonus</span>
                    }
                </div>
            </div>

            <!-- STAR RATING -->
            @{
                var stars = op.Rarity switch
                {
                    "TIER_1" => "★",
                    "TIER_2" => "★★",
                    "TIER_3" => "★★★",
                    "TIER_4" => "★★★★",
                    "TIER_5" => "★★★★★",
                    "TIER_6" => "★★★★★★",
                    _ => ""
                };
            }

            <div class="od-stars">@stars</div>
        </aside>

        <div class="od-center-info">
            <div class="od-op-name-block">
                <img class="od-op-class-mini" src="@GetClassIconUrl(op.Profession)" />
                <h1 class="od-op-name">@op.Name</h1>

                <!-- SubProf + Position + Tags -->
                <div class="od-op-meta">
                    <img class="od-subprof-icon" src="/assets/icons/subprofessionicon/sub_@(op.SubProfessionId?.ToLower())_icon.png" />
                    <span class="od-position-badge">@op.Position</span>  <!-- bind: op.Position -->
                    <span class="od-class-badge">@FormatProfession(op.Profession)</span>     <!-- bind: FormatProfession -->
                </div>

                <!-- Description -->
                <p class="od-op-desc">@CleanDescription(op.Description)</p>

                <!-- Tags -->
                @if (op.Tags != null && op.Tags.Count > 0)
                {
                    <div class="od-tag-list">
                        @foreach (var tag in op.Tags)
                        {
                            <span class="od-tag">@tag</span>
                        }
                    </div>
                }

                @if (activeRangeData != null){
                <!-- ATK range -->
                <div class="od-attack-range">
                    <!-- Header -->
                    <div class="od-range-header">
                        <span class="od-range-title">Range</span>
                        <span class="od-range-id-badge">@activeRangeData.Id</span>
                    </div>

                    <div class="od-range-grid-container"
                         style="grid-template-columns: repeat(@activeRangeMatrix?.ColumnCount, 16px);
                        grid-template-rows: repeat(@activeRangeMatrix?.RowCount, 16px);">
                        @for (int r = 0; r < activeRangeMatrix?.RowCount; r++)
                        {
                            @for (int c = 0; c < activeRangeMatrix.ColumnCount; c++)
                            {
                                var cellType = activeRangeMatrix.GetCellType(r, c);
                                <div class="od-range-tile @cellType" title="[@activeRangeMatrix.GetRowCoord(r), @activeRangeMatrix.GetColCoord(c)]">
                                </div>
                            }
                        }
                    </div>
                </div>
                }

            </div>
        </div>

        <!-- ── RIGHT PANEL: Elite/Potential/Skill/Talent/Module ── -->
        <aside class="od-panel od-panel-right">

            <!-- ELITE + POTENTIAL ROW & LEVEL HEADER -->
            <div class="od-ep-card">
                <div class="od-ep-top">
                    <!-- Level Circle Badge (LV 80/80 MAX) - Click mở Modal chọn Level -->
                    <div class="od-level-circle clickable" @onclick="() => showLevelModal = true" title="Click to Change Level & Elite">
                        <div class="od-circle-main">
                            <span class="od-circle-lv">LV</span>
                            <span class="od-circle-num">@currentLevel</span>
                        </div>
                        <span class="od-circle-max">/@(op.Phases?[Math.Min(elite, op.Phases.Count - 1)]?.MaxLevel ?? 1)</span>
                        @if (currentLevel >= (op.Phases?[Math.Min(elite, op.Phases.Count - 1)]?.MaxLevel ?? 1))
                        {
                            <span class="od-circle-max-badge">MAX</span>
                        }
                    </div>

                    <!-- Promote MAX & Potential+ Badge Buttons -->
                    <div class="od-ep-actions">
                        <!-- Promote/Elite Icon Picker -->
                        <div class="od-ep-action-box">
                            <div class="od-elite-icons">
                                @for (int i = 0; i < (op.Phases?.Count ?? 1); i++)
                                {
                                    var eIndex = i;
                                    <button class="od-elite-icon-btn @(elite == eIndex ? "active" : "")"
                                            @onclick="() => OnEliteChanged(eIndex)"
                                            title="Elite @eIndex">
                                        <img src="https://raw.githubusercontent.com/Aceship/Arknight-Images/main/ui/elite/@(eIndex).png" alt="E@eIndex" />
                                    </button>
                                }
                            </div>
                            <span class="od-ep-label">Promote @(elite == (op.Phases?.Count ?? 1) - 1 ? "MAX" : $"E{elite}")</span>
                        </div>

                        <!-- Potential Selector -->
                        <div class="od-ep-action-box">
                            <div class="od-potential-dots">
                                @for (int p = 0; p < 6; p++)
                                {
                                    var potIndex = p;
                                    <span class="od-pot-dot @(selectedPotential >= potIndex ? "active" : "")"
                                          @onclick="() => selectedPotential = potIndex"
                                          title="Potential @(potIndex + 1)"></span>
                                }
                            </div>
                            <span class="od-ep-label">Potential +</span>
                        </div>
                    </div>
                </div>

                <!-- Interactive Quick Level Slider Bar -->
                <div class="od-level-quick-row">
                    <span class="od-quick-lv-text">Select Lv:</span>
                    <input class="od-lv-slider"
                           type="range"
                           min="1"
                           max="@(op.Phases?[Math.Min(elite, op.Phases.Count - 1)]?.MaxLevel ?? 1)"
                           @bind="currentLevel"
                           @bind:event="oninput"
                           @onchange="SaveState" />
                    <button class="od-quick-lv-btn" @onclick="() => showLevelModal = true">Change Level ⚙️</button>
                </div>
            </div>

            <!-- DRAWER 1: SKILL SECTION -->
            <div class="od-drawer-card @(activeDrawer == DrawerState.SkillExpanded ? "expanded" : "collapsed")">
                <!-- Drawer Header -->
                <div class="od-drawer-header" @onclick="ToggleSkillDrawer">
                    <div class="od-drawer-title">
                        <span class="od-drawer-arrow">▲</span>
                        <span>Skill</span>
                    </div>
                    <button class="od-drawer-search-btn" @onclick:stopPropagation="true" @onclick="ToggleSkillDrawer" title="Skill Detail Range Search">🔍</button>
                </div>

                @if (activeDrawer == DrawerState.SkillExpanded)
                {
                    <!-- EXPANDED SKILL VIEW (Image 2) -->
                    <div class="od-drawer-body">
                        @if (skills != null && skills.Count > 0)
                        {
                            <!-- Skill Tab Icons Grid -->
                            <div class="od-skill-tabs-expanded">
                                @for (int i = 0; i < skills.Count; i++)
                                {
                                    var sIdx = i;
                                    var sk = skills[sIdx];
                                    var firstLvl = sk.Levels?.FirstOrDefault();
                                    <div class="od-skill-tab-item @(selectedSkill == sIdx ? "active" : "")"
                                         @onclick="() => SelectSkill(sIdx)">
                                        <img class="od-skill-tab-img" src="@GetSkillImageUrl(sk.IconId ?? sk.SkillId)" alt="Skill @(sIdx + 1)" />
                                        @if (selectedSkill == sIdx)
                                        {
                                            <span class="od-skill-check">✓</span>
                                        }
                                        @if (firstLvl != null)
                                        {
                                            <div class="od-skill-sp-sub">▶@firstLvl.InitSp ⚡@firstLvl.SpCost</div>
                                        }
                                    </div>
                                }
                            </div>

                            <!-- Selected Skill Details Card -->
                            @if (CurrentSkillLevel != null && CurrentSkill != null)
                            {
                                <div class="od-skill-expanded-card">
                                    <div class="od-skill-expanded-header">
                                        <h3 class="od-skill-name-lg">@CurrentSkillLevel.Name</h3>
                                    </div>

                                    <!-- Badges Row: Auto Recovery / Manual / Duration / Range -->
                                    <div class="od-skill-badges-row">
                                        <span class="od-badge auto-recovery">Auto Recovery</span>
                                        <span class="od-badge manual">Manual</span>
                                        @if (CurrentSkillLevel.Duration > 0)
                                        {
                                            <span class="od-badge duration">⏱ @(CurrentSkillLevel.Duration) sec</span>
                                        }
                                        @if (!string.IsNullOrEmpty(CurrentSkillLevel.RangeId))
                                        {
                                            <button class="od-badge range-btn">🔍 Range</button>
                                        }
                                    </div>

                                    <!-- Description -->
                                    <p class="od-skill-desc-text">
                                        @CleanDescription(CurrentSkillLevel.Description)
                                    </p>

                                    <!-- Skill Range Grid Display -->
                                    @if (activeSkillRangeMatrix != null && activeSkillRangeData != null)
                                    {
                                        <div class="od-attack-range od-skill-attack-range" style="margin-top: 8px;">
                                            <div class="od-range-header">
                                                <span class="od-range-title">Skill Range</span>
                                                <span class="od-range-id-badge">@activeSkillRangeData.Id</span>
                                            </div>
                                            <div class="od-range-grid-container"
                                                 style="grid-template-columns: repeat(@activeSkillRangeMatrix.ColumnCount, 16px);
                                                        grid-template-rows: repeat(@activeSkillRangeMatrix.RowCount, 16px);">
                                                @for (int r = 0; r < activeSkillRangeMatrix.RowCount; r++)
                                                {
                                                    @for (int c = 0; c < activeSkillRangeMatrix.ColumnCount; c++)
                                                    {
                                                        var cellType = activeSkillRangeMatrix.GetCellType(r, c);
                                                        <div class="od-range-tile @cellType" title="[@activeSkillRangeMatrix.GetRowCoord(r), @activeSkillRangeMatrix.GetColCoord(c)]">
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }

                                    <!-- Skill Footer Action Row -->
                                    <div class="od-skill-footer-row">
                                        <span class="od-default-skill-badge">Default Skill</span>
                                        <div class="od-rank-specialize-group">
                                            <span class="od-rank-badge">RANK <b>@(selectedSkillLevel + 1)</b></span>
                                            <button class="od-specialize-btn">🔺 Specialize skill</button>
                                        </div>
                                    </div>

                                    <!-- Skill Level Dots Selector (1-7, M1-3) -->
                                    <div class="od-skill-level-row">
                                        <span class="od-skill-level-label">Lv</span>
                                        <div class="od-skill-lvl-dots">
                                            @for (int l = 0; l < Math.Min(7, CurrentSkill.Levels.Count); l++)
                                            {
                                                var lvlIdx = l;
                                                <span class="od-lvl-dot @(selectedSkillLevel == lvlIdx ? "active" : "")"
                                                      @onclick="() => OnSkillLevelChanged(lvlIdx)">@(lvlIdx + 1)</span>
                                            }
                                            @if (CurrentSkill.Levels.Count > 7)
                                            {
                                                <span class="od-lvl-separator"></span>
                                                @for (int m = 7; m < CurrentSkill.Levels.Count; m++)
                                                {
                                                    var mIdx = m;
                                                    var mNum = m - 6;
                                                    <span class="od-lvl-dot mastery @(selectedSkillLevel == mIdx ? "active" : "")"
                                                          @onclick="() => OnSkillLevelChanged(mIdx)">M@(mNum)</span>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }
                else
                {
                    <!-- COLLAPSED SKILL VIEW (Image 1) -->
                    <div class="od-drawer-body-collapsed" @onclick="ToggleSkillDrawer">
                        @if (skills != null && skills.Count > 0)
                        {
                            <div class="od-skill-summary-row">
                                <div class="od-skill-summary-icons">
                                    @for (int i = 0; i < skills.Count; i++)
                                    {
                                        var sIdx = i;
                                        var sk = skills[sIdx];
                                        var firstLvl = sk.Levels?.FirstOrDefault();
                                        <div class="od-skill-summary-item @(selectedSkill == sIdx ? "active" : "")">
                                            <img src="@GetSkillImageUrl(sk.IconId ?? sk.SkillId)" alt="Skill @(sIdx + 1)" />
                                            @if (selectedSkill == sIdx)
                                            {
                                                <span class="od-skill-check">✓</span>
                                            }
                                            @if (firstLvl != null)
                                            {
                                                <div class="od-skill-sp-sub">▶@firstLvl.InitSp ⚡@firstLvl.SpCost</div>
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="od-skill-summary-meta">
                                    <span class="od-summary-rank">RANK <b>@(selectedSkillLevel + 1)</b></span>
                                    <span class="od-summary-specialize">Specialize 🔺</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- DRAWER 2: BRANCH / TALENT / MODULE SECTION -->
            <div class="od-drawer-card @(activeDrawer == DrawerState.ModuleExpanded ? "expanded" : "collapsed")">
                <!-- Drawer Header -->
                <div class="od-drawer-header" @onclick="ToggleModuleDrawer">
                    <div class="od-drawer-title">
                        <span class="od-drawer-arrow">▲</span>
                        <span>Branch+</span>
                    </div>
                </div>

                @if (activeDrawer == DrawerState.ModuleExpanded)
                {
                    <!-- EXPANDED MODULE VIEW (Image 3) -->
                    <div class="od-drawer-body">
                        <!-- Subprofession / Branch Header -->
                        <div class="od-branch-header">
                            <img class="od-subprof-icon-lg" src="/assets/icons/subprofessionicon/sub_@(op.SubProfessionId?.ToLower())_icon.png" />
                            <h3 class="od-branch-title-text">@FormatSubProfession(op.SubProfessionId)</h3>
                        </div>

                        <!-- Module Selection Row (Wiki Mode) -->
                        <div class="od-module-block">
                            <span class="od-block-label">Module</span>
                            <div class="od-module-slots-row">
                                <!-- ORIGINAL Base Module -->
                                <div class="od-mod-slot-box @(selectedModuleIndex == 0 ? "active" : "")"
                                     @onclick="() => OnModuleSelected(0)">
                                    <span class="od-mod-slot-badge">ORIGINAL</span>
                                    @if (selectedModuleIndex == 0)
                                    {
                                        <span class="od-mod-check">✓</span>
                                    }
                                </div>

                                <!-- Operator Custom Modules -->
                                @if (modules != null && modules.Count > 0)
                                {
                                    @for (int m = 0; m < modules.Count; m++)
                                    {
                                        var mIdx = m + 1;
                                        var mod = modules[m];
                                        <div class="od-mod-slot-box @(selectedModuleIndex == mIdx ? "active" : "")"
                                             @onclick="() => OnModuleSelected(mIdx)"
                                             title="@mod.UniEquipName">
                                            <!-- USER_CUSTOMIZATION: Ảnh Module Icon. Bạn có thể tự thay đổi đường dẫn ảnh tại đây (vd: /assets/icons/modules/...) -->
                                            <img class="od-mod-slot-img" src="@GetModuleIconUrl(mod)" alt="@mod.UniEquipName" />
                                            @if (selectedModuleIndex == mIdx)
                                            {
                                                <span class="od-mod-check">✓</span>
                                            }
                                        </div>
                                    }
                                }
                            </div>

                            <!-- Selected Module Name & Details -->
                            <div class="od-mod-info-card">
                                <span class="od-mod-title">@(CurrentModule != null ? CurrentModule.UniEquipName : $"{op.Name}'s Badge")</span>
                                <p class="od-mod-desc">@(CurrentModule != null ? CurrentModule.UniEquipDesc : "Default Module")</p>

                                <!-- Per-Stage Stat detail (from BattleEquipPack) -->
                                @if (CurrentModule != null && currentModuleBattleEquip?.Phases != null && currentModuleBattleEquip.Phases.Count > 0)
                                {
                                    <div class="od-mod-stage-detail">
                                        @for (int stIdx = 0; stIdx < currentModuleBattleEquip.Phases.Count; stIdx++)
                                        {
                                            var phase = currentModuleBattleEquip.Phases[stIdx];
                                            var stageNum = stIdx + 1;
                                            <div class="od-mod-stage-row">
                                                <div class="od-mod-stage-badge">@stageNum</div>
                                                <div class="od-mod-stage-content">
                                                    @{
                                                        // Lấy Trait override nếu có
                                                        var traitOverride = phase.Parts?.FirstOrDefault(p => p.OverrideTraitDataBundle?.Candidates?.Count > 0)
                                                            ?.OverrideTraitDataBundle?.Candidates?.FirstOrDefault();
                                                        // Lấy Talent upgrade nếu có
                                                        var talentUpgrade = phase.Parts?.FirstOrDefault(p => p.AddOrOverrideTalentDataBundle?.Candidates?.Count > 0)
                                                            ?.AddOrOverrideTalentDataBundle?.Candidates?.FirstOrDefault();
                                                        // Lấy stat changes từ AttributeBlackboard (đổi tên tránh conflict với stats ở outer scope)
                                                        var modStats = phase.AttributeBlackboard;
                                                    }
                                                    @if (traitOverride != null && !string.IsNullOrEmpty(traitOverride.OverrideDescripton))
                                                    {
                                                        <span class="od-mod-stage-trait">Trait: @CleanDescription(traitOverride.OverrideDescripton)</span>
                                                    }
                                                    @if (modStats != null && modStats.Count > 0)
                                                    {
                                                        <div class="od-mod-stage-stat">
                                                            @foreach (var bb in modStats.Where(b => b.Value.HasValue && b.Value.Value != 0))
                                                            {
                                                                <span style="margin-right:8px">@bb.Key.ToUpper(): +@bb.Value</span>
                                                            }
                                                        </div>
                                                    }
                                                    @if (talentUpgrade != null && !string.IsNullOrEmpty(talentUpgrade.Description))
                                                    {
                                                        <span class="od-mod-stage-talent">Talent: @CleanDescription(talentUpgrade.Description)</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else if (CurrentModule != null && currentModuleBattleEquip == null)
                                {
                                    <p class="od-mod-no-stat">Loading module stat data...</p>
                                }

                                <!-- USER_CUSTOMIZATION: Phần hiển thị Nguyên liệu Nâng cấp Module (Material Upgrade Costs) - Dành cho task sau -->
                                <!--
                                <div class="od-mod-materials-section">
                                    <span class="od-mod-mat-label">Upgrade Materials:</span>
                                    <div class="od-mod-mat-list">
                                         Render danh sách item / nguyên liệu tại đây...
                                    </div>
                                </div>
                                -->

                                <div class="od-mod-footer-row">
                                    <span class="od-mod-stage">STAGE <b>@(currentModuleBattleEquip?.Phases?.Count > 0 ? currentModuleBattleEquip.Phases.Count.ToString() : "-")</b></span>
                                </div>
                            </div>
                        </div>

                        <!-- Trait Section: Hiển thị description từ Operator trait (CharacterDetail.Description) -->
                        <div class="od-trait-block">
                            <span class="od-block-label">Trait</span>
                            @if (!string.IsNullOrEmpty(op.Description))
                            {
                                <p class="od-trait-desc">@CleanDescription(op.Description)</p>
                            }
                            else
                            {
                                <!-- Range ID cho trait/range lookup: bạn có thể tự copy ID bên dưới để tra range table -->
                                <!-- RangeId: @op.Phases?[Math.Min(elite, (op.Phases?.Count ?? 1) - 1)]?.RangeId -->
                                <!-- GitHub range_table EN: https://github.com/ArknightsAssets/ArknightsAssets2/tree/en/assets/dyn/gamedata/excel -->
                                <p class="od-trait-desc">—</p>
                            }
                        </div>

                        <!-- Talent Section -->
                        @if (op.Talents != null && op.Talents.Count > 0)
                        {
                            <div class="od-talent-block">
                                <span class="od-block-label">Talent</span>
                                @foreach (var talent in op.Talents)
                                {
                                    var candidate = GetActiveTalentCandidate(talent);
                                    if (candidate != null && (!string.IsNullOrEmpty(candidate.Name) || !string.IsNullOrEmpty(candidate.Description)))
                                    {
                                        <div class="od-talent-card-expanded">
                                            <span class="od-talent-name-pill">@candidate.Name</span>
                                            <p class="od-talent-desc-text">@CleanDescription(candidate.Description)</p>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <!-- COLLAPSED MODULE VIEW (Image 1) -->
                    <div class="od-drawer-body-collapsed" @onclick="ToggleModuleDrawer">
                        <div class="od-module-summary-row">
                            <div class="od-branch-summary">
                                <img class="od-subprof-icon-sm" src="/assets/icons/subprofessionicon/sub_@(op.SubProfessionId?.ToLower())_icon.png" />
                                <span class="od-branch-summary-name">@FormatSubProfession(op.SubProfessionId)</span>
                            </div>

                            <div class="od-module-summary-slots">
                                <div class="od-mod-mini-box @(selectedModuleIndex == 0 ? "active" : "")">ORIGINAL</div>
                                @if (modules != null && modules.Count > 0)
                                {
                                    @for (int m = 0; m < modules.Count; m++)
                                    {
                                        var mIdx = m + 1;
                                        var mod = modules[m];
                                        <div class="od-mod-mini-box @(selectedModuleIndex == mIdx ? "active" : "")">
                                            <img src="@GetModuleIconUrl(mod)" alt="@mod.UniEquipName" />
                                        </div>
                                    }
                                }
                            </div>

                            <div class="od-module-summary-stage">
                                <span>STAGE <b>-</b></span>
                                <span class="od-manage-btn">Manage +</span>
                            </div>
                        </div>

                        <!-- Active Talent Pill (Image 1 bottom pill) -->
                        @if (op.Talents != null && op.Talents.Count > 0)
                        {
                            var firstTalent = GetActiveTalentCandidate(op.Talents.FirstOrDefault());
                            @if (firstTalent != null && !string.IsNullOrEmpty(firstTalent.Name))
                            {
                                <div class="od-talent-pill-bar">
                                    <span class="od-talent-pill-text">@firstTalent.Name</span>
                                    <span class="od-pill-dropdown-arrow">▼</span>
                                </div>
                            }
                        }
                    </div>
                }
            </div>

        </aside>
    </div>

    <!-- LEVEL SELECTOR MODAL / DIALOG -->
    @if (showLevelModal && op != null)
    {
        <div class="od-modal-backdrop" @onclick="() => showLevelModal = false">
            <div class="od-modal-card" @onclick:stopPropagation="true">
                <div class="od-modal-header">
                    <h3 class="od-modal-title">⚙️ Select Level & Elite Rank - @op.Name</h3>
                    <button class="od-modal-close-btn" @onclick="() => showLevelModal = false">✕</button>
                </div>
                <div class="od-modal-body">
                    <!-- Elite Rank Picker -->
                    <div class="od-modal-row">
                        <label class="od-modal-label">Elite Phase:</label>
                        <div class="od-elite-selector">
                            @for (int i = 0; i < (op.Phases?.Count ?? 1); i++)
                            {
                                var eIdx = i;
                                <button class="od-elite-btn @(elite == eIdx ? "active" : "")" @onclick="() => OnEliteChanged(eIdx)">E@(eIdx)</button>
                            }
                        </div>
                    </div>

                    <!-- Level Slider & Presets -->
                    <div class="od-modal-row vertical">
                        <div class="od-modal-level-header">
                            <label class="od-modal-label">Level: <b>@currentLevel</b> / @(op.Phases?[Math.Min(elite, op.Phases.Count - 1)]?.MaxLevel ?? 1)</label>
                            <input type="number" min="1" max="@(op.Phases?[Math.Min(elite, op.Phases.Count - 1)]?.MaxLevel ?? 1)"
                                   value="@currentLevel" @onchange="OnLevelInputChanged" class="od-level-input-num" />
                        </div>

                        <input class="od-lv-slider"
                               type="range"
                               min="1"
                               max="@(op.Phases?[Math.Min(elite, op.Phases.Count - 1)]?.MaxLevel ?? 1)"
                               @bind="currentLevel"
                               @bind:event="oninput"
                               @onchange="SaveState" />

                        <div class="od-level-preset-btns">
                            <button class="od-preset-btn" @onclick="() => SetLevel(1)">Lv 1</button>
                            <button class="od-preset-btn" @onclick="() => SetLevel(30)">Lv 30</button>
                            <button class="od-preset-btn" @onclick="() => SetLevel(60)">Lv 60</button>
                            <button class="od-preset-btn active" @onclick="() => SetLevel(op.Phases?[Math.Min(elite, op.Phases.Count - 1)]?.MaxLevel ?? 1)">MAX</button>
                        </div>
                    </div>

                    <!-- Live Stat Preview in Modal -->
                    @{
                        var currentPreviewStats = GetStatsAtTrust(GetRawStat(), selectedTrust);
                    }
                    <div class="od-modal-stat-grid">
                        <div class="od-modal-stat-chip">HP: <b>@currentPreviewStats.MaxHp</b></div>
                        <div class="od-modal-stat-chip">ATK: <b>@currentPreviewStats.Atk</b></div>
                        <div class="od-modal-stat-chip">DEF: <b>@currentPreviewStats.Def</b></div>
                        <div class="od-modal-stat-chip">RES: <b>@currentPreviewStats.MagicResistance</b></div>
                        <div class="od-modal-stat-chip">Cost: <b>@currentPreviewStats.Cost</b></div>
                        <div class="od-modal-stat-chip">Block: <b>@currentPreviewStats.BlockCnt</b></div>
                    </div>
                </div>
                <div class="od-modal-footer">
                    <button class="od-modal-confirm-btn" @onclick="ApplyLevelModal">✓ Save & Apply Level</button>
                </div>
            </div>
        </div>
    }
    </div>
}

@code {
    [Inject] ILogger<OperatorDetail>? Logger { get; set; }

    [Parameter] public string Id { get; set; } = "";

    private CharacterDetail? op;

    private List<SkillsForOperatorResponse> skills = new();
    private List<UniEquipData> modules = new();
    private int selectedModuleIndex = 0;
    private BattleEquipPack? currentModuleBattleEquip;

    private enum DrawerState { Collapsed, SkillExpanded, ModuleExpanded }
    private DrawerState activeDrawer = DrawerState.Collapsed;

    private bool showLevelModal = false;
    private static readonly Dictionary<string, (int Elite, int Level, int Trust)> _savedOperatorState = new();

    private void SaveState()
    {
        if (!string.IsNullOrEmpty(Id))
        {
            _savedOperatorState[Id] = (elite, currentLevel, selectedTrust);
        }
    }

    private void SetLevel(int lvl)
    {
        if (op?.Phases != null && elite < op.Phases.Count)
        {
            currentLevel = Math.Clamp(lvl, 1, op.Phases[elite].MaxLevel);
            SaveState();
        }
    }

    private void OnLevelInputChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            SetLevel(val);
        }
    }

    private void ApplyLevelModal()
    {
        SaveState();
        showLevelModal = false;
    }

    private void ToggleSkillDrawer()
    {
        activeDrawer = activeDrawer == DrawerState.SkillExpanded ? DrawerState.Collapsed : DrawerState.SkillExpanded;
    }

    private void ToggleModuleDrawer()
    {
        activeDrawer = activeDrawer == DrawerState.ModuleExpanded ? DrawerState.Collapsed : DrawerState.ModuleExpanded;
    }

    private async Task OnModuleSelected(int modIdx)
    {
        selectedModuleIndex = modIdx;
        currentModuleBattleEquip = null;

        // modIdx == 0 = ORIGINAL (no BattleEquip), modIdx >= 1 = custom modules
        if (modIdx > 0 && modules != null && modIdx <= modules.Count)
        {
            var mod = modules[modIdx - 1];
            if (!string.IsNullOrEmpty(mod.UniEquipId))
            {
                try
                {
                    currentModuleBattleEquip = await service.GetBattleEquipAsync(mod.UniEquipId);
                    Logger?.LogInformation("[OnModuleSelected] Loaded BattleEquip for '{ModId}': {Phases} phase(s)",
                        mod.UniEquipId, currentModuleBattleEquip?.Phases?.Count ?? 0);
                }
                catch (Exception ex)
                {
                    Logger?.LogWarning(ex, "[OnModuleSelected] Failed to load BattleEquip for '{ModId}'", mod.UniEquipId);
                }
            }
        }
    }

    private SkillLevelResponse? CurrentSkillLevel => GetCurrentSkillLevel();
    private SkillsForOperatorResponse? CurrentSkill => (skills != null && selectedSkill < skills.Count) ? skills[selectedSkill] : null;
    private UniEquipData? CurrentModule => (selectedModuleIndex > 0 && modules != null && selectedModuleIndex <= modules.Count) ? modules[selectedModuleIndex - 1] : null;

    private string FormatSubProfession(string? subProfId)
    {
        if (string.IsNullOrEmpty(subProfId)) return "Core Caster";
        var clean = subProfId.Replace("_", " ");
        return System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(clean);
    }

    private string GetModuleIconUrl(UniEquipData? module)
    {
        if (module == null || string.IsNullOrEmpty(module.UniEquipIcon))
        {
            return "https://raw.githubusercontent.com/ArknightsAssets/ArknightsAssets2/cn/assets/dyn/arts/equip/icon/ORIGINAL.png";
        }
        return $"https://raw.githubusercontent.com/ArknightsAssets/ArknightsAssets2/cn/assets/dyn/arts/equip/icon/{module.UniEquipIcon.ToLower()}.png";
    }

    private RangeData? activeRangeData;       // Range của Operator (Phase)
    private RangeMatrix? activeRangeMatrix;
    private RangeData? activeSkillRangeData;  // Range của Skill level hiện tại
    private RangeMatrix? activeSkillRangeMatrix;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            op = await service.GetByIdAsync(Id);

            selectedSkill = 0;
            selectedModuleIndex = 0;
            activeDrawer = DrawerState.Collapsed;

            // Load saved Level/Elite state if previously set
            if (!string.IsNullOrEmpty(Id) && _savedOperatorState.TryGetValue(Id, out var savedState))
            {
                elite = savedState.Elite;
                displayElite = savedState.Elite;
                selectedTrust = savedState.Trust;
                currentLevel = savedState.Level;
            }
            else
            {
                elite = 0;
                displayElite = 0;
                currentBgUrl = GetImageUrl(Id, displayElite);
                if (op?.Phases != null && op.Phases.Count > 0)
                {
                    currentLevel = op.Phases[elite].MaxLevel;
                }
            }

            if (op != null)
            {
                // 1. Fetch Skills safely
                try
                {
                    skills = await service.GetSkillsForOperatorAsync(op);
                }
                catch (Exception exSkill)
                {
                    Logger?.LogError(exSkill, "Error fetching skills for operator: {OperatorName}", op.Name);
                }

                // 2. Fetch Modules safely
                try
                {
                    modules = await service.GetModulesByOperatorAsync(op.Id);
                }
                catch (Exception exMod)
                {
                    Logger?.LogError(exMod, "Error fetching modules for operator: {OperatorName}", op.Name);
                }
            }

            // 3. Update Range safely (non-blocking for Skill/Module UI)
            try
            {
                await UpdateRangeAsync();
            }
            catch (Exception exRange)
            {
                Logger?.LogWarning(exRange, "Error updating range data for operator: {OperatorName}", op?.Name);
            }

            Logger?.LogInformation(
                "[OnParametersSetAsync] Operator loaded: '{Name}' ({Id}) | E{Elite} LV{Level} Trust:{Trust} | Skills: {SkillCount} | Modules: {ModuleCount}",
                op?.Name, Id, elite, currentLevel, selectedTrust, skills?.Count ?? 0, modules?.Count ?? 0);
        }
        catch (Exception ex)
        {
            Logger?.LogError(ex, "Error fetching operator details for Id: {Id}", Id);
        }
    }

    private int elite = 0;
    private int displayElite = 0;
    private string currentBgUrl = "";
    private bool showLightbox = false;
    private int currentLevel;
    private int selectedTrust = 200;

    private void OnTrustChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value))
        {
            selectedTrust = value;
            SaveState();
        }
    }

    private string GetImageUrl(string id, int eliteLevel) => eliteLevel switch
    {
        0 => $"https://raw.githubusercontent.com/ArknightsAssets/ArknightsAssets2/cn/assets/dyn/arts/characters/{id}/{id}_1.png",
        1 => $"https://raw.githubusercontent.com/ArknightsAssets/ArknightsAssets2/cn/assets/dyn/arts/characters/{id}/{id}_1%2B.png",
        2 => $"https://raw.githubusercontent.com/ArknightsAssets/ArknightsAssets2/cn/assets/dyn/arts/characters/{id}/{id}_2.png",
        _ => $"https://raw.githubusercontent.com/ArknightsAssets/ArknightsAssets2/en/assets/dyn/ui/storyreview/state/activity_review_detail_state/error-icon.png"
    };

    private void OnImageError()
    {
        if (displayElite > 0)
        {
            displayElite--;
        }
        else
        {
            currentBgUrl = "https://raw.githubusercontent.com/ArknightsAssets/ArknightsAssets2/en/assets/dyn/ui/storyreview/state/activity_review_detail_state/error-icon.png";
        }
    }

    private async Task OnEliteChanged(int newElite)
    {
        elite = newElite;
        displayElite = newElite;
        SaveState();
        var maxLv = op?.Phases != null && op.Phases.Count > newElite ? op.Phases[newElite].MaxLevel : 0;
        var phaseRangeId = op?.Phases != null && op.Phases.Count > newElite ? op.Phases[newElite].RangeId : "N/A";
        Logger?.LogInformation(
            "[OnEliteChanged] Operator '{Name}' -> E{Elite} | MaxLevel: {MaxLevel} | RangeId: '{RangeId}'",
            op?.Name, newElite, maxLv, phaseRangeId);
        try
        {
            await UpdateRangeAsync();
        }
        catch (Exception ex)
        {
            Logger?.LogWarning(ex, "Error updating range on elite change.");
        }
    }

    private int selectedSkill = 0;
    private int selectedSkillLevel = 0;
    private int selectedPotential = 0;

    private async Task SelectSkill(int index)
    {
        selectedSkill = index;
        selectedSkillLevel = 0;
        if (skills != null && index < skills.Count)
        {
            var s = skills[index];
            Logger?.LogInformation(
                "[SelectSkill] Operator '{Name}': selected Skill #{Index} Id='{SkillId}' | Levels: {LevelCount}",
                op?.Name, index, s.SkillId, s.Levels?.Count ?? 0);
        }
        try
        {
            await UpdateRangeAsync();
        }
        catch (Exception ex)
        {
            Logger?.LogWarning(ex, "Error updating range on skill select.");
        }
    }

    private async Task OnSkillLevelChanged(int lvlIdx)
    {
        selectedSkillLevel = lvlIdx;
        var skillLvl = GetCurrentSkillLevel();
        Logger?.LogInformation(
            "[OnSkillLevelChanged] Operator '{Name}': Skill #{SkillIdx} -> Level Index {LvlIdx} | Name='{LvlName}' SpCost={SpCost} Duration={Duration}",
            op?.Name, selectedSkill, lvlIdx, skillLvl?.Name, skillLvl?.SpCost ?? 0, skillLvl?.Duration ?? 0);
        try
        {
            await UpdateRangeAsync();
        }
        catch (Exception ex)
        {
            Logger?.LogWarning(ex, "Error updating range on skill level change.");
        }
    }

    private async Task UpdateRangeAsync()
    {
        if (op == null) return;

        // 1. Operator range: luôn lấy từ Phase (với try-catch an toàn)
        try
        {
            var phaseRangeId = op.Phases[Math.Min(elite, op.Phases.Count - 1)].RangeId;
            if (!string.IsNullOrEmpty(phaseRangeId))
            {
                activeRangeData = await service.GetRangeDataAsync(phaseRangeId);
                activeRangeMatrix = activeRangeData != null ? RangeMatrix.Create(activeRangeData) : null;
            }
        }
        catch (Exception ex)
        {
            Logger?.LogWarning(ex, "Failed to load phase range for operator {Id}", op.Id);
            activeRangeData = null;
            activeRangeMatrix = null;
        }

        // 2. Skill range: chỉ lấy khi skill level có RangeId riêng
        try
        {
            var skillLvl = GetCurrentSkillLevel();
            if (!string.IsNullOrEmpty(skillLvl?.RangeId))
            {
                activeSkillRangeData = await service.GetRangeDataAsync(skillLvl.RangeId);
                activeSkillRangeMatrix = activeSkillRangeData != null ? RangeMatrix.Create(activeSkillRangeData) : null;
            }
            else
            {
                activeSkillRangeData = null;
                activeSkillRangeMatrix = null;
            }
        }
        catch (Exception ex)
        {
            Logger?.LogWarning(ex, "Failed to load skill range for operator {Id}", op.Id);
            activeSkillRangeData = null;
            activeSkillRangeMatrix = null;
        }
    }

    private SkillLevelResponse? GetCurrentSkillLevel()
    {
        if (skills == null || skills.Count == 0 || selectedSkill >= skills.Count) return null;
        var s = skills[selectedSkill];
        if (s.Levels == null || s.Levels.Count == 0) return null;
        var idx = Math.Clamp(selectedSkillLevel, 0, s.Levels.Count - 1);
        return s.Levels[idx];
    }

    private TalentCandidate? GetActiveTalentCandidate(Talent talent)
    {
        if (talent.Candidates == null || talent.Candidates.Count == 0) return null;
        return talent.Candidates
            .Where(c => (c.UnlockCondition?.Phase == null || PhaseToInt(c.UnlockCondition.Phase) <= elite)
                     && c.RequiredPotentialRank <= selectedPotential)
            .LastOrDefault() ?? talent.Candidates.FirstOrDefault();
    }

    private int PhaseToInt(string? phase) => phase switch
    {
        "PHASE_0" => 0,
        "PHASE_1" => 1,
        "PHASE_2" => 2,
        _ => 0
    };

    private string GetSkillImageUrl(string? id) => !string.IsNullOrEmpty(id) ? $"https://raw.githubusercontent.com/ArknightsAssets/ArknightsAssets2/cn/assets/dyn/arts/skills/skill_icon_{id}.png" : "/assets/icons/characterdetail/sprite_profession.png";

    private Stats? GetPhaseMaxStats()
    {
        if (op?.Phases == null || op.Phases.Count == 0) return null;
        var phase = op.Phases[Math.Min(elite, op.Phases.Count - 1)];
        var stats = phase.AttributesKeyFrames?.LastOrDefault()?.Data;
        Logger.LogInformation("Max lv {lv}", phase.AttributesKeyFrames.LastOrDefault().Level);
        return stats;
    }

    private Stats GetPhaseMinStats()
    {
        if (op?.Phases == null || op.Phases.Count == 0) return null;
        var phase = op.Phases[Math.Min(elite, op.Phases.Count - 1)];
        var stats = phase.AttributesKeyFrames?.FirstOrDefault()?.Data;
        Logger.LogInformation("Min lv {lv}", phase.AttributesKeyFrames.FirstOrDefault().Level);
        return stats;
    }

    private Stats GetRawStat()
    {
        var max = GetPhaseMaxStats();
        var min = GetPhaseMinStats();
        var phase = op.Phases[Math.Min(elite, op.Phases.Count - 1)];

        var t = (double)(currentLevel - 1) / (phase.MaxLevel - 1);

        var stats = new Stats
        {
            MaxHp = (int)Lerp(min.MaxHp, max.MaxHp, t),
            Atk = (int)Lerp(min.Atk, max.Atk, t),
            Def = (int)Lerp(min.Def, max.Def, t),
            MagicResistance = (int)Lerp(min.MagicResistance, max.MagicResistance, t),
            Cost = max.Cost,
            BlockCnt = max.BlockCnt,
            RespawnTime = max.RespawnTime
        };

        return stats;
    }

    private static double Lerp(double a, double b, double t)
    {
        return a + (b - a) * t;
    }

    private Stats GetTrustBonus(int trust)
    {
        if (op?.TrustBonus == null || op.TrustBonus.Count < 2)
            return new Stats();

        // Trust bonus max 100%
        trust = Math.Clamp(trust, 0, 100);

        var min = op.TrustBonus.First();
        var max = op.TrustBonus.Last();

        // 0% -> favor level 0
        // 100% -> favor level 50
        var favorLevel = trust * max.Level / 100.0;

        var t = (favorLevel - min.Level) /
                (max.Level - min.Level);

        return new Stats
        {
            MaxHp = (int)Lerp(
                min.Data?.MaxHp ?? 0,
                max.Data?.MaxHp ?? 0,
                t),

            Atk = (int)Lerp(
                min.Data?.Atk ?? 0,
                max.Data?.Atk ?? 0,
                t),

            Def = (int)Lerp(
                min.Data?.Def ?? 0,
                max.Data?.Def ?? 0,
                t),

            MagicResistance = (int)Lerp(
                min.Data?.MagicResistance ?? 0,
                max.Data?.MagicResistance ?? 0,
                t)
        };
    }

    private Stats GetStatsAtTrust(Stats raw, int trust)
    {
        var bonus = GetTrustBonus(trust);

        return new Stats
        {
            MaxHp = raw.MaxHp + bonus.MaxHp,
            Atk = raw.Atk + bonus.Atk,
            Def = raw.Def + bonus.Def,
            MagicResistance =
                raw.MagicResistance + bonus.MagicResistance,

            Cost = raw.Cost,
            BlockCnt = raw.BlockCnt,
            RespawnTime = raw.RespawnTime
        };
    }

    private string FormatRarity(string? r)
        => string.IsNullOrEmpty(r) ? "" : r.Replace("TIER_", "") + "★";

    private string FormatProfession(string? p) => p switch
    {
        "PIONEER" => "Vanguard",
        "WARRIOR" => "Guard",
        "TANK" => "Defender",
        "SNIPER" => "Sniper",
        "CASTER" => "Caster",
        "MEDIC" => "Medic",
        "SUPPORT" => "Supporter",
        "SPECIAL" => "Specialist",
        _ => p ?? ""
    };

    private string FormatPhase(string? phase) => phase switch
    {
        "PHASE_0" => "E0",
        "PHASE_1" => "E1",
        "PHASE_2" => "E2",
        _ => phase ?? ""
    };

    private string CleanDescription(string? desc)
        => string.IsNullOrEmpty(desc) ? "" : System.Text.RegularExpressions.Regex.Replace(desc, @"<[^>]+>", "");

    private string GetClassIconUrl(string? p) => p switch
    {
        "PIONEER" => "/assets/icons/classes/class_vanguard.png",
        "WARRIOR" => "/assets/icons/classes/class_guard.png",
        "TANK" => "/assets/icons/classes/class_defender.png",
        "SNIPER" => "/assets/icons/classes/class_sniper.png",
        "CASTER" => "/assets/icons/classes/class_caster.png",
        "MEDIC" => "/assets/icons/classes/class_medic.png",
        "SUPPORT" => "/assets/icons/classes/class_supporter.png",
        "SPECIAL" => "/assets/icons/classes/class_specialist.png",
        _ => "/assets/icons/classes/class_caster.png"
    };
}