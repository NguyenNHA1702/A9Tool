    private string GetImageUrl(string id, int eliteLevel) => eliteLevel switch
    {
        0 => $"https://raw.githubusercontent.com/ArknightsAssets/ArknightsAssets2/cn/assets/dyn/arts/characters/{id}/{id}_1.png",
        1 => $"https://raw.githubusercontent.com/ArknightsAssets/ArknightsAssets2/cn/assets/dyn/arts/characters/{id}/{id}_1%2B.png",
        2 => $"https://raw.githubusercontent.com/ArknightsAssets/ArknightsAssets2/cn/assets/dyn/arts/characters/{id}/{id}_2.png",
        _ => "/assets/icons/characterdetail/back_round.png"
    };

    /// <summary>
    /// Loads character background art decoupled on a background thread so UI and data load instantly.
    /// Fast-path uses synchronous memory/disk cache (0ms). On cache miss, renders remote URL directly
    /// and streams caching into ImageService asynchronously.
    /// </summary>
    private void LoadBackgroundArt()
    {
        if (string.IsNullOrEmpty(Id)) return;

        var targetUrl = GetImageUrl(Id, displayElite);

        // Fast path: Synchronous L1/L2 cache check (0ms)
        if (ImageService.TryGetCachedImage(targetUrl, "characters", out var cachedDataUri))
        {
            currentBgUrl = cachedDataUri;
            return;
        }

        // Fast render: Assign remote URL directly for WebView2 native rendering without blocking C# thread
        currentBgUrl = targetUrl;

        // Decoupled background task: Download and cache to disk for offline use
        var requestedElite = displayElite;
        var requestedId = Id;
        _ = Task.Run(async () =>
        {
            try
            {
                var resolvedUri = await ImageService.GetImageAsync(targetUrl, null, "characters");
                // Only update if user hasn't switched operator or elite in the meantime
                if (!string.IsNullOrEmpty(resolvedUri) && displayElite == requestedElite && Id == requestedId)
                {
                    currentBgUrl = resolvedUri;
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (Exception ex)
            {
                Logger?.LogWarning(ex, "Background download failed for character art: {Url}", targetUrl);
            }
        });
    }

    private void OnImageError()
    {
        if (displayElite > 0)
        {
            displayElite--;
            LoadBackgroundArt();
        }
        else
        {
            currentBgUrl = "/assets/icons/characterdetail/back_round.png";
        }
    }

