@using Core.Github.DTOs.Response
@using Core.DTOs.Response
@using Core.Helpers
@using Core.Models.Entities
@using Core.Enums
@using Core.Services
@inject Core.Services.CharacterService service
@inject Core.Services.ImageService ImageService
@inject Core.Services.LevelingCostService LevelService
@inject NavigationManager Nav
@inject IJSRuntime JS
@using Microsoft.Extensions.Logging;

@if (op is null)
{
    <!-- Loading State -->
    <div class="od-loading">
        <div class="od-loading-spinner"></div>
        <p>Loading Operator Data...</p>
    </div>
}
else
{
    <div class="od-root">

        <div class="od-bg-layer" style="background-image: url('@currentBgUrl')"></div>

        <!-- --- Hidden asset fallback detector to handle missing promotion art --- -->
        <img src="@GetImageUrl(Id, displayElite)"
             style="display:none"
             @key="elite"
             @onerror="OnImageError" />

        <div class="od-vignette"></div>

        <nav class="od-topnav">
            <button class="od-back-btn" @onclick="HandleBack">
                <span style="color:#0284c7; margin-right:4px;">◀</span> BACK TO ROSTER
            </button>

            <div class="od-top-title">// RHODES ISLAND PRTS // PERSONNEL DIAGNOSTICS & COMBAT PROFILE</div>

            <div class="od-tabs">
                <button class="od-tab active">OPERATOR PROFILE</button>
                <button class="od-tab" @onclick="OpenOperatorStoryRecord" title="Read Operator Record Story">📖 STORY RECORD</button>
            </div>
        </nav>

        <div class="od-content-layer">

            <!-- ============================================================
                 LEFT STAGE: IDENTIFICATION & ATTRIBUTES DIAGNOSTIC
                 ============================================================ -->
            <aside class="od-stage-left">
                <!-- Operator Identity Header -->
                <div class="od-operator-header">
                    <div class="od-code-label">PERSONNEL FILE // @(op.Id?.ToUpper() ?? "CHAR")</div>
                    
                    @{
                        var stars = op.Rarity switch
                        {
                            "TIER_1" => "★",
                            "TIER_2" => "★★",
                            "TIER_3" => "★★★",
                            "TIER_4" => "★★★★",
                            "TIER_5" => "★★★★★",
                            "TIER_6" => "★★★★★★",
                            _ => ""
                        };
                    }
                    <div class="od-stars-strip">@stars</div>

                    <!-- Profession & Sub-Profession Mini Badge Row -->
                    <div class="od-header-class-pills">
                        <span class="header-class-chip" title="Class: @FormatProfession(op.Profession)">
                            <img src="@GetClassIconUrl(op.Profession)" class="chip-icon" alt="" onerror="this.style.display='none'" />
                            <span>@FormatProfession(op.Profession).ToUpper()</span>
                        </span>
                        @if (!string.IsNullOrEmpty(op.SubProfessionId))
                        {
                            <span class="header-class-chip sub" title="Branch: @FormatSubProfession(op.SubProfessionId)">
                                <img src="@GetSubProfessionIconUrl(op.SubProfessionId)" class="chip-icon" alt="" onerror="this.style.display='none'" />
                                <span>@FormatSubProfession(op.SubProfessionId)</span>
                            </span>
                        }
                    </div>

                    <!-- Trust Bar (Click to toggle 0% / 100% / 200%) -->
                    <div class="trust-gauge-container" title="Click to toggle Trust (0% / 100% / 200%)" @onclick="ToggleTrustLevel">
                        <span class="trust-title">TRUST</span>
                        <div class="trust-bar">
                            <div class="trust-fill" style="width: @(Math.Min(100, selectedTrust / 2))%"></div>
                        </div>
                        <span class="trust-val">@selectedTrust%</span>
                    </div>

                    <!-- Elite Promotion Selector (E0 / E1 / E2) -->
                    <div class="od-elite-strip">
                        <span class="od-elite-strip-lbl">PROMOTION:</span>
                        @for (int i = 0; i < (op.Phases?.Count ?? 1); i++)
                        {
                            var eIndex = i;
                            <button class="od-elite-chip @(elite == eIndex ? "active" : "")"
                                    @onclick="() => OnEliteChanged(eIndex)">
                                E@(eIndex)
                            </button>
                        }
                    </div>
                </div>

                <!-- Attributes Diagnostic Box (Sắc Cạnh Chuẩn Game Arknights) -->
                @{
                    var stats = GetStatsAtTrust(GetRawStat(), selectedTrust);
                    var hpModBonus = GetModuleBonus("max_hp");
                    var atkModBonus = GetModuleBonus("atk");
                    var defModBonus = GetModuleBonus("def");
                    var resModBonus = GetModuleBonus("magic_resistance");
                    var costModBonus = GetModuleBonus("cost");
                    var blockModBonus = GetModuleBonus("block_cnt");
                    var redeployModBonus = GetModuleBonus("respawn_time");
                }
                <div class="attributes-diagnostic-box">
                    <div class="attr-box-header">
                        <span>ATTRIBUTES DIAGNOSTIC //</span>
                        <span style="color:#0284c7;">DIAG_OK</span>
                    </div>

                    <div class="attr-grid">
                        <div class="attr-item" title="Max HP">
                            <span class="attr-lbl">➕ HP:</span>
                            <span class="attr-val">@stats.MaxHp @(hpModBonus != 0 ? $"({(hpModBonus > 0 ? "+" : "")}{hpModBonus})" : "")</span>
                        </div>
                        <div class="attr-item" title="ATK (Attack)">
                            <span class="attr-lbl">⚔️ ATK:</span>
                            <span class="attr-val">@stats.Atk @(atkModBonus != 0 ? $"({(atkModBonus > 0 ? "+" : "")}{atkModBonus})" : "")</span>
                        </div>
                        <div class="attr-item" title="DEF (Defense)">
                            <span class="attr-lbl">🛡️ DEF:</span>
                            <span class="attr-val">@stats.Def @(defModBonus != 0 ? $"({(defModBonus > 0 ? "+" : "")}{defModBonus})" : "")</span>
                        </div>
                        <div class="attr-item" title="RES (Arts Resistance)">
                            <span class="attr-lbl">✨ RES:</span>
                            <span class="attr-val">@stats.MagicResistance @(resModBonus != 0 ? $"({(resModBonus > 0 ? "+" : "")}{resModBonus})" : "")</span>
                        </div>
                        <div class="attr-item" title="Cost (Deployment)">
                            <span class="attr-lbl">🪙 COST:</span>
                            <span class="attr-val">@stats.Cost @(costModBonus != 0 ? $"({(costModBonus > 0 ? "+" : "")}{costModBonus})" : "")</span>
                        </div>
                        <div class="attr-item" title="Block Count">
                            <span class="attr-lbl">🧱 BLOCK:</span>
                            <span class="attr-val">@stats.BlockCnt @(blockModBonus != 0 ? $"({(blockModBonus > 0 ? "+" : "")}{blockModBonus})" : "")</span>
                        </div>
                        <div class="attr-item" title="Redeployment Time">
                            <span class="attr-lbl">⌛ TIME:</span>
                            <span class="attr-val">@(stats.RespawnTime)s</span>
                        </div>
                        <div class="attr-item" title="Attack Speed">
                            <span class="attr-lbl">🎯 ATK SPD:</span>
                            <span class="attr-val">Normal</span>
                        </div>
                    </div>

                    <!-- Trait / Class Description (Kept in left attributes panel) -->
                    @if (!string.IsNullOrEmpty(op.Description))
                    {
                        <div class="od-trait-text">
                            <span class="trait-tag">[TRAIT]</span> @CleanDescription(op.Description)
                        </div>
                    }

                    <!-- Attack Range Matrix (Kept in left attributes panel) -->
                    @if (activeRangeData != null && activeRangeMatrix != null)
                    {
                        <div class="od-range-wrapper">
                            <div class="od-range-header">
                                <span class="od-range-lbl">ATTACK RANGE // @activeRangeData.Id</span>
                            </div>
                            <div class="od-range-grid-container"
                                 style="grid-template-columns: repeat(@activeRangeMatrix.ColumnCount, 14px);
                                        grid-template-rows: repeat(@activeRangeMatrix.RowCount, 14px);">
                                @for (int r = 0; r < activeRangeMatrix.RowCount; r++)
                                {
                                    @for (int c = 0; c < activeRangeMatrix.ColumnCount; c++)
                                    {
                                        var cellType = activeRangeMatrix.GetCellType(r, c);
                                        <div class="od-range-tile @cellType" title="[@activeRangeMatrix.GetRowCoord(r), @activeRangeMatrix.GetColCoord(c)]"></div>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            </aside>

            <!-- Center Stage: Splash Art Showcase + Bottom-Left Operator Identity Overlay -->
            <div class="od-stage-center">
                <div class="od-hero-overlay">
                    <div class="od-hero-accent">
                        @if (!string.IsNullOrEmpty(op.SubProfessionId))
                        {
                            <img src="@GetSubProfessionIconUrl(op.SubProfessionId)" class="hero-emblem-icon" alt="" onerror="this.style.display='none'" />
                        }
                        else
                        {
                            <img src="@GetClassIconUrl(op.Profession)" class="hero-emblem-icon" alt="" onerror="this.style.display='none'" />
                        }
                        <span class="od-hero-code">FILE // @(op.Id?.ToUpper() ?? "OPERATOR")</span>
                    </div>
                    <h1 class="od-hero-name">@op.Name</h1>
                    <div class="od-hero-tags">
                        @if (!string.IsNullOrEmpty(op.Position))
                        {
                            <span class="od-hero-tag">@op.Position</span>
                        }
                        <span class="od-hero-tag has-icon">
                            <img src="@GetClassIconUrl(op.Profession)" class="hero-tag-img" alt="" onerror="this.style.display='none'" />
                            <span>@FormatProfession(op.Profession)</span>
                        </span>
                        @if (!string.IsNullOrEmpty(op.SubProfessionId))
                        {
                            <span class="od-hero-tag highlight has-icon">
                                <img src="@GetSubProfessionIconUrl(op.SubProfessionId)" class="hero-tag-img" alt="" onerror="this.style.display='none'" />
                                <span>@FormatSubProfession(op.SubProfessionId)</span>
                            </span>
                        }
                    </div>
                </div>
            </div>

            <!-- ============================================================
                 RIGHT STAGE: COMBAT, SKILLS, MODULES & TALENTS
                 ============================================================ -->
            <aside class="od-stage-right">
                <!-- Level & Promote Strip -->
                <div class="level-promote-strip">
                    <div>
                        <div class="level-sub-label">// CURRENT LEVEL & RANK</div>
                        <div class="level-big-val">
                            LV @currentLevel <span class="level-max-val">/ @(op.Phases?[Math.Min(elite, op.Phases.Count - 1)]?.MaxLevel ?? 1)</span>
                        </div>
                    </div>
                    <div class="promote-actions-group">
                        <button class="promote-btn-tag" @onclick="() => showLevelModal = true">
                            <span>🔱</span> PROMOTE @(elite == (op.Phases?.Count ?? 1) - 1 ? "MAX" : $"E{elite}")
                        </button>
                    </div>
                </div>

                <!-- Level Slider & Quick Adjust -->
                <div class="level-slider-strip">
                    <span class="slider-hint">Lv:</span>
                    <input class="od-lv-slider"
                           type="range"
                           min="1"
                           max="@(op.Phases?[Math.Min(elite, op.Phases.Count - 1)]?.MaxLevel ?? 1)"
                           @bind="currentLevel"
                           @bind:event="oninput"
                           @onchange="SaveState" />
                    <button class="od-change-lv-btn" @onclick="() => showLevelModal = true">⚙ Adjust</button>
                </div>

                <!-- Potential Selector (6 Pips) -->
                <div class="potential-pips-strip">
                    <span class="pot-label">POTENTIAL:</span>
                    <div class="pot-pips-row">
                        @for (int p = 0; p < 6; p++)
                        {
                            var potIndex = p;
                            <button class="pot-pip-btn @(selectedPotential >= potIndex ? "active" : "")"
                                    @onclick="() => selectedPotential = potIndex"
                                    title="Potential @(potIndex + 1)">
                                P@(potIndex + 1)
                            </button>
                        }
                    </div>
                </div>

                <!-- COMBAT SKILLS -->
                <div class="od-skills-section">
                    <div class="section-tactical-title">
                        <span>COMBAT SKILLS //</span>
                        <span class="section-sub-hint">Click skill to inspect</span>
                    </div>

                    @if (skills != null && skills.Count > 0)
                    {
                        <div class="skills-canvas-strip">
                            @for (int s = 0; s < skills.Count; s++)
                            {
                                var sIdx = s;
                                var skillObj = skills[s];
                                var isSelected = selectedSkill == sIdx;
                                <div class="skill-card-block @(isSelected ? "selected-skill" : "")"
                                     @onclick="() => SelectSkill(sIdx)">
                                    <img src="@GetSkillImageUrl(skillObj.IconId ?? skillObj.SkillId)"
                                         class="skill-icon-img"
                                         alt="Skill" />
                                    <div class="skill-name-sm">Skill @(sIdx + 1)</div>
                                    @if (isSelected)
                                    {
                                        <div class="skill-selected-badge">ACTIVE ✓</div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Active Skill Detailed View -->
                        @if (CurrentSkill != null)
                        {
                            <div class="skill-expanded-card">
                                <div class="skill-card-title-row">
                                    <div class="skill-card-name">@CurrentSkillLevel?.Name</div>
                                    <button class="skill-detail-open-btn" @onclick="OpenSkillUpgradeModal">View Materials 🔎</button>
                                </div>

                                <div class="skill-badge-tags">
                                    <span class="skill-sp-cost">
                                        ⚡ SP: @(CurrentSkillLevel?.InitSp ?? 0) / @(CurrentSkillLevel?.SpCost ?? 0)
                                    </span>
                                    @if ((CurrentSkillLevel?.Duration ?? 0) > 0)
                                    {
                                        <span class="skill-badge-tag duration">
                                            ⏱ @(CurrentSkillLevel?.Duration)s
                                        </span>
                                    }
                                    @if (!string.IsNullOrEmpty(CurrentSkillLevel?.RangeId))
                                    {
                                        <span class="skill-badge-tag duration">
                                            Range: @CurrentSkillLevel.RangeId
                                        </span>
                                    }
                                </div>

                                <p class="skill-desc-body">
                                    @CleanDescription(CurrentSkillLevel?.Description)
                                </p>

                                <!-- Skill Level Dots Selector -->
                                @if (CurrentSkill.Levels != null && CurrentSkill.Levels.Count > 0)
                                {
                                    <div class="skill-dots-strip">
                                        <span class="dots-label">LEVEL / MASTERY:</span>
                                        <div class="dots-list">
                                            @for (int l = 0; l < CurrentSkill.Levels.Count; l++)
                                            {
                                                var lvl = l;
                                                var isM = lvl >= 7;
                                                <button class="skill-lvl-pip @(isM ? "mastery" : "") @(selectedSkillLevel == lvl ? "active" : "")"
                                                        @onclick="() => OnSkillLevelChanged(lvl)">
                                                    @(isM ? $"M{lvl - 6}" : $"{lvl + 1}")
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="no-item-hint">No Combat Skills Registered</div>
                    }
                </div>

                <!-- TACTICAL MODULE -->
                <div class="od-module-section">
                    <div class="section-tactical-title">
                        <span>TACTICAL MODULE //</span>
                        <span class="section-sub-hint">Branch Equipment</span>
                    </div>

                    <div class="module-slot-block">
                        <!-- Slot Selector -->
                        <div class="module-slots-row">
                            <button class="mod-slot-btn @(selectedModuleIndex == 0 ? "active" : "")"
                                    @onclick="() => OnModuleSelected(0)">
                                ORIGINAL
                            </button>
                            @if (modules != null && modules.Count > 0)
                            {
                                @for (int m = 0; m < modules.Count; m++)
                                {
                                    var mIdx = m + 1;
                                    var mod = modules[m];
                                    <button class="mod-slot-btn @(selectedModuleIndex == mIdx ? "active" : "")"
                                            @onclick="() => OnModuleSelected(mIdx)">
                                        <A9Tool.Components.Common.LazyImage
                                            Src="@GetModuleTypeIconUrl(mod)"
                                            Category="modules"
                                            Class="mod-slot-icon"
                                            Alt="@mod.UniEquipName" />
                                        <span>@(mod.TypeName1 ?? "MOD")</span>
                                    </button>
                                }
                            }
                        </div>

                        <!-- Module Info -->
                        <div class="mod-info-subcard">
                            <div class="mod-info-header">
                                <div class="mod-header-left">
                                    <img src="@GetModuleIconUrl(CurrentModule)" 
                                         class="mod-big-icon clickable" 
                                         alt="@(CurrentModule?.UniEquipName ?? "Module")" 
                                         title="Click to view module detail dossier"
                                         onerror="this.onerror=null;this.src='/assets/icons/characterdetail/back_round.png'"
                                         @onclick="OpenModuleStatModal" />
                                    <div>
                                        <div class="mod-card-name">@(CurrentModule != null ? CurrentModule.UniEquipName : $"{op.Name}'s Standard Equipment")</div>
                                        <div class="mod-card-type">
                                            Class: @FormatSubProfession(op.SubProfessionId)
                                            @(CurrentModule != null && !string.IsNullOrEmpty(CurrentModule.TypeName1) ? $" • {CurrentModule.TypeName1}" : "")
                                        </div>
                                    </div>
                                </div>
                                @if (CurrentModule != null)
                                {
                                    <button class="mod-detail-open-btn" @onclick="OpenModuleStatModal">Manage Details ▾</button>
                                }
                            </div>

                            @if (CurrentModule != null && currentModuleBattleEquip?.Phases != null && currentModuleBattleEquip.Phases.Count > 0)
                            {
                                <!-- Stage Selector Pills (Stage 1, 2, 3) -->
                                <div class="mod-stage-pills-row">
                                    @for (int s = 0; s < currentModuleBattleEquip.Phases.Count; s++)
                                    {
                                        var stageNum = s + 1;
                                        <button class="mod-stage-pill @(selectedModuleStage == stageNum ? "active" : "")"
                                                @onclick="() => selectedModuleStage = stageNum">
                                            STAGE @stageNum
                                        </button>
                                    }
                                </div>

                                <!-- Stage Stats & Trait / Talent Preview for Selected Stage -->
                                var activePhaseIdx = Math.Clamp(selectedModuleStage > 0 ? selectedModuleStage - 1 : 0, 0, currentModuleBattleEquip.Phases.Count - 1);
                                var activePhase = currentModuleBattleEquip.Phases[activePhaseIdx];
                                var sideTrait = activePhase.Parts?.FirstOrDefault(p => p.OverrideTraitDataBundle?.Candidates != null)
                                                                 ?.OverrideTraitDataBundle?.Candidates?.FirstOrDefault();
                                var sideTalent = activePhase.Parts?.FirstOrDefault(p => p.AddOrOverrideTalentDataBundle?.Candidates != null)
                                                                  ?.AddOrOverrideTalentDataBundle?.Candidates?.FirstOrDefault();
                                var sideStats = activePhase.AttributeBlackboard;

                                <div class="mod-stage-summary-box">
                                    @if (sideTrait != null && (!string.IsNullOrEmpty(sideTrait.OverrideDescripton) || !string.IsNullOrEmpty(sideTrait.AdditionalDescription)))
                                    {
                                        <div class="mod-mini-feature trait">
                                            <span class="mod-mini-tag trait">TRAIT UPDATE</span>
                                            <p class="mod-mini-text">@CleanDescription(!string.IsNullOrEmpty(sideTrait.OverrideDescripton) ? sideTrait.OverrideDescripton : sideTrait.AdditionalDescription)</p>
                                        </div>
                                    }
                                    @if (sideTalent != null && (!string.IsNullOrEmpty(sideTalent.UpgradeDescription) || !string.IsNullOrEmpty(sideTalent.Description)))
                                    {
                                        <div class="mod-mini-feature talent">
                                            <span class="mod-mini-tag talent">TALENT IMPROVEMENT: @(!string.IsNullOrEmpty(sideTalent.Name) ? sideTalent.Name : "Talent")</span>
                                            <p class="mod-mini-text">@CleanDescription(!string.IsNullOrEmpty(sideTalent.UpgradeDescription) ? sideTalent.UpgradeDescription : sideTalent.Description)</p>
                                        </div>
                                    }
                                    @if (sideStats != null && sideStats.Any(b => b.Value.HasValue && b.Value.Value != 0))
                                    {
                                        <div class="mod-mini-attr-row">
                                            @foreach (var bb in sideStats.Where(b => b.Value.HasValue && b.Value.Value != 0))
                                            {
                                                <span class="mod-mini-attr-chip">
                                                    @FormatStatKey(bb.Key): <b>@FormatStatValue(bb)</b>
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- COMBAT TALENTS -->
                @if (op.Talents != null && op.Talents.Count > 0)
                {
                    <div class="od-talents-section">
                        <div class="section-tactical-title">
                            <span>COMBAT TALENTS //</span>
                        </div>
                        <div class="talents-grid">
                            @foreach (var talent in op.Talents)
                            {
                                var candidate = GetActiveTalentCandidate(talent);
                                if (candidate != null && (!string.IsNullOrEmpty(candidate.Name) || !string.IsNullOrEmpty(candidate.Description)))
                                {
                                    <div class="talent-card">
                                        <div class="talent-card-header">
                                            <span class="talent-pill">TALENT</span>
                                            <span class="talent-name">@candidate.Name</span>
                                        </div>
                                        <p class="talent-desc">@CleanDescription(candidate.Description)</p>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            </aside>
        </div>


                <!-- LEVEL SELECTOR MODAL / DIALOG -->
        @if (showLevelModal && op != null)
        {
            <div class="od-modal-backdrop" @onclick="() => showLevelModal = false">
                <div class="od-modal-card level-modal" @onclick:stopPropagation="true">
                    <div class="od-modal-header">
                        <h3 class="od-modal-title">⚙️ Select Level & Elite Rank - @op.Name</h3>
                        <button class="od-modal-close-btn" @onclick="() => showLevelModal = false">✕</button>
                    </div>
                    <div class="od-modal-body">
                        <!-- Elite Rank Picker -->
                        <div class="od-modal-row">
                            <label class="od-modal-label">Elite Phase:</label>
                            <div class="od-elite-selector">
                                @for (int i = 0; i < (op.Phases?.Count ?? 1); i++)
                                {
                                    var eIdx = i;
                                    <button class="od-elite-btn @(elite == eIdx ? "active" : "")" @onclick="() => OnEliteChanged(eIdx)">E@(eIdx)</button>
                                }
                            </div>
                        </div>

                        <!-- Level Slider & Presets -->
                        <div class="od-modal-row vertical">
                            <div class="od-modal-level-header">
                                <label class="od-modal-label">Level: <b>@currentLevel</b> / @(op.Phases?[Math.Min(elite, op.Phases.Count - 1)]?.MaxLevel ?? 1)</label>
                                <input type="number" min="1" max="@(op.Phases?[Math.Min(elite, op.Phases.Count - 1)]?.MaxLevel ?? 1)"
                                       value="@currentLevel" @onchange="OnLevelInputChanged" class="od-level-input-num" />
                            </div>

                            <input class="od-lv-slider"
                                   type="range"
                                   min="1"
                                   max="@(op.Phases?[Math.Min(elite, op.Phases.Count - 1)]?.MaxLevel ?? 1)"
                                   @bind="currentLevel"
                                   @bind:event="oninput"
                                   @onchange="SaveState" />

                            <div class="od-level-preset-btns">
                                <button class="od-preset-btn" @onclick="() => SetLevel(1)">Lv 1</button>
                                <button class="od-preset-btn" @onclick="() => SetLevel(30)">Lv 30</button>
                                <button class="od-preset-btn" @onclick="() => SetLevel(60)">Lv 60</button>
                                <button class="od-preset-btn active" @onclick="() => SetLevel(op.Phases?[Math.Min(elite, op.Phases.Count - 1)]?.MaxLevel ?? 1)">MAX</button>
                            </div>
                        </div>

                        <!-- Live Stat Preview in Modal -->
                        @{
                            var currentPreviewStats = GetStatsAtTrust(GetRawStat(), selectedTrust);
                        }
                        <div class="od-modal-stat-grid">
                            <div class="od-modal-stat-chip">HP: <b>@currentPreviewStats.MaxHp</b></div>
                            <div class="od-modal-stat-chip">ATK: <b>@currentPreviewStats.Atk</b></div>
                            <div class="od-modal-stat-chip">DEF: <b>@currentPreviewStats.Def</b></div>
                            <div class="od-modal-stat-chip">RES: <b>@currentPreviewStats.MagicResistance</b></div>
                            <div class="od-modal-stat-chip">Cost: <b>@currentPreviewStats.Cost</b></div>
                            <div class="od-modal-stat-chip">Block: <b>@currentPreviewStats.BlockCnt</b></div>
                        </div>

                        <!-- LEVEL COST & PROMOTION MATERIALS BREAKDOWN -->
                        <div class="od-modal-costs-section">
                            <!-- Leveling Cost (From Level -> currentLevel) -->
                            @{
                                var effectiveFrom = Math.Clamp(costFromLevel, 1, currentLevel);
                                var lvlCost = GetLevelCostPreview();
                            }
                            <div class="od-modal-cost-block">
                                <div class="od-modal-cost-title">
                                    <span>📈 Leveling Cost: Lv @effectiveFrom ➔ Lv @currentLevel</span>
                                </div>

                                <!-- Range Controls for From Level -->
                                <div class="od-cost-range-controls">
                                    <div class="od-cost-from-input-group">
                                        <span class="od-cost-from-label">From Lv:</span>
                                        <input type="number"
                                               min="1"
                                               max="@currentLevel"
                                               value="@costFromLevel"
                                               @onchange="OnCostFromLevelChanged"
                                               class="od-level-input-sm" />
                                        <input type="range"
                                               min="1"
                                               max="@currentLevel"
                                               @bind="costFromLevel"
                                               @bind:event="oninput"
                                               class="od-lv-slider-sm" />
                                    </div>
                                    <div class="od-cost-from-presets">
                                        <button class="od-preset-btn-sm @(costFromLevel == 1 ? "active" : "")" @onclick="() => costFromLevel = 1">Lv 1</button>
                                        @if (currentLevel > 20)
                                        {
                                            <button class="od-preset-btn-sm @(costFromLevel == 20 ? "active" : "")" @onclick="() => costFromLevel = 20">Lv 20</button>
                                        }
                                        @if (currentLevel > 40)
                                        {
                                            <button class="od-preset-btn-sm @(costFromLevel == 40 ? "active" : "")" @onclick="() => costFromLevel = 40">Lv 40</button>
                                        }
                                        @if (currentLevel > 60)
                                        {
                                            <button class="od-preset-btn-sm @(costFromLevel == 60 ? "active" : "")" @onclick="() => costFromLevel = 60">Lv 60</button>
                                        }
                                    </div>
                                </div>

                                <div class="od-modal-cost-badges">
                                    @if (currentLevel <= effectiveFrom)
                                    {
                                        <span class="od-modal-empty-hint">Already at Lv @currentLevel — 0 EXP / 0 LMD required.</span>
                                    }
                                    else
                                    {
                                        <span class="od-exp-chip">⭐ @(lvlCost.TotalExp.ToString("N0")) EXP</span>
                                        <A9Tool.Components.Common.ItemBadge ItemId="4001" Count="@lvlCost.TotalLmd" />
                                    }
                                </div>
                            </div>

                            <!-- Promotion Materials (E@elite) -->
                            <div class="od-modal-cost-block">
                                <div class="od-modal-cost-title">
                                    <span>🎖️ Promotion Requirements (E@(elite))</span>
                                </div>
                                @if (elite == 0)
                                {
                                    <div class="od-modal-empty-hint">Base Form — No promotion materials required.</div>
                                }
                                else
                                {
                                    var promLmd = GetPromotionLmdCostPreview();
                                    var promItems = GetPromotionMaterialsPreview();

                                    <div class="od-modal-cost-badges">
                                        @if (promLmd > 0)
                                        {
                                            <A9Tool.Components.Common.ItemBadge ItemId="4001" Count="@promLmd" />
                                        }
                                        @if (promItems.Count > 0)
                                        {
                                            @foreach (var it in promItems)
                                            {
                                                <A9Tool.Components.Common.ItemBadge ItemId="@it.Id" Count="@it.Count" />
                                            }
                                        }
                                        else if (promLmd == 0)
                                        {
                                            <div class="od-modal-empty-hint">No item requirements recorded.</div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="od-modal-footer">
                        <button class="od-modal-confirm-btn" @onclick="ApplyLevelModal">✓ Save & Apply Level</button>
                    </div>
                </div>
            </div>
        }

        <!-- SKILL UPGRADE & MASTERY MATERIALS MODAL -->
        @if (showSkillUpgradeModal && op != null)
        {
            <div class="od-modal-backdrop" @onclick="() => showSkillUpgradeModal = false">
                <div class="od-skill-modal-card" @onclick:stopPropagation="true">
                    <!-- Modal Header -->
                    <div class="od-modal-header">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span class="od-skill-modal-icon">🔺</span>
                            <h3 class="od-modal-title">Skill Upgrade & Mastery Materials</h3>
                        </div>
                        <button class="od-modal-close-btn" @onclick="() => showSkillUpgradeModal = false">✕</button>
                    </div>

                    <!-- Skill Switcher Tabs (nếu operator có nhiều skill) -->
                    @if (skills != null && skills.Count > 1)
                    {
                        <div class="od-skill-modal-tabs">
                            @for (int s = 0; s < skills.Count; s++)
                            {
                                var sIdx = s;
                                var sk = skills[sIdx];
                                <button class="od-skill-modal-tab-btn @(selectedSkillUpgradeIndex == sIdx ? "active" : "")"
                                        @onclick="() => selectedSkillUpgradeIndex = sIdx">
                                    <img src="@GetSkillImageUrl(sk.IconId ?? sk.SkillId)" class="od-skill-modal-tab-icon" />
                                    <span>Skill @(sIdx + 1)</span>
                                </button>
                            }
                        </div>
                    }

                    <div class="od-skill-modal-body">
                        @{
                            var targetSkill = (skills != null && selectedSkillUpgradeIndex < skills.Count) 
                                ? skills[selectedSkillUpgradeIndex] 
                                : CurrentSkill;
                            var skillName = targetSkill?.Levels?.FirstOrDefault()?.Name ?? "Skill";
                        }

                        <div class="od-skill-modal-target-header">
                            <img src="@GetSkillImageUrl(targetSkill?.IconId ?? targetSkill?.SkillId)" class="od-skill-modal-target-icon" />
                            <div>
                                <h4 class="od-skill-modal-target-title">@skillName</h4>
                                <span class="od-skill-modal-target-type">Type: @(targetSkill?.SkillType ?? "AUTO")</span>
                            </div>
                        </div>

                        <!-- SECTION 1: Common Rank 1 -> 7 Upgrades -->
                        <div class="od-skill-modal-section">
                            <div class="od-skill-section-header">
                                <span class="od-skill-section-badge">Common</span>
                                <h4 class="od-skill-section-title">Rank 1 ➔ 7 Upgrades (All Skills)</h4>
                            </div>

                            @if (op.AllSkillLvlup != null && op.AllSkillLvlup.Count > 0)
                            {
                                <div class="od-skill-level-costs-list">
                                    @for (int r = 0; r < op.AllSkillLvlup.Count; r++)
                                    {
                                        var rankCost = op.AllSkillLvlup[r];
                                        var fromRank = r + 1;
                                        var toRank = r + 2;

                                        <div class="od-skill-cost-row">
                                            <div class="od-skill-cost-rank-badge">
                                                <span class="od-rank-text">Rank @fromRank ➔ @toRank</span>
                                            </div>
                                            <div class="od-skill-cost-items">
                                                @if (rankCost.LvlUpCost != null && rankCost.LvlUpCost.Count > 0)
                                                {
                                                    @foreach (var it in rankCost.LvlUpCost)
                                                    {
                                                        <A9Tool.Components.Common.ItemBadge ItemId="@it.Id" Count="@it.Count" />
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="od-modal-empty-hint">Free</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="od-modal-empty-hint">No common rank upgrade costs recorded for this operator.</div>
                            }
                        </div>

                        <!-- SECTION 2: Mastery 1 -> 3 Specialization for this specific skill -->
                        <div class="od-skill-modal-section">
                            <div class="od-skill-section-header">
                                <span class="od-skill-section-badge mastery">Mastery</span>
                                <h4 class="od-skill-section-title">Mastery Specialization (M1 ➔ M3)</h4>
                            </div>

                            @if (targetSkill?.LevelUpCostCond != null && targetSkill.LevelUpCostCond.Count > 0)
                            {
                                <div class="od-skill-level-costs-list">
                                    @for (int m = 0; m < targetSkill.LevelUpCostCond.Count; m++)
                                    {
                                        var specCost = targetSkill.LevelUpCostCond[m];
                                        var mLevel = m + 1;
                                        var hours = specCost.LvlUpTime / 3600;

                                        <div class="od-skill-cost-row mastery">
                                            <div class="od-skill-cost-rank-badge mastery">
                                                <span class="od-rank-text">Mastery @mLevel</span>
                                                @if (hours > 0)
                                                {
                                                    <span class="od-training-time">⏱ @(hours)h</span>
                                                }
                                            </div>
                                            <div class="od-skill-cost-items">
                                                @if (specCost.LevelUpCost != null && specCost.LevelUpCost.Count > 0)
                                                {
                                                    @foreach (var it in specCost.LevelUpCost)
                                                    {
                                                        <A9Tool.Components.Common.ItemBadge ItemId="@it.Id" Count="@it.Count" />
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="od-modal-empty-hint">No materials required</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="od-modal-empty-hint">This skill has no mastery specialization tiers (max rank 7).</div>
                            }
                        </div>
                    </div>

                    <!-- Modal Footer -->
                    <div class="od-modal-footer">
                        <button class="od-modal-confirm-btn" @onclick="() => showSkillUpgradeModal = false">Close</button>
                    </div>
                </div>
            </div>
        }

        <!-- Module Modal (Arknights Wiki Style) -->
        @if (CurrentModule != null && showModuleStatModal)
        {
            <div class="od-modal-backdrop" @onclick="() => showModuleStatModal = false">
                <div class="od-mod-modal-card wiki-style" @onclick:stopPropagation="true">

                    <!-- Top Header Bar -->
                    <div class="od-mod-modal-header">
                        <div class="od-mod-modal-header-left">
                            @if (!string.IsNullOrEmpty(GetModuleTypeIconUrl(CurrentModule)))
                            {
                                <img class="od-mod-type-icon" src="@GetModuleTypeIconUrl(CurrentModule)" alt="Type Icon" onerror="this.onerror=null;this.src='/assets/icons/characterdetail/back_round.png'" />
                            }
                            <div class="od-mod-header-title-box">
                                <span class="od-mod-code-badge">@(!string.IsNullOrEmpty(CurrentModule.TypeName1) ? $"{CurrentModule.TypeName1}{(string.IsNullOrEmpty(CurrentModule.TypeName2) ? "" : "-" + CurrentModule.TypeName2)}" : "MODULE")</span>
                                <h2 class="od-mod-modal-title">@CurrentModule.UniEquipName</h2>
                            </div>
                        </div>
                        <button class="od-modal-close-btn" @onclick="() => showModuleStatModal = false">✕</button>
                    </div>

                    <!-- Modal Content Layout: Left Art/Info vs Right Vertical Stages (Image 2 Wiki Layout) -->
                    <div class="od-mod-modal-body wiki-body">
                        <div class="od-mod-wiki-grid">
                            
                            <!-- LEFT COLUMN: Module Art only -->
                            <div class="od-mod-wiki-left">
                                <div class="od-mod-art-container">
                                    <img class="od-mod-large-art" src="@GetModuleIconUrl(CurrentModule)" alt="@CurrentModule.UniEquipName" onerror="this.onerror=null;this.src='/assets/icons/characterdetail/back_round.png'" />
                                </div>
                                @if (!string.IsNullOrEmpty(CurrentModule.TypeName1))
                                {
                                    <span class="od-mod-type-chip">@CurrentModule.UniEquipName</span>
                                }
                            </div>

                            <!-- RIGHT COLUMN: Stacked Stages 1st, 2nd, 3rd Breakdown -->
                            <div class="od-mod-wiki-right">
                                @if (currentModuleBattleEquip?.Phases != null && currentModuleBattleEquip.Phases.Count > 0)
                                {
                                    @for (int stIdx = 0; stIdx < currentModuleBattleEquip.Phases.Count; stIdx++)
                                    {
                                        var stageNum = stIdx + 1;
                                        var phase = currentModuleBattleEquip.Phases[stIdx];
                                        var modStats = phase.AttributeBlackboard;
                                        var traitOverride = phase.Parts?.FirstOrDefault(p => p.OverrideTraitDataBundle?.Candidates?.Count > 0)
                                            ?.OverrideTraitDataBundle?.Candidates?.FirstOrDefault();
                                        var talentUpgrade = phase.Parts?.FirstOrDefault(p => p.AddOrOverrideTalentDataBundle?.Candidates?.Count > 0)
                                            ?.AddOrOverrideTalentDataBundle?.Candidates?.FirstOrDefault();

                                        // Check for stage range matrix
                                        var rangeId = traitOverride?.RangeId ?? talentUpgrade?.RangeId;
                                        RangeMatrix? stageRangeMatrix = null;
                                        if (!string.IsNullOrEmpty(rangeId))
                                        {
                                            moduleRangeCache.TryGetValue(rangeId, out stageRangeMatrix);
                                        }

                                        <div class="od-mod-stage-card">
                                            <div class="od-mod-stage-badge">
                                                <span class="od-stage-num">@stageNum</span>
                                                <span class="od-stage-sub">STAGE</span>
                                            </div>

                                            <div class="od-mod-stage-content">
                                                <!-- Trait Improvement -->
                                                @if (traitOverride != null && (!string.IsNullOrEmpty(traitOverride.OverrideDescripton) || !string.IsNullOrEmpty(traitOverride.AdditionalDescription)))
                                                {
                                                    <div class="od-mod-stage-block">
                                                        <span class="od-mod-block-label trait">Trait improved:</span>
                                                        @if (!string.IsNullOrEmpty(traitOverride.OverrideDescripton))
                                                        {
                                                            <p class="od-mod-block-text">@CleanDescription(traitOverride.OverrideDescripton)</p>
                                                        }
                                                        @if (!string.IsNullOrEmpty(traitOverride.AdditionalDescription))
                                                        {
                                                            <p class="od-mod-block-text sub">@CleanDescription(traitOverride.AdditionalDescription)</p>
                                                        }
                                                    </div>
                                                }

                                                <!-- Talent Improvement -->
                                                @if (talentUpgrade != null && (!string.IsNullOrEmpty(talentUpgrade.UpgradeDescription) || !string.IsNullOrEmpty(talentUpgrade.Description)))
                                                {
                                                    <div class="od-mod-stage-block">
                                                        <span class="od-mod-block-label talent">
                                                            @(!string.IsNullOrEmpty(talentUpgrade.Name) ? talentUpgrade.Name : "Talent") improved:
                                                        </span>
                                                        <p class="od-mod-block-text">
                                                            @CleanDescription(!string.IsNullOrEmpty(talentUpgrade.UpgradeDescription) ? talentUpgrade.UpgradeDescription : talentUpgrade.Description)
                                                        </p>
                                                    </div>
                                                }

                                                <!-- Attributes Increased -->
                                                @if (modStats != null && modStats.Any(b => b.Value.HasValue && b.Value.Value != 0))
                                                {
                                                    <div class="od-mod-stage-block">
                                                        <span class="od-mod-block-label attr">Attributes increased:</span>
                                                        <div class="od-mod-attr-list">
                                                            @foreach (var bb in modStats.Where(b => b.Value.HasValue && b.Value.Value != 0))
                                                            {
                                                                <span class="od-mod-attr-item">
                                                                    @FormatStatKey(bb.Key): <b class="val">@FormatStatValue(bb)</b>
                                                                </span>
                                                            }
                                                        </div>
                                                    </div>
                                                }

                                                <!-- Range Matrix preview if present -->
                                                @if (stageRangeMatrix != null)
                                                {
                                                    <div class="od-mod-stage-block">
                                                        <span class="od-mod-block-label range">Attack Range:</span>
                                                        <div class="od-range-grid-container mini"
                                                             style="grid-template-columns: repeat(@stageRangeMatrix.ColumnCount, 14px);
                                                            grid-template-rows: repeat(@stageRangeMatrix.RowCount, 14px);">
                                                            @for (int r = 0; r < stageRangeMatrix.RowCount; r++)
                                                            {
                                                                @for (int c = 0; c < stageRangeMatrix.ColumnCount; c++)
                                                                {
                                                                    var cellType = stageRangeMatrix.GetCellType(r, c);
                                                                    <div class="od-range-tile @cellType"></div>
                                                                }
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="od-mod-no-stat">Loading module stat data...</div>
                                }
                            </div>
                        </div>

                        <!-- DESCRIPTION FULL-WIDTH ROW (below 2-col grid) -->
                        @if (!string.IsNullOrEmpty(CurrentModule.UniEquipDesc))
                        {
                            <div class="od-mod-wiki-desc-row @(isModuleDescExpanded ? "expanded" : "")">
                                <div class="od-mod-wiki-desc-header">
                                    <div class="od-mod-wiki-desc-label">📖 Module Lore & Equipment Description</div>
                                    <button class="od-mod-desc-expand-btn" @onclick="() => isModuleDescExpanded = !isModuleDescExpanded">
                                        @(isModuleDescExpanded ? "⮌ Collapse Description" : "⛶ Expand Full Lore")
                                    </button>
                                </div>
                                <div class="od-mod-wiki-desc-text">@CleanDescription(CurrentModule.UniEquipDesc)</div>
                            </div>
                        }

                        <!-- BOTTOM SECTION: Module Missions & Unlock Conditions Grid -->
                        <div class="od-mod-wiki-bottom">
                            <div class="od-mod-bottom-grid">
                                <!-- Missions Box -->
                                <div class="od-mod-bottom-box">
                                    <div class="od-mod-box-header">Module Missions</div>
                                    <div class="od-mod-box-content">
                                        @if (currentModuleMissions != null && currentModuleMissions.Count > 0)
                                        {
                                            <div class="od-mod-missions-list">
                                                @for (int i = 0; i < currentModuleMissions.Count; i++)
                                                {
                                                    var m = currentModuleMissions[i];
                                                    <div class="od-mod-mission-card">
                                                        <div class="od-mod-mission-header">
                                                            <span class="od-mod-mission-idx">Mission @(i + 1)</span>
                                                            @if (!string.IsNullOrEmpty(m.JumpStageId))
                                                            {
                                                                <span class="od-mod-stage-badge">Stage: @FormatStageId(m.JumpStageId)</span>
                                                            }
                                                        </div>
                                                        <div class="od-mod-mission-desc">@m.GetFormattedDesc()</div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else if (CurrentModule?.MissionList != null && CurrentModule.MissionList.Count > 0)
                                        {
                                            <ol class="od-mod-missions-ol">
                                                @foreach (var mission in CurrentModule.MissionList)
                                                {
                                                    <li>@mission</li>
                                                }
                                            </ol>
                                        }
                                        else
                                        {
                                            <p class="od-mod-no-data">No specific mission required.</p>
                                        }
                                    </div>
                                </div>

                                <!-- Unlock Conditions Box -->
                                <div class="od-mod-bottom-box">
                                    <div class="od-mod-box-header">Unlock conditions</div>
                                    <div class="od-mod-box-content">
                                        <ul class="od-mod-unlock-ul">
                                            <li>Complete all Module Missions</li>
                                            <li>Raise <b>@op?.Name</b> to <b>@FormatPhase(CurrentModule.UnlockEvolvePhase.ToString()) Level @CurrentModule.UnlockLevel</b></li>
                                            <li>Reach at least 100% Trust with <b>@op?.Name</b></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <!-- Materials Box (Module Stage 1, 2, 3) -->
                            @if (CurrentModule != null && CurrentModule.ItemCost != null && CurrentModule.ItemCost.Count > 0)
                            {
                                <div class="od-mod-materials-box">
                                    <div class="od-mod-box-header">Materials Required</div>
                                    <div class="od-mod-mat-stages">
                                        @for (int stage = 1; stage <= CurrentModule.ItemCost.Count; stage++)
                                        {
                                            var stageCosts = GetModuleStageCosts(CurrentModule, stage);
                                            if (stageCosts.Count > 0)
                                            {
                                                <div class="od-mod-stage-cost-row">
                                                    <span class="od-mod-stage-tag">STAGE @stage</span>
                                                    <div class="od-mod-stage-items">
                                                        @foreach (var bundle in stageCosts)
                                                        {
                                                            <A9Tool.Components.Common.ItemBadge ItemId="@bundle.Id" Count="@bundle.Count" />
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                    </div>

                </div>
            </div>
        }

        <!-- OPERATOR RECORD STORY READER MODAL -->
        <A9Tool.Components.Common.StoryReaderModal IsOpen="isStoryRecordOpen"
                                                  Bundle="opStoryBundle"
                                                  OnClose="() => isStoryRecordOpen = false" />
    </div>
}

@code {
    [Inject] ILogger<OperatorDetail>? Logger { get; set; }
    [Inject] Core.Services.StoryService? StoryService { get; set; }

    private bool isStoryRecordOpen = false;
    private StoryScriptBundle? opStoryBundle;

    private async Task OpenOperatorStoryRecord()
    {
        if (op != null && StoryService != null)
        {
            Logger?.LogInformation("[OperatorDetail] Opening Operator Record for: {Name} ({Id})", op.Name, Id);
            opStoryBundle = await StoryService.GetStoryScriptAsync($"record_{Id}", $"obt/record/record_{Id}_1", $"{op.Name}'s Personnel Archive");
            isStoryRecordOpen = true;
        }
    }

    [Parameter] public string Id { get; set; } = "";
    [Parameter] public EventCallback OnBack { get; set; }

    private async Task HandleBack()
    {
        if (OnBack.HasDelegate)
        {
            await OnBack.InvokeAsync();
        }
        else
        {
            Nav.NavigateTo("/operators");
        }
    }

    private CharacterDetail? op;

    private List<SkillsForOperatorResponse> skills = new();
    private List<UniEquipData> modules = new();
    private int selectedModuleIndex = 0;
    private BattleEquipPack? currentModuleBattleEquip;

    private bool isSkillExpanded = true;
    private bool isModuleExpanded = true;

    private bool showLevelModal = false;
    private bool showModuleStatModal = false;
    private bool showSkillUpgradeModal = false;
    private int selectedSkillUpgradeIndex = 0;

    private void OpenSkillUpgradeModal()
    {
        selectedSkillUpgradeIndex = selectedSkill;
        showSkillUpgradeModal = true;
    }

    private bool isModuleDescExpanded = false;

    private async Task OpenModuleStatModal()
    {
        if (CurrentModule != null)
        {
            if (currentModuleMissions == null || currentModuleMissions.Count == 0)
            {
                try
                {
                    currentModuleMissions = await service.GetMissionsForModuleAsync(CurrentModule);
                }
                catch (Exception ex)
                {
                    Logger?.LogWarning(ex, "[OpenModuleStatModal] Failed to load missions for '{ModId}'", CurrentModule.UniEquipId);
                }
            }

            if (currentModuleBattleEquip == null && !string.IsNullOrEmpty(CurrentModule.UniEquipId))
            {
                try
                {
                    currentModuleBattleEquip = await service.GetBattleEquipAsync(CurrentModule.UniEquipId);
                    await LoadModuleRangesAsync();
                }
                catch (Exception ex)
                {
                    Logger?.LogWarning(ex, "[OpenModuleStatModal] Failed to load battle equip for '{ModId}'", CurrentModule.UniEquipId);
                }
            }
        }
        showModuleStatModal = true;
    }

    private int costFromLevel = 1;

    private void OnCostFromLevelChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            costFromLevel = Math.Clamp(val, 1, currentLevel);
        }
    }

    private LevelingCostResult GetLevelCostPreview()
    {
        int from = Math.Clamp(costFromLevel, 1, currentLevel);
        return LevelService.CalculateLevelUpCost(elite, from, currentLevel);
    }

    private int GetPromotionLmdCostPreview()
    {
        return LevelService.GetPromotionLmdCost(op?.Rarity, elite);
    }

    private List<ItemBundle> GetPromotionMaterialsPreview()
    {
        if (op?.Phases != null && elite > 0 && elite < op.Phases.Count)
        {
            return op.Phases[elite].EvolveCost ?? [];
        }
        return [];
    }
    private record struct SavedOperatorState(int Elite, int Level, int Trust, int ModuleIndex, int ModuleStage, bool SkillExpanded, bool ModuleExpanded);
    private static readonly Dictionary<string, SavedOperatorState> _savedOperatorState = new();

    private void SaveState()
    {
        if (!string.IsNullOrEmpty(Id))
        {
            _savedOperatorState[Id] = new SavedOperatorState(elite, currentLevel, selectedTrust, selectedModuleIndex, selectedModuleStage, isSkillExpanded, isModuleExpanded);
        }
    }

    private void SetLevel(int lvl)
    {
        if (op?.Phases != null && elite < op.Phases.Count)
        {
            currentLevel = Math.Clamp(lvl, 1, op.Phases[elite].MaxLevel);
            if (costFromLevel > currentLevel)
            {
                costFromLevel = currentLevel;
            }
            SaveState();
        }
    }

    private void OnLevelInputChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            SetLevel(val);
        }
    }

    private void ApplyLevelModal()
    {
        SaveState();
        showLevelModal = false;
    }

