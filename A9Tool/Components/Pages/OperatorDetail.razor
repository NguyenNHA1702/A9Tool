            "[OnEliteChanged] Operator '{Name}' -> E{Elite} | MaxLevel: {MaxLevel} | RangeId: '{RangeId}'",
            op?.Name, newElite, maxLv, phaseRangeId);
        try
        {
            await UpdateRangeAsync();
        }
        catch (Exception ex)
        {
            Logger?.LogWarning(ex, "Error updating range on elite change.");
        }
    }

