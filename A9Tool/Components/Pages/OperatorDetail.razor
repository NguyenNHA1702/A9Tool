    private int selectedModuleStage = 0;
    private List<UniEquipMissionData> currentModuleMissions = [];
    private Dictionary<string, RangeMatrix> moduleRangeCache = new();

    private async Task OnModuleSelected(int modIdx, int? targetStage = null)
    {
        selectedModuleIndex = modIdx;
        currentModuleBattleEquip = null;
        currentModuleMissions = [];
        selectedModuleStage = targetStage ?? 0;

        // modIdx == 0 = ORIGINAL (no BattleEquip), modIdx >= 1 = custom modules
        if (modIdx > 0 && modules != null && modIdx <= modules.Count)
        {
            var mod = modules[modIdx - 1];

            try
            {
                currentModuleMissions = await service.GetMissionsForModuleAsync(mod);
            }
            catch (Exception exMission)
            {
                Logger?.LogWarning(exMission, "[OnModuleSelected] Failed to load missions for '{ModId}'", mod.UniEquipId);
            }

            if (!string.IsNullOrEmpty(mod.UniEquipId))
            {
                try
                {
                    currentModuleBattleEquip = await service.GetBattleEquipAsync(mod.UniEquipId);
                    Logger?.LogInformation("[OnModuleSelected] Loaded BattleEquip for '{ModId}': {Phases} phase(s)",
                        mod.UniEquipId, currentModuleBattleEquip?.Phases?.Count ?? 0);

                    if (currentModuleBattleEquip?.Phases?.Count > 0)
                    {
                        if (targetStage.HasValue)
                        {
                            selectedModuleStage = Math.Clamp(targetStage.Value, 0, currentModuleBattleEquip.Phases.Count - 1);
                        }
                        else
                        {
                            selectedModuleStage = currentModuleBattleEquip.Phases.Count - 1;
                        }
                    }
                    await LoadModuleRangesAsync();
                }
                catch (Exception ex)
                {
                    Logger?.LogWarning(ex, "[OnModuleSelected] Failed to load BattleEquip for '{ModId}'", mod.UniEquipId);
                }
            }
        }
        SaveState();
    }

    private double GetModuleBonus(string statKey)
    {
        if (selectedModuleIndex <= 0 || currentModuleBattleEquip?.Phases == null || currentModuleBattleEquip.Phases.Count == 0)
            return 0;

        var stageIdx = Math.Clamp(selectedModuleStage, 0, currentModuleBattleEquip.Phases.Count - 1);
        var phase = currentModuleBattleEquip.Phases[stageIdx];
        var blackboard = phase.AttributeBlackboard;
        if (blackboard == null) return 0;

        var match = blackboard.FirstOrDefault(b => string.Equals(b.Key, statKey, StringComparison.OrdinalIgnoreCase));
        return match?.Value ?? 0;
    }

    private string GetModuleTypeIconUrl(UniEquipData? module)
    {
        if (module == null) return "";
        if (!string.IsNullOrEmpty(module.TypeIcon))
        {
            return $"https://raw.githubusercontent.com/ArknightsAssets/ArknightsAssets2/en/assets/dyn/arts/ui/uniequiptype/{module.TypeIcon.ToLower()}.png";
        }
        if (!string.IsNullOrEmpty(module.TypeName1))
        {
            return $"https://raw.githubusercontent.com/ArknightsAssets/ArknightsAssets2/en/assets/dyn/arts/ui/uniequiptype/uniequip_type_{module.TypeName1.ToLower()}.png";
        }
        return "";
    }

    private async Task LoadModuleRangesAsync()
    {
        moduleRangeCache.Clear();
        if (currentModuleBattleEquip?.Phases == null) return;

        foreach (var phase in currentModuleBattleEquip.Phases)
        {
            if (phase.Parts == null) continue;
            foreach (var part in phase.Parts)
            {
                var traitRangeId = part.OverrideTraitDataBundle?.Candidates?.FirstOrDefault()?.RangeId;
                if (!string.IsNullOrEmpty(traitRangeId) && !moduleRangeCache.ContainsKey(traitRangeId))
                {
                    var rData = await service.GetRangeDataAsync(traitRangeId);
                    if (rData != null) moduleRangeCache[traitRangeId] = RangeMatrix.Create(rData);
                }

                var talentRangeId = part.AddOrOverrideTalentDataBundle?.Candidates?.FirstOrDefault()?.RangeId;
                if (!string.IsNullOrEmpty(talentRangeId) && !moduleRangeCache.ContainsKey(talentRangeId))
                {
                    var rData = await service.GetRangeDataAsync(talentRangeId);
                    if (rData != null) moduleRangeCache[talentRangeId] = RangeMatrix.Create(rData);
                }
            }
        }
    }

