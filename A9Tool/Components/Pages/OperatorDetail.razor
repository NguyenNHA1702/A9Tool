        <!-- Module Modal (Arknights Wiki Style) -->
        @if (CurrentModule != null && showModuleStatModal)
        {
            <div class="od-modal-backdrop" @onclick="() => showModuleStatModal = false">
                <div class="od-mod-modal-card wiki-style" @onclick:stopPropagation="true">

                    <!-- Top Header Bar -->
                    <div class="od-mod-modal-header">
                        <div class="od-mod-modal-header-left">
                            @if (!string.IsNullOrEmpty(GetModuleTypeIconUrl(CurrentModule)))
                            {
                                <img class="od-mod-type-icon" src="@GetModuleTypeIconUrl(CurrentModule)" alt="Type Icon" onerror="this.onerror=null;this.src='/assets/icons/characterdetail/back_round.png'" />
                            }
                            <div class="od-mod-header-title-box">
                                <span class="od-mod-code-badge">@(!string.IsNullOrEmpty(CurrentModule.TypeName1) ? $"{CurrentModule.TypeName1}{(string.IsNullOrEmpty(CurrentModule.TypeName2) ? "" : "-" + CurrentModule.TypeName2)}" : "MODULE")</span>
                                <h2 class="od-mod-modal-title">@CurrentModule.UniEquipName</h2>
                            </div>
                        </div>
                        <button class="od-modal-close-btn" @onclick="() => showModuleStatModal = false">✕</button>
                    </div>

                    <!-- Modal Content Layout: Left Art/Info vs Right Vertical Stages (Image 2 Wiki Layout) -->
                    <div class="od-mod-modal-body wiki-body">
                        <div class="od-mod-wiki-grid">
                            
                            <!-- LEFT COLUMN: Module Art only -->
                            <div class="od-mod-wiki-left">
                                <div class="od-mod-art-container">
                                    <img class="od-mod-large-art" src="@GetModuleIconUrl(CurrentModule)" alt="@CurrentModule.UniEquipName" onerror="this.onerror=null;this.src='/assets/icons/characterdetail/back_round.png'" />
                                </div>
                                @if (!string.IsNullOrEmpty(CurrentModule.TypeName1))
                                {
                                    <span class="od-mod-type-chip">@CurrentModule.UniEquipName</span>
                                }
                            </div>

                            <!-- RIGHT COLUMN: Stacked Stages 1st, 2nd, 3rd Breakdown -->
                            <div class="od-mod-wiki-right">
                                @if (currentModuleBattleEquip?.Phases != null && currentModuleBattleEquip.Phases.Count > 0)
                                {
                                    @for (int stIdx = 0; stIdx < currentModuleBattleEquip.Phases.Count; stIdx++)
                                    {
                                        var stageNum = stIdx + 1;
                                        var phase = currentModuleBattleEquip.Phases[stIdx];
                                        var modStats = phase.AttributeBlackboard;
                                        var traitOverride = phase.Parts?.FirstOrDefault(p => p.OverrideTraitDataBundle?.Candidates?.Count > 0)
                                            ?.OverrideTraitDataBundle?.Candidates?.FirstOrDefault();
                                        var talentUpgrade = phase.Parts?.FirstOrDefault(p => p.AddOrOverrideTalentDataBundle?.Candidates?.Count > 0)
                                            ?.AddOrOverrideTalentDataBundle?.Candidates?.FirstOrDefault();

                                        // Check for stage range matrix
                                        var rangeId = traitOverride?.RangeId ?? talentUpgrade?.RangeId;
                                        RangeMatrix? stageRangeMatrix = null;
                                        if (!string.IsNullOrEmpty(rangeId))
                                        {
                                            moduleRangeCache.TryGetValue(rangeId, out stageRangeMatrix);
                                        }

                                        <div class="od-mod-stage-card">
                                            <div class="od-mod-stage-badge">
                                                <span class="od-stage-num">@stageNum</span>
                                                <span class="od-stage-sub">STAGE</span>
                                            </div>

                                            <div class="od-mod-stage-content">
                                                <!-- Trait Improvement -->
                                                @if (traitOverride != null && (!string.IsNullOrEmpty(traitOverride.OverrideDescripton) || !string.IsNullOrEmpty(traitOverride.AdditionalDescription)))
                                                {
                                                    <div class="od-mod-stage-block">
                                                        <span class="od-mod-block-label trait">Trait improved:</span>
                                                        @if (!string.IsNullOrEmpty(traitOverride.OverrideDescripton))
                                                        {
                                                            <p class="od-mod-block-text">@CleanDescription(traitOverride.OverrideDescripton)</p>
                                                        }
                                                        @if (!string.IsNullOrEmpty(traitOverride.AdditionalDescription))
                                                        {
                                                            <p class="od-mod-block-text sub">@CleanDescription(traitOverride.AdditionalDescription)</p>
                                                        }
                                                    </div>
                                                }

                                                <!-- Talent Improvement -->
                                                @if (talentUpgrade != null && (!string.IsNullOrEmpty(talentUpgrade.UpgradeDescription) || !string.IsNullOrEmpty(talentUpgrade.Description)))
                                                {
                                                    <div class="od-mod-stage-block">
                                                        <span class="od-mod-block-label talent">
                                                            @(!string.IsNullOrEmpty(talentUpgrade.Name) ? talentUpgrade.Name : "Talent") improved:
                                                        </span>
                                                        <p class="od-mod-block-text">
                                                            @CleanDescription(!string.IsNullOrEmpty(talentUpgrade.UpgradeDescription) ? talentUpgrade.UpgradeDescription : talentUpgrade.Description)
                                                        </p>
                                                    </div>
                                                }

                                                <!-- Attributes Increased -->
                                                @if (modStats != null && modStats.Any(b => b.Value.HasValue && b.Value.Value != 0))
                                                {
                                                    <div class="od-mod-stage-block">
                                                        <span class="od-mod-block-label attr">Attributes increased:</span>
                                                        <div class="od-mod-attr-list">
                                                            @foreach (var bb in modStats.Where(b => b.Value.HasValue && b.Value.Value != 0))
                                                            {
                                                                <span class="od-mod-attr-item">
                                                                    @FormatStatKey(bb.Key): <b class="val">@FormatStatValue(bb)</b>
                                                                </span>
                                                            }
                                                        </div>
                                                    </div>
                                                }

                                                <!-- Range Matrix preview if present -->
                                                @if (stageRangeMatrix != null)
                                                {
                                                    <div class="od-mod-stage-block">
                                                        <span class="od-mod-block-label range">Attack Range:</span>
                                                        <div class="od-range-grid-container mini"
                                                             style="grid-template-columns: repeat(@stageRangeMatrix.ColumnCount, 14px);
                                                            grid-template-rows: repeat(@stageRangeMatrix.RowCount, 14px);">
                                                            @for (int r = 0; r < stageRangeMatrix.RowCount; r++)
                                                            {
                                                                @for (int c = 0; c < stageRangeMatrix.ColumnCount; c++)
                                                                {
                                                                    var cellType = stageRangeMatrix.GetCellType(r, c);
                                                                    <div class="od-range-tile @cellType"></div>
                                                                }
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="od-mod-no-stat">Loading module stat data...</div>
                                }
                            </div>
                        </div>

                        <!-- DESCRIPTION FULL-WIDTH ROW (below 2-col grid) -->
                        @if (!string.IsNullOrEmpty(CurrentModule.UniEquipDesc))
                        {
                            <div class="od-mod-wiki-desc-row">
                                <div class="od-mod-wiki-desc-label">Description</div>
                                <div class="od-mod-wiki-desc-text">@CleanDescription(CurrentModule.UniEquipDesc)</div>
                            </div>
                        }

                        <!-- BOTTOM SECTION: Module Missions & Unlock Conditions Grid -->
                        <div class="od-mod-wiki-bottom">
                            <div class="od-mod-bottom-grid">
                                <!-- Missions Box -->
                                <div class="od-mod-bottom-box">
                                    <div class="od-mod-box-header">Module Missions</div>
                                    <div class="od-mod-box-content">
                                        @if (CurrentModule.MissionList != null && CurrentModule.MissionList.Count > 0)
                                        {
                                            <ol class="od-mod-missions-ol">
                                                @foreach (var mission in CurrentModule.MissionList)
                                                {
                                                    <li>@mission</li>
                                                }
                                            </ol>
                                        }
                                        else
                                        {
                                            <p class="od-mod-no-data">No specific mission required.</p>
                                        }
                                    </div>
                                </div>

                                <!-- Unlock Conditions Box -->
                                <div class="od-mod-bottom-box">
                                    <div class="od-mod-box-header">Unlock conditions</div>
                                    <div class="od-mod-box-content">
                                        <ul class="od-mod-unlock-ul">
                                            <li>Complete all Module Missions</li>
                                            <li>Raise <b>@op?.Name</b> to <b>@FormatPhase(CurrentModule.UnlockEvolvePhase.ToString()) Level @CurrentModule.UnlockLevel</b></li>
                                            <li>Reach at least 100% Trust with <b>@op?.Name</b></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <!-- Materials Table (Commented placeholder for future implementation) -->
                            <!--
                            <div class="od-mod-materials-box">
                                <div class="od-mod-box-header">Materials Required</div>
                                <div class="od-mod-mat-stages">
                                     Render material requirements list for STAGES 1, 2, 3 here...
                                </div>
                            </div>
                            -->
                        </div>

                    </div>

                </div>
            </div>
        }
    </div>
}

@code {
    [Inject] ILogger<OperatorDetail>? Logger { get; set; }

    [Parameter] public string Id { get; set; } = "";

    private CharacterDetail? op;

    private List<SkillsForOperatorResponse> skills = new();
    private List<UniEquipData> modules = new();
    private int selectedModuleIndex = 0;
    private BattleEquipPack? currentModuleBattleEquip;

    private enum DrawerState { Collapsed, SkillExpanded, ModuleExpanded }
    private DrawerState activeDrawer = DrawerState.Collapsed;

    private bool showLevelModal = false;
    private bool showModuleStatModal = false;
    private static readonly Dictionary<string, (int Elite, int Level, int Trust)> _savedOperatorState = new();

    private void SaveState()
    {
        if (!string.IsNullOrEmpty(Id))
        {
            _savedOperatorState[Id] = (elite, currentLevel, selectedTrust);
        }
    }

    private void SetLevel(int lvl)
    {
        if (op?.Phases != null && elite < op.Phases.Count)
        {
            currentLevel = Math.Clamp(lvl, 1, op.Phases[elite].MaxLevel);
            SaveState();
        }
    }

    private void OnLevelInputChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            SetLevel(val);
        }
    }

    private void ApplyLevelModal()
    {
        SaveState();
        showLevelModal = false;
    }

    private void ToggleSkillDrawer()
    {
        activeDrawer = activeDrawer == DrawerState.SkillExpanded ? DrawerState.Collapsed : DrawerState.SkillExpanded;
    }

    private void ToggleModuleDrawer()
    {
        activeDrawer = activeDrawer == DrawerState.ModuleExpanded ? DrawerState.Collapsed : DrawerState.ModuleExpanded;
    }

    private int selectedModuleStage = 0;
    private Dictionary<string, RangeMatrix> moduleRangeCache = new();

    private async Task OnModuleSelected(int modIdx)
    {
        selectedModuleIndex = modIdx;
        currentModuleBattleEquip = null;
        selectedModuleStage = 0;

        // modIdx == 0 = ORIGINAL (no BattleEquip), modIdx >= 1 = custom modules
        if (modIdx > 0 && modules != null && modIdx <= modules.Count)
        {
            var mod = modules[modIdx - 1];
            if (!string.IsNullOrEmpty(mod.UniEquipId))
            {
                try
                {
                    currentModuleBattleEquip = await service.GetBattleEquipAsync(mod.UniEquipId);
                    Logger?.LogInformation("[OnModuleSelected] Loaded BattleEquip for '{ModId}': {Phases} phase(s)",
                        mod.UniEquipId, currentModuleBattleEquip?.Phases?.Count ?? 0);

                    if (currentModuleBattleEquip?.Phases?.Count > 0)
                    {
                        selectedModuleStage = currentModuleBattleEquip.Phases.Count - 1;
                    }
                    await LoadModuleRangesAsync();
                }
                catch (Exception ex)
                {
                    Logger?.LogWarning(ex, "[OnModuleSelected] Failed to load BattleEquip for '{ModId}'", mod.UniEquipId);
                }
            }
        }
    }

    private double GetModuleBonus(string statKey)
    {
        if (selectedModuleIndex <= 0 || currentModuleBattleEquip?.Phases == null || currentModuleBattleEquip.Phases.Count == 0)
            return 0;

        var stageIdx = Math.Clamp(selectedModuleStage, 0, currentModuleBattleEquip.Phases.Count - 1);
        var phase = currentModuleBattleEquip.Phases[stageIdx];
        var blackboard = phase.AttributeBlackboard;
        if (blackboard == null) return 0;

        var match = blackboard.FirstOrDefault(b => string.Equals(b.Key, statKey, StringComparison.OrdinalIgnoreCase));
        return match?.Value ?? 0;
    }

    private string GetModuleTypeIconUrl(UniEquipData? module)
    {
        if (module == null) return "";
        if (!string.IsNullOrEmpty(module.TypeIcon))
        {
            return $"https://raw.githubusercontent.com/ArknightsAssets/ArknightsAssets2/en/assets/dyn/arts/ui/uniequiptype/{module.TypeIcon.ToLower()}.png";
        }
        if (!string.IsNullOrEmpty(module.TypeName1))
        {
            return $"https://raw.githubusercontent.com/ArknightsAssets/ArknightsAssets2/en/assets/dyn/arts/ui/uniequiptype/uniequip_type_{module.TypeName1.ToLower()}.png";
        }
        return "";
    }

    private async Task LoadModuleRangesAsync()
    {
        moduleRangeCache.Clear();
        if (currentModuleBattleEquip?.Phases == null) return;

        foreach (var phase in currentModuleBattleEquip.Phases)
        {
            if (phase.Parts == null) continue;
            foreach (var part in phase.Parts)
            {
                var traitRangeId = part.OverrideTraitDataBundle?.Candidates?.FirstOrDefault()?.RangeId;
                if (!string.IsNullOrEmpty(traitRangeId) && !moduleRangeCache.ContainsKey(traitRangeId))
                {
                    var rData = await service.GetRangeDataAsync(traitRangeId);
                    if (rData != null) moduleRangeCache[traitRangeId] = RangeMatrix.Create(rData);
                }

                var talentRangeId = part.AddOrOverrideTalentDataBundle?.Candidates?.FirstOrDefault()?.RangeId;
                if (!string.IsNullOrEmpty(talentRangeId) && !moduleRangeCache.ContainsKey(talentRangeId))
                {
                    var rData = await service.GetRangeDataAsync(talentRangeId);
                    if (rData != null) moduleRangeCache[talentRangeId] = RangeMatrix.Create(rData);
                }
            }
        }
    }

    private SkillLevelResponse? CurrentSkillLevel => GetCurrentSkillLevel();
    private SkillsForOperatorResponse? CurrentSkill => (skills != null && selectedSkill < skills.Count) ? skills[selectedSkill] : null;
    private UniEquipData? CurrentModule => (selectedModuleIndex > 0 && modules != null && selectedModuleIndex <= modules.Count) ? modules[selectedModuleIndex - 1] : null;

    private string FormatSubProfession(string? subProfId)
    {
        if (string.IsNullOrEmpty(subProfId)) return "Core Caster";
        var clean = subProfId.Replace("_", " ");
        return System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(clean);
    }

    private string FormatStatKey(string? key)
    {
        if (string.IsNullOrEmpty(key)) return "";
        return key.ToLower() switch
        {
            "max_hp" => "HP",
            "atk" => "ATK",
            "def" => "DEF",
            "magic_resistance" => "RES",
            "attack_speed" => "ASPD",
            "cost" => "DP COST",
            "block_cnt" => "BLOCK",
            "respawn_time" => "REDEPLOY",
            _ => key.Replace("_", " ").ToUpper()
        };
    }

    private string FormatStatValue(BlackboardDataPair bb)
    {
        if (!bb.Value.HasValue) return "+0";
        var val = bb.Value.Value;
        if (val > -1.0 && val < 1.0 && val != 0)
        {
            return $"{(val > 0 ? "+" : "")}{(val * 100):0.#}%";
        }
        return $"{(val > 0 ? "+" : "")}{val}";
    }

    private string GetModuleIconUrl(UniEquipData? module)
    {
        if (module == null || string.IsNullOrEmpty(module.UniEquipIcon))
        {
            return "https://raw.githubusercontent.com/ArknightsAssets/ArknightsAssets2/cn/assets/dyn/arts/equip/icon/ORIGINAL.png";
        }
        Logger.LogInformation("Load module image {imageId}", module.UniEquipIcon.ToLower());
        return $"https://raw.githubusercontent.com/ArknightsAssets/ArknightsAssets2/en/assets/dyn/arts/ui/uniequipimg/{module.UniEquipIcon.ToLower()}.png";
    }

    private RangeData? activeRangeData;       // Operator base attack range for current phase
    private RangeMatrix? activeRangeMatrix;
    private RangeData? activeSkillRangeData;  // Skill override attack range for current skill level
    private RangeMatrix? activeSkillRangeMatrix;

    protected override async Task OnParametersSetAsync()
    {
        var totalSw = System.Diagnostics.Stopwatch.StartNew();
        var stepSw = new System.Diagnostics.Stopwatch();
        int errCount = 0;
        int warnCount = 0;

        try
        {
            stepSw.Start();
            op = await service.GetByIdAsync(Id);
            stepSw.Stop();

            Logger?.LogInformation("{Header}", PipelineLogger.FormatHeader("PIPELINE START", op?.Name ?? Id ?? "Unknown", Id ?? ""));

            // --- Step 1: Core Profile (15%) ---
            string profileDetails = op != null
                ? $"{op.Profession} | {op.Rarity?.Replace("TIER_", "")}★ | Phases: {op.Phases?.Count ?? 0} | Talents: {op.Talents?.Count ?? 0}"
                : "Not Found";
            Logger?.LogInformation("{Step}", PipelineLogger.FormatStep(15, PipelineLogger.TagRamHit(), "Profile Core", profileDetails, stepSw.ElapsedMilliseconds));

            selectedSkill = 0;
            selectedModuleIndex = 0;
            activeDrawer = DrawerState.Collapsed;

            // Load saved Level/Elite state if previously set
            if (!string.IsNullOrEmpty(Id) && _savedOperatorState.TryGetValue(Id, out var savedState))
            {
                elite = savedState.Elite;
                displayElite = savedState.Elite;
                selectedTrust = savedState.Trust;
                currentLevel = savedState.Level;
            }
            else
            {
                elite = 0;
                displayElite = 0;
                currentBgUrl = GetImageUrl(Id, displayElite);
                if (op?.Phases != null && op.Phases.Count > 0)
                {
                    currentLevel = op.Phases[elite].MaxLevel;
                }
            }

            if (op != null)
            {
                // --- Step 2: Fetch Skills (40%) ---
                stepSw.Restart();
                try
                {
                    skills = await service.GetSkillsForOperatorAsync(op);
                    stepSw.Stop();
                    Logger?.LogInformation("{Step}", PipelineLogger.FormatStep(40, PipelineLogger.TagDiskHit("skill_table.json"), "Skills Loaded", $"{skills?.Count ?? 0} skills resolved & parsed", stepSw.ElapsedMilliseconds));

                    if (skills != null)
                    {
                        for (int i = 0; i < skills.Count; i++)
                        {
                            var s = skills[i];
                            var lv1 = s.Levels?.FirstOrDefault();
                            Logger?.LogInformation("{SubItem}", PipelineLogger.FormatSubItem($"Skill {i + 1}", $"{lv1?.Name ?? s.SkillId} (Lv {s.Levels?.Count ?? 1}) | SP: {lv1?.SpCost} | {s.SkillType}", i == skills.Count - 1));
                        }
                    }
                }
                catch (Exception exSkill)
                {
                    errCount++;
                    Logger?.LogError(exSkill, "Error fetching skills for operator: {OperatorName}", op.Name);
                }

                // --- Step 3: Fetch Modules (65%) ---
                stepSw.Restart();
                try
                {
                    modules = await service.GetModulesByOperatorAsync(op.Id);
                    stepSw.Stop();
                    Logger?.LogInformation("{Step}", PipelineLogger.FormatStep(65, PipelineLogger.TagDiskHit("uniequip_table.json"), "Modules (UniEquip)", $"{modules?.Count ?? 0} modules mapped", stepSw.ElapsedMilliseconds));

                    if (modules != null && modules.Count > 0)
                    {
                        for (int i = 0; i < modules.Count; i++)
                        {
                            var m = modules[i];
                            Logger?.LogInformation("{SubItem}", PipelineLogger.FormatSubItem($"Mod {i + 1}", $"{m.UniEquipName} ({m.TypeName1})", i == modules.Count - 1));
                        }
                    }
                }
                catch (Exception exMod)
                {
                    errCount++;
                    Logger?.LogError(exMod, "Error fetching modules for operator: {OperatorName}", op.Name);
                }
            }

            // --- Step 4: Attack Ranges (80%) ---
            stepSw.Restart();
            try
            {
                await UpdateRangeAsync();
                stepSw.Stop();
                string rangeInfo = activeRangeData != null ? $"Base [{activeRangeData.Grids?.Count ?? 0} tiles] mapped" : "Default";
                if (activeSkillRangeData != null) rangeInfo += $" | Skill [{activeSkillRangeData.Grids?.Count ?? 0} tiles]";
                Logger?.LogInformation("{Step}", PipelineLogger.FormatStep(80, PipelineLogger.TagStatic("range_table.json"), "Attack Ranges", rangeInfo, stepSw.ElapsedMilliseconds));
            }
            catch (Exception exRange)
            {
                warnCount++;
                Logger?.LogWarning(exRange, "Error updating range data for operator: {OperatorName}", op?.Name);
            }

            // --- Step 5: Battle Stats (90%) ---
            stepSw.Restart();
            var stats = GetStatsAtTrust(GetRawStat(), selectedTrust);
            stepSw.Stop();
            Logger?.LogInformation("{Step}", PipelineLogger.FormatStep(90, PipelineLogger.TagComputed(), "Battle Stats", $"E{elite} LV{currentLevel} Trust{selectedTrust}% -> HP: {stats.MaxHp} | ATK: {stats.Atk} | DEF: {stats.Def}", stepSw.ElapsedMilliseconds));

            // --- Step 6: Visual Assets (100%) ---
            stepSw.Restart();
            currentBgUrl = GetImageUrl(Id, displayElite);
            stepSw.Stop();
            Logger?.LogInformation("{Step}", PipelineLogger.FormatStep(100, PipelineLogger.TagDiskHit("Art Cache"), "Visual Assets", $"Background E{displayElite} resolved | Render ready", stepSw.ElapsedMilliseconds));

            // --- Pipeline Complete ---
            totalSw.Stop();
            Logger?.LogInformation("{Footer}", PipelineLogger.FormatFooter(op?.Name ?? Id ?? "", totalSw.ElapsedMilliseconds, errCount, warnCount));
        }
        catch (Exception ex)
        {
            errCount++;
            totalSw.Stop();
            Logger?.LogError(ex, "Error fetching operator details for Id: {Id}", Id);
            Logger?.LogInformation("{Footer}", PipelineLogger.FormatFooter(Id ?? "Unknown", totalSw.ElapsedMilliseconds, errCount, warnCount));
        }
    }

    private int elite = 0;
    private int displayElite = 0;
    private string currentBgUrl = "";
    private bool showLightbox = false;
    private int currentLevel;
    private int selectedTrust = 200;

    private void OnTrustChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value))
        {
            selectedTrust = value;
            SaveState();
        }
    }

    private string GetImageUrl(string id, int eliteLevel) => eliteLevel switch
    {
        0 => $"https://raw.githubusercontent.com/ArknightsAssets/ArknightsAssets2/cn/assets/dyn/arts/characters/{id}/{id}_1.png",
        1 => $"https://raw.githubusercontent.com/ArknightsAssets/ArknightsAssets2/cn/assets/dyn/arts/characters/{id}/{id}_1%2B.png",
        2 => $"https://raw.githubusercontent.com/ArknightsAssets/ArknightsAssets2/cn/assets/dyn/arts/characters/{id}/{id}_2.png",
        _ => "/assets/icons/characterdetail/back_round.png"
    };

    private void OnImageError()
    {
        if (displayElite > 0)
        {
            displayElite--;
        }
        else
        {
            currentBgUrl = "/assets/icons/characterdetail/back_round.png";
        }
    }

    private async Task OnEliteChanged(int newElite)
    {
        elite = newElite;
        displayElite = newElite;
        SaveState();
        var maxLv = op?.Phases != null && op.Phases.Count > newElite ? op.Phases[newElite].MaxLevel : 0;
        var phaseRangeId = op?.Phases != null && op.Phases.Count > newElite ? op.Phases[newElite].RangeId : "N/A";
        Logger?.LogInformation(
            "[OnEliteChanged] Operator '{Name}' -> E{Elite} | MaxLevel: {MaxLevel} | RangeId: '{RangeId}'",
            op?.Name, newElite, maxLv, phaseRangeId);
        try
        {
            await UpdateRangeAsync();
        }
        catch (Exception ex)
        {
            Logger?.LogWarning(ex, "Error updating range on elite change.");
        }
    }

    private int selectedSkill = 0;
    private int selectedSkillLevel = 0;
    private int selectedPotential = 0;

    private async Task SelectSkill(int index)
    {
        selectedSkill = index;
        selectedSkillLevel = 0;
        if (skills != null && index < skills.Count)
        {
            var s = skills[index];
            Logger?.LogInformation(
                "[SelectSkill] Operator '{Name}': selected Skill #{Index} Id='{SkillId}' | Levels: {LevelCount}",
                op?.Name, index, s.SkillId, s.Levels?.Count ?? 0);
        }
        try
        {
            await UpdateRangeAsync();
        }
        catch (Exception ex)
        {
            Logger?.LogWarning(ex, "Error updating range on skill select.");
        }
    }

    private async Task OnSkillLevelChanged(int lvlIdx)
    {
        selectedSkillLevel = lvlIdx;
        var skillLvl = GetCurrentSkillLevel();
        Logger?.LogInformation(
            "[OnSkillLevelChanged] Operator '{Name}': Skill #{SkillIdx} -> Level Index {LvlIdx} | Name='{LvlName}' SpCost={SpCost} Duration={Duration}",
            op?.Name, selectedSkill, lvlIdx, skillLvl?.Name, skillLvl?.SpCost ?? 0, skillLvl?.Duration ?? 0);
        try
        {
            await UpdateRangeAsync();
        }
        catch (Exception ex)
        {
            Logger?.LogWarning(ex, "Error updating range on skill level change.");
        }
    }

    private async Task UpdateRangeAsync()
    {
        if (op == null) return;

        // 1. Operator range: resolve from current phase with fallback
        try
        {
            var phaseRangeId = op.Phases[Math.Min(elite, op.Phases.Count - 1)].RangeId;
            if (!string.IsNullOrEmpty(phaseRangeId))
            {
                activeRangeData = await service.GetRangeDataAsync(phaseRangeId);
                activeRangeMatrix = activeRangeData != null ? RangeMatrix.Create(activeRangeData) : null;
            }
        }
        catch (Exception ex)
        {
            Logger?.LogWarning(ex, "Failed to load phase range for operator {Id}", op.Id);
            activeRangeData = null;
            activeRangeMatrix = null;
        }

        // 2. Skill range: resolve override if defined by skill level
        try
        {
            var skillLvl = GetCurrentSkillLevel();
            if (!string.IsNullOrEmpty(skillLvl?.RangeId))
            {
                activeSkillRangeData = await service.GetRangeDataAsync(skillLvl.RangeId);
                activeSkillRangeMatrix = activeSkillRangeData != null ? RangeMatrix.Create(activeSkillRangeData) : null;
            }
            else
            {
                activeSkillRangeData = null;
                activeSkillRangeMatrix = null;
            }
        }
        catch (Exception ex)
        {
            Logger?.LogWarning(ex, "Failed to load skill range for operator {Id}", op.Id);
            activeSkillRangeData = null;
            activeSkillRangeMatrix = null;
        }
    }

    private SkillLevelResponse? GetCurrentSkillLevel()
    {
        if (skills == null || skills.Count == 0 || selectedSkill >= skills.Count) return null;
        var s = skills[selectedSkill];
        if (s.Levels == null || s.Levels.Count == 0) return null;
        var idx = Math.Clamp(selectedSkillLevel, 0, s.Levels.Count - 1);
        return s.Levels[idx];
    }

    private TalentCandidate? GetActiveTalentCandidate(Talent talent)
    {
        if (talent.Candidates == null || talent.Candidates.Count == 0) return null;
        return talent.Candidates
            .Where(c => (c.UnlockCondition?.Phase == null || PhaseToInt(c.UnlockCondition.Phase) <= elite)
                     && c.RequiredPotentialRank <= selectedPotential)
            .LastOrDefault() ?? talent.Candidates.FirstOrDefault();
    }

    private int PhaseToInt(string? phase) => phase switch
    {
        "PHASE_0" => 0,
        "PHASE_1" => 1,
        "PHASE_2" => 2,
        _ => 0
    };

    private string GetSkillImageUrl(string? id) => !string.IsNullOrEmpty(id) ? $"https://raw.githubusercontent.com/ArknightsAssets/ArknightsAssets2/cn/assets/dyn/arts/skills/skill_icon_{id}.png" : "/assets/icons/characterdetail/sprite_profession.png";

    private Stats? GetPhaseMaxStats()
    {
        if (op?.Phases == null || op.Phases.Count == 0) return null;
        var phase = op.Phases[Math.Min(elite, op.Phases.Count - 1)];
        var stats = phase.AttributesKeyFrames?.LastOrDefault()?.Data;
        Logger.LogInformation("Max lv {lv}", phase.AttributesKeyFrames.LastOrDefault().Level);
        return stats;
    }

    private Stats GetPhaseMinStats()
    {
        if (op?.Phases == null || op.Phases.Count == 0) return null;
        var phase = op.Phases[Math.Min(elite, op.Phases.Count - 1)];
        var stats = phase.AttributesKeyFrames?.FirstOrDefault()?.Data;
        Logger.LogInformation("Min lv {lv}", phase.AttributesKeyFrames.FirstOrDefault().Level);
        return stats;
    }

    private Stats GetRawStat()
    {
        var max = GetPhaseMaxStats();
        var min = GetPhaseMinStats();
        var phase = op.Phases[Math.Min(elite, op.Phases.Count - 1)];

        var t = (double)(currentLevel - 1) / (phase.MaxLevel - 1);

        var stats = new Stats
        {
            MaxHp = (int)Lerp(min.MaxHp, max.MaxHp, t),
            Atk = (int)Lerp(min.Atk, max.Atk, t),
            Def = (int)Lerp(min.Def, max.Def, t),
            MagicResistance = (int)Lerp(min.MagicResistance, max.MagicResistance, t),
            Cost = max.Cost,
            BlockCnt = max.BlockCnt,
            RespawnTime = max.RespawnTime
        };

        return stats;
    }

    private static double Lerp(double a, double b, double t)
    {
        return a + (b - a) * t;
    }

    private Stats GetTrustBonus(int trust)
    {
        if (op?.TrustBonus == null || op.TrustBonus.Count < 2)
            return new Stats();

        // Trust bonus max 100%
        trust = Math.Clamp(trust, 0, 100);

        var min = op.TrustBonus.First();
        var max = op.TrustBonus.Last();

        // 0% -> favor level 0
        // 100% -> favor level 50
        var favorLevel = trust * max.Level / 100.0;

        var t = (favorLevel - min.Level) /
                (max.Level - min.Level);

        return new Stats
        {
            MaxHp = (int)Lerp(
                min.Data?.MaxHp ?? 0,
                max.Data?.MaxHp ?? 0,
                t),

            Atk = (int)Lerp(
                min.Data?.Atk ?? 0,
                max.Data?.Atk ?? 0,
                t),

            Def = (int)Lerp(
                min.Data?.Def ?? 0,
                max.Data?.Def ?? 0,
                t),

            MagicResistance = (int)Lerp(
                min.Data?.MagicResistance ?? 0,
                max.Data?.MagicResistance ?? 0,
                t)
        };
    }

    private Stats GetStatsAtTrust(Stats raw, int trust)
    {
        var bonus = GetTrustBonus(trust);

        return new Stats
        {
            MaxHp = raw.MaxHp + bonus.MaxHp,
            Atk = raw.Atk + bonus.Atk,
            Def = raw.Def + bonus.Def,
            MagicResistance =
                raw.MagicResistance + bonus.MagicResistance,

            Cost = raw.Cost,
            BlockCnt = raw.BlockCnt,
            RespawnTime = raw.RespawnTime
        };
    }

    private string FormatRarity(string? r)
        => string.IsNullOrEmpty(r) ? "" : r.Replace("TIER_", "") + "★";

    private string FormatProfession(string? p) => p switch
    {
        "PIONEER" => "Vanguard",
        "WARRIOR" => "Guard",
        "TANK" => "Defender",
        "SNIPER" => "Sniper",
        "CASTER" => "Caster",
        "MEDIC" => "Medic",
        "SUPPORT" => "Supporter",
        "SPECIAL" => "Specialist",
        _ => p ?? ""
    };

    private string FormatPhase(string? phase) => phase switch
    {
        "PHASE_0" => "E0",
        "PHASE_1" => "E1",
        "PHASE_2" => "E2",
        _ => phase ?? ""
    };

    private string CleanDescription(string? desc)
        => string.IsNullOrEmpty(desc) ? "" : System.Text.RegularExpressions.Regex.Replace(desc, @"<[^>]+>", "");

