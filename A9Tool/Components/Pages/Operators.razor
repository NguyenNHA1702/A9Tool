@page "/operators"
@inject Core.Services.CharacterService service
@inject NavigationManager Nav

<div class="max-w-[1400px] mx-auto p-6">

    @if (list is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <div class="flex items-baseline gap-3 mb-6">
            <h1 class="text-3xl font-bold">Arknights Operators</h1>
            <span class="text-muted cursor-pointer" @onclick="ResetCache">@FilteredCharacters.Count() operators</span>
        </div>

        <div class="filter-container">
            <input type="text"
                   class="search-input"
                   placeholder="Tìm operator..."
                   @bind="searchTerm"
                   @bind:event="oninput" />

            <select class="filter-select" @bind="selectRarity">
                <option value="">Tất cả Rarity</option>
                <option value="TIER_6">6★</option>
                <option value="TIER_5">5★</option>
                <option value="TIER_4">4★</option>
                <option value="TIER_3">3★</option>
                <option value="TIER_2">2★</option>
                <option value="TIER_1">1★</option>
            </select>

            <select class="filter-select" @bind="selectProfession">
                <option value="">Tất cả Class</option>
                <option value="PIONEER">Vanguard</option>
                <option value="WARRIOR">Guard</option>
                <option value="TANK">Defender</option>
                <option value="SNIPER">Sniper</option>
                <option value="CASTER">Caster</option>
                <option value="MEDIC">Medic</option>
                <option value="SUPPORT">Supporter</option>
                <option value="SPECIAL">Specialist</option>
            </select>
        </div>

        <div class="operator-grid">
            @foreach (var op in FilteredCharacters)
            {
                var id = op.Id?.ToLower() ?? "";
                <div class="op-card" data-rarity="@op.Rarity" @key="op.Id" @onclick="() => NavigateToDetail(op.Id)">
                    <!-- Main Character Portrait -->
                    <img class="op-card-img"
                         @key="@($"img-{op.Id}")"
                         src="https://raw.githubusercontent.com/ArknightsAssets/ArknightsAssets2/cn/assets/dyn/arts/charportraits/@(id)_1.png"
                         onerror="@($"this.src='https://raw.githubusercontent.com/Aceship/Arknight-Images/main/characters/@(id).png';this.onerror=function(){{this.src='https://raw.githubusercontent.com/Aceship/Arknight-Images/main/avatars/{id}.png';}};")"
                         alt="@op.Name"
                         loading="lazy" />

                    <!-- Top Overlay Badge: Class Icon & Rarity Stars -->
                    <div class="op-card-top-badge rarity-badge-@(op.Rarity)">
                        <img class="op-class-icon" src="@GetClassIconUrl(op.Profession)" alt="@op.Profession" />
                        <span class="op-stars-text">@FormatRarity(op.Rarity)</span>
                    </div>

                    <!-- Bottom Overlay Banner: Operator Name & Class -->
                    <div class="op-card-bottom-banner">
                        <div class="op-card-name">@op.Name</div>
                        <div class="op-card-class-sub">@FormatProfession(op.Profession)</div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Character>? list;
    private string searchTerm = "";
    private string selectRarity = "";
    private string selectProfession = "";

    protected override async Task OnInitializedAsync()
        => list = await service.GetAllAsync();

    private IEnumerable<Character> FilteredCharacters => list?
        .Where(c => string.IsNullOrEmpty(searchTerm) || (c.Name != null && c.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)))
        .Where(c => string.IsNullOrEmpty(selectRarity) || c.Rarity == selectRarity)
        .Where(c => string.IsNullOrEmpty(selectProfession) || c.Profession == selectProfession)
        ?? Enumerable.Empty<Character>();

    private void NavigateToDetail(string? id)
    {
        if (id is not null)
            Nav.NavigateTo($"/operators/{id}");
    }

    private string FormatRarity(string? r)
        => string.IsNullOrEmpty(r) ? "" : r.Replace("TIER_", "") + "★";

    private string FormatProfession(string? p) => p switch
    {
        "PIONEER" => "Vanguard",
        "WARRIOR" => "Guard",
        "TANK" => "Defender",
        "SNIPER" => "Sniper",
        "CASTER" => "Caster",
        "MEDIC" => "Medic",
        "SUPPORT" => "Supporter",
        "SPECIAL" => "Specialist",
        _ => p ?? ""
    };

    private string GetClassIconUrl(string? p) => p switch
    {
        "PIONEER" => "https://raw.githubusercontent.com/Aceship/Arknight-Images/main/classes/class_vanguard.png",
        "WARRIOR" => "https://raw.githubusercontent.com/Aceship/Arknight-Images/main/classes/class_guard.png",
        "TANK" => "https://raw.githubusercontent.com/Aceship/Arknight-Images/main/classes/class_defender.png",
        "SNIPER" => "https://raw.githubusercontent.com/Aceship/Arknight-Images/main/classes/class_sniper.png",
        "CASTER" => "https://raw.githubusercontent.com/Aceship/Arknight-Images/main/classes/class_caster.png",
        "MEDIC" => "https://raw.githubusercontent.com/Aceship/Arknight-Images/main/classes/class_medic.png",
        "SUPPORT" => "https://raw.githubusercontent.com/Aceship/Arknight-Images/main/classes/class_supporter.png",
        "SPECIAL" => "https://raw.githubusercontent.com/Aceship/Arknight-Images/main/classes/class_specialist.png",
        _ => "https://raw.githubusercontent.com/ArknightsAssets/ArknightsAssets2/en/assets/dyn/ui/storyreview/state/activity_review_detail_state/error-icon.png"
    };

    private async Task ResetCache()
       => await service.ResetCache();
    
}